<form class="contact-form" id="contact-form" netlify>
  <input type="hidden" name="form-name" value="contacto" />
  <div class="form-group">
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre" />
  </div>
  <div class="form-group">
    <label for="email">Correo electrónico</label>
    <input type="email" id="email" name="email" required placeholder="tu@correo.com" />
  </div>
  <div class="form-group">
    <label for="asunto">Asunto</label>
    <input type="text" id="asunto" name="asunto" required placeholder="Asunto" />
  </div>
  <div class="form-group">
    <label for="mensaje">Mensaje</label>
    <textarea id="mensaje" name="mensaje" rows={5} required placeholder="Escribe tu mensaje"></textarea>
  </div>
  <button type="submit" class="btn btn-primary">Enviar mensaje</button>
</form>

<script>
  import { fadeInUp } from "../utils/gsap";
  const form = document.getElementById("contact-form");
  if (form) fadeInUp(form, 0.2);
</script>

<style>
  .contact-form {
    max-width: 600px;
    margin: 0 auto;
    background: var(--color-bg);
    padding: var(--gap-lg);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid var(--color-border);
  }
  .form-group { margin-bottom: var(--gap-md); }
  label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--gap-sm);
    font-size: 0.9rem;
  }
  input, textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: 1rem;
    transition: var(--transition);
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(44, 122, 123, 0.1);
  }
</style>
