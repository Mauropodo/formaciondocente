<aside class="text-size-control" data-text-size-control aria-label="Tamaño de texto">
  <div class="text-size-control__buttons" role="group" aria-label="Ajustar tamaño de texto">
    <button
      class="text-size-control__button text-size-control__button--increase"
      type="button"
      data-text-size-increase
      aria-label="Aumentar tamaño de texto"
      title="Aumentar tamaño de texto"
    >A+</button>
    <button
      class="text-size-control__button"
      type="button"
      data-text-size-decrease
      aria-label="Reducir tamaño de texto"
      title="Reducir tamaño de texto"
    >A−</button>
  </div>
  <span class="text-size-control__status" data-text-size-status aria-live="polite" aria-atomic="true"></span>
</aside>

<style>
  .text-size-control {
    position: fixed;
    z-index: 1000;
    left: max(1rem, env(safe-area-inset-left));
    bottom: max(1rem, env(safe-area-inset-bottom));
    padding: 0.25rem;
    border: 1px solid rgba(98, 4, 4, 0.16);
    border-radius: 999px;
    background: rgba(255, 250, 247, 0.96);
    box-shadow: 0 8px 20px rgba(76, 54, 43, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .text-size-control__buttons {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .text-size-control__button {
    width: 44px;
    min-width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #620404;
    font-family: 'Inconsolata', monospace;
    font-size: 15px;
    font-weight: 900;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .text-size-control__button:hover:not(:disabled) {
    background: #620404;
    color: #fffaf7;
  }

  .text-size-control__button:active:not(:disabled) {
    transform: scale(0.94);
  }

  .text-size-control__button:focus-visible {
    outline: 3px solid #d2892d;
    outline-offset: 2px;
  }

  .text-size-control__button:disabled {
    color: rgba(98, 4, 4, 0.35);
    cursor: not-allowed;
  }

  .text-size-control__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .text-size-control__button { transition: none; }
  }
</style>

<script>
  const storageKey = 'parvularias-text-scale';
  const levels = [1, 1.1, 1.2, 1.3];
  const control = document.querySelector('[data-text-size-control]');

  if (control instanceof HTMLElement) {
    const decreaseButton = control.querySelector('[data-text-size-decrease]');
    const increaseButton = control.querySelector('[data-text-size-increase]');
    const status = control.querySelector('[data-text-size-status]');
    let levelIndex = 0;
    let textElements = new Map();
    let resizeTimer;

    try {
      const storedScale = Number(window.localStorage.getItem(storageKey));
      const storedIndex = levels.indexOf(storedScale);
      if (storedIndex >= 0) levelIndex = storedIndex;
    } catch {
      // El control sigue funcionando aunque el navegador bloquee el almacenamiento local.
    }

    const isTextElement = (element) => {
      if (!(element instanceof HTMLElement) || element.closest('[data-text-size-control]')) return false;
      if (['SCRIPT', 'STYLE', 'NOSCRIPT', 'SVG', 'PATH'].includes(element.tagName)) return false;
      if (['INPUT', 'TEXTAREA', 'SELECT', 'BUTTON'].includes(element.tagName)) return true;

      return Array.from(element.childNodes).some(
        (node) => node.nodeType === Node.TEXT_NODE && node.textContent?.trim(),
      );
    };

    const restoreOriginalSizes = () => {
      textElements.forEach(({ inlineSize, inlinePriority }, element) => {
        if (inlineSize) {
          element.style.setProperty('font-size', inlineSize, inlinePriority);
        } else {
          element.style.removeProperty('font-size');
        }
      });
    };

    const captureTextElements = () => {
      restoreOriginalSizes();
      textElements = new Map();

      document.querySelectorAll('body *').forEach((element) => {
        if (!isTextElement(element)) return;

        const computedSize = Number.parseFloat(window.getComputedStyle(element).fontSize);
        if (!Number.isFinite(computedSize)) return;

        textElements.set(element, {
          inlineSize: element.style.getPropertyValue('font-size'),
          inlinePriority: element.style.getPropertyPriority('font-size'),
          computedSize,
        });
      });
    };

    const updateButtons = () => {
      const atMinimum = levelIndex === 0;
      const atMaximum = levelIndex === levels.length - 1;

      if (decreaseButton instanceof HTMLButtonElement) {
        decreaseButton.disabled = atMinimum;
        decreaseButton.setAttribute('aria-disabled', String(atMinimum));
      }
      if (increaseButton instanceof HTMLButtonElement) {
        increaseButton.disabled = atMaximum;
        increaseButton.setAttribute('aria-disabled', String(atMaximum));
      }
    };

    const applyTextScale = (announce = false) => {
      const scale = levels[levelIndex];
      restoreOriginalSizes();

      if (scale !== 1) {
        textElements.forEach(({ computedSize }, element) => {
          element.style.setProperty('font-size', `${computedSize * scale}px`, 'important');
        });
      }

      document.documentElement.dataset.textScale = String(Math.round(scale * 100));
      updateButtons();

      if (announce && status instanceof HTMLElement) {
        status.textContent = `Tamaño de texto: ${Math.round(scale * 100)} por ciento`;
      }
    };

    const setLevel = (nextIndex) => {
      levelIndex = Math.min(Math.max(nextIndex, 0), levels.length - 1);
      applyTextScale(true);

      try {
        window.localStorage.setItem(storageKey, String(levels[levelIndex]));
      } catch {
        // La preferencia no se guarda si el almacenamiento local no está disponible.
      }
    };

    const refreshMeasurements = () => {
      captureTextElements();
      applyTextScale();
    };

    captureTextElements();
    applyTextScale();

    decreaseButton?.addEventListener('click', () => setLevel(levelIndex - 1));
    increaseButton?.addEventListener('click', () => setLevel(levelIndex + 1));

    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(refreshMeasurements, 150);
    });

    if (levelIndex > 0) {
      const observer = new MutationObserver(() => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(refreshMeasurements, 50);
      });
      observer.observe(document.body, { childList: true, subtree: true });
    }
  }
</script>
