---
import brandImage from "../assets/figma-mcp/inicio/logo.png";

const menuItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Quiénes Somos', href: '/quienes-somos' },
  { label: 'La Investigación', href: '/la-investigacion' },
  { label: 'Publicaciones', href: '/publicaciones' },
  { label: 'Contacto', href: '/contacto' },
];

---

<nav class="navbar" id="navbar" aria-label="Principal">
  <div class="nav-container">
    <a href="/" class="nav-brand" aria-label="Ir al inicio">
      <img src={brandImage.src} alt="Parvularias" class="nav-brand-image" />
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-label="Menú">
      <span></span><span></span><span></span>
    </button>

    <div class="nav-panel" id="nav-panel">
      <ul class="nav-links" id="nav-links">
        {menuItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>

      <a href="/publicaciones" class="nav-cta">Relatos</a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-panel");
  const links = document.getElementById("nav-links");

  toggle?.addEventListener("click", () => {
    panel?.classList.toggle("open");
    navbar?.classList.toggle("open");
  });

  links?.querySelectorAll("a").forEach(a => {
    a.addEventListener("click", () => {
      panel?.classList.remove("open");
      navbar?.classList.remove("open");
    });
  });
</script>

<style>
  .navbar {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: transparent;
    padding: 0;
  }
  .nav-container {
    width: 100%;
    max-width: 1920px;
    min-height: 161px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 5vw, 23rem);
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    z-index: 1000;
  }
  .nav-brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: flex-start;
    justify-content: center;
    margin-top: 0;
  }
  .nav-brand-image {
    width: 161px;
    height: 161px;
    object-fit: contain;
    display: block;
  }
  .nav-panel {
    align-items: center;
    background: transparent;
    border-radius: 0 0 12.8px 12.8px;
    box-shadow: none;
    display: flex;
    gap: 32px;
    justify-content: space-between;
    padding: 12.8px 50.4px;
    margin-top: 0;
    transform: translateX(-2px);
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
    align-items: center;
  }
  .nav-links a {
    color: #000;
    font-family: 'Inconsolata', monospace;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    transition: opacity var(--transition);
  }
  .nav-links a:hover { opacity: 0.7; }
  .nav-cta {
    align-items: center;
    background: #d2892d;
    border-radius: 48px;
    box-shadow:
      0.8px 2.4px 0 0 #464646,
      0 6.4px 9.6px 0 rgba(0, 0, 0, 0.15),
      0 3.2px 3.2px 0 rgba(0, 0, 0, 0.3);
    color: #eee2d9;
    display: inline-flex;
    font-family: 'Inconsolata', monospace;
    font-size: 16px;
    font-weight: 900;
    line-height: 1;
    padding: 12px 27.2px;
    white-space: nowrap;
  }
  .nav-cta:hover {
    color: #eee2d9;
    filter: brightness(0.98);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #000;
    border-radius: 2px;
    transition: var(--transition);
  }
  @media (max-width: 768px) {
    .nav-container {
      min-height: 88px;
      padding: 0 16px;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .nav-brand-image {
      width: 88px;
      height: 88px;
    }
    .nav-panel {
      display: none;
      width: 100%;
      order: 3;
      background: rgba(249, 245, 242, 0.94);
      backdrop-filter: blur(10px);
      border-radius: 0 0 12.8px 12.8px;
      padding: 16px;
      gap: 16px;
      flex-direction: column;
      align-items: stretch;
      transform: none;
      box-shadow: none;
    }
    .nav-panel.open {
      display: flex;
    }
    .nav-links {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
    .nav-toggle { display: flex; margin-left: auto; }
    .nav-cta {
      align-self: flex-start;
    }
  }
</style>
