---
import brandImage from "../assets/figma-mcp/inicio/logo.png";

const menuItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Quiénes Somos', href: '/quienes-somos' },
  { label: 'La Investigación', href: '/la-investigacion' },
  { label: 'Publicaciones', href: '/publicaciones' },
  { label: 'Contacto', href: '/contacto2' },
];
---

<header class="menu" id="navbar">
  <a class="brand" href="/" aria-label="Ir al inicio">
    <img src={brandImage.src} alt="Parvularias" />
  </a>
  <nav class="panel" aria-label="Principal">
    <ul class="links">
      {menuItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <div class="dev-readout" data-dev-readout aria-live="polite">
      <span>scroll <strong data-dev-scroll>0px</strong></span>
      <span>hero <strong data-dev-hero>0%</strong></span>
    </div>
    <a class="cta" href="/publicaciones">Relatos</a>
  </nav>
  <button class="nav-toggle" id="nav-toggle" aria-label="Menú">
    <span></span><span></span><span></span>
  </button>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("nav-toggle");
  const panel = document.querySelector(".panel");

  toggle?.addEventListener("click", () => {
    panel?.classList.toggle("open");
    navbar?.classList.toggle("open");
  });

  document.querySelectorAll(".links a").forEach(a => {
    a.addEventListener("click", () => {
      panel?.classList.remove("open");
      navbar?.classList.remove("open");
    });
  });

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const menuEl = navbar;

  if (menuEl && !prefersReducedMotion.matches) {
    const enterY = Number.parseFloat(getComputedStyle(menuEl).getPropertyValue("--enter-y")) || -18;
    menuEl.style.opacity = "0";
    menuEl.style.transform = `translate3d(0, ${enterY}px, 0)`;

    const startTime = performance.now();
    const duration = 720;

    const step = (now) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      menuEl.style.opacity = String(progress);
      menuEl.style.transform = `translate3d(0, ${enterY * (1 - progress)}px, 0)`;
      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };
    requestAnimationFrame(step);
  } else if (menuEl) {
    menuEl.style.opacity = "1";
    menuEl.style.transform = "none";
  }
</script>

<style>
  .menu {
    --enter-y: -18px;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0 max(16px, calc((100vw - 1200px) / 2));
    min-height: 161px;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .menu .brand {
    width: 161px;
    height: 161px;
    flex: 0 0 auto;
    pointer-events: auto;
    overflow: clip;
    border-radius: 100px;
  }
  .menu .brand img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .menu .panel {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 12.8px 50.4px;
    background: #f9f5f2;
    border-radius: 0 0 12.8px 12.8px;
    box-shadow:
      8.8px 11.2px 6.12px rgba(0,0,0,.23),
      0 3.2px 1.6px rgba(0,0,0,.25),
      2.4px 3.2px 0 rgba(0,0,0,.25),
      -1.6px 3.2px 1.6px rgba(0,0,0,.4);
    transform: translateX(-2px);
    margin-top: 0;
    min-width: min(100%, 735px);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 25px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links a {
    color: #000;
    font-family: 'Inconsolata', monospace;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    text-decoration: none;
  }
  .links a:hover { opacity: 0.7; }
  .dev-readout {
    display: none;
    align-items: center;
    gap: 10px;
    margin-left: 18px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(98, 4, 4, 0.08);
    color: #620404;
    font-family: 'Inconsolata', monospace;
    font-size: 13px;
    line-height: 1;
    white-space: nowrap;
  }
  .dev-readout strong {
    font-weight: 900;
    color: #be572a;
  }
  .dev-readout.is-visible {
    display: inline-flex;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 27px;
    border-radius: 48px;
    background: #d2892d;
    color: #eee2d9;
    font-family: 'Inconsolata', monospace;
    font-weight: 900;
    text-decoration: none;
    box-shadow:
      0.8px 2.4px 0 #464646,
      0 6.4px 9.6px rgba(0,0,0,.15),
      0 3.2px 3.2px rgba(0,0,0,.3);
  }
  .cta:hover {
    color: #eee2d9;
    filter: brightness(0.98);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    pointer-events: auto;
    margin-left: auto;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #000;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1200px) {
    .menu { padding: 0 1rem; }
  }
  @media (max-width: 900px) {
    .menu {
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    .menu .panel { flex-wrap: wrap; justify-content: center; }
  }
  @media (max-width: 768px) {
    .menu {
      min-height: auto;
      padding: 12px 16px;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
    .menu .brand {
      width: 88px;
      height: 88px;
    }
    .menu .panel {
      display: none;
      width: 100%;
      order: 3;
      background: rgba(249, 245, 242, 0.94);
      backdrop-filter: blur(10px);
      border-radius: 0 0 12.8px 12.8px;
      padding: 16px;
      gap: 16px;
      flex-direction: column;
      align-items: stretch;
      transform: none;
      min-width: auto;
      box-shadow:
        8.8px 11.2px 6.12px rgba(0,0,0,.23),
        0 3.2px 1.6px rgba(0,0,0,.25),
        2.4px 3.2px 0 rgba(0,0,0,.25),
        -1.6px 3.2px 1.6px rgba(0,0,0,.4);
    }
    .menu .panel.open {
      display: flex;
    }
    .links {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
    .cta {
      align-self: flex-start;
    }
    .nav-toggle { display: flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu {
      opacity: 1;
      transform: none;
    }
  }
</style>