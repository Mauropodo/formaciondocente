---
import brandImage from "../assets/figma-mcp/inicio/logo.png";

const menuItems = [
  { label: 'Inicio', href: '/inicio' },
  { label: 'Quiénes Somos', href: '/quienes-somos' },
  { label: 'La Investigación', href: '/investigacion' },
  { label: 'Bitácora', href: '/publicaciones' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header class="menu" id="navbar">
  <a class="brand" href="/inicio" aria-label="Ir al inicio">
    <img src={brandImage.src} alt="Parvularias" />
  </a>
  <nav class="panel" id="nav-panel" aria-label="Principal">
    <ul class="links">
      {menuItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <div class="dev-readout" data-dev-readout aria-live="polite">
      <span>scroll <strong data-dev-scroll>0px</strong></span>
      <span>hero <strong data-dev-hero>0%</strong></span>
    </div>
    <a class="cta" href="/publicaciones">Relatos</a>
  </nav>
  <button
    class="nav-toggle"
    id="nav-toggle"
    type="button"
    aria-label="Menú"
    aria-controls="nav-panel"
    aria-expanded="false"
  >
    <span></span><span></span><span></span>
  </button>
</header>

<script>
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("nav-toggle");
  const panel = navbar?.querySelector(".panel");
  const mobileQuery = window.matchMedia("(max-width: 900px)");

  const syncMenuState = (isOpen) => {
    panel?.classList.toggle("open", isOpen);
    navbar?.classList.toggle("open", isOpen);
    toggle?.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("nav-menu-open", isOpen && mobileQuery.matches);
  };

  toggle?.addEventListener("click", () => {
    syncMenuState(!panel?.classList.contains("open"));
  });

  [...document.querySelectorAll(".links a"), ...document.querySelectorAll(".cta")].forEach(a => {
    a.addEventListener("click", () => {
      syncMenuState(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && panel?.classList.contains("open")) {
      syncMenuState(false);
    }
  });

  mobileQuery.addEventListener("change", (event) => {
    if (!event.matches) {
      syncMenuState(false);
    } else {
      document.body.classList.toggle("nav-menu-open", panel?.classList.contains("open") ?? false);
    }
  });

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const menuEl = navbar;

  if (menuEl && !prefersReducedMotion.matches) {
    const enterY = Number.parseFloat(getComputedStyle(menuEl).getPropertyValue("--enter-y")) || -18;
    menuEl.style.opacity = "0";
    menuEl.style.transform = `translate3d(0, ${enterY}px, 0)`;

    const startTime = performance.now();
    const duration = 720;

    const step = (now) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      menuEl.style.opacity = String(progress);
      menuEl.style.transform = `translate3d(0, ${enterY * (1 - progress)}px, 0)`;
      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };
    requestAnimationFrame(step);
  } else if (menuEl) {
    menuEl.style.opacity = "1";
    menuEl.style.transform = "none";
  }
</script>

<style>
  .menu {
    --enter-y: -18px;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0 max(16px, calc((100vw - 1200px) / 2));
    min-height: 130px;
    pointer-events: none;
    will-change: opacity, transform;
  }
  .menu .brand {
    width: 130px;
    height: 130px;
    flex: 0 0 auto;
    pointer-events: auto;
    overflow: clip;
    border-radius: 100px;
  }
  .menu .brand img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .menu .panel {
    box-sizing: border-box;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 12.8px 50.4px;
    background: #f9f5f2;
    border-radius: 0 0 12.8px 12.8px;
    box-shadow:
      8.8px 11.2px 6.12px rgba(0,0,0,.23),
      0 3.2px 1.6px rgba(0,0,0,.25),
      2.4px 3.2px 0 rgba(0,0,0,.25),
      -1.6px 3.2px 1.6px rgba(0,0,0,.4);
    transform: translateX(-2px);
    margin-top: 0;
    min-width: min(100%, 735px);
  }
  .links {
    display: flex;
    align-items: center;
    gap: 25px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .links a {
    color: #000;
    font-family: 'Inconsolata', monospace;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    text-decoration: none;
  }
  .links a:hover { opacity: 0.7; }
  .dev-readout {
    display: none;
    align-items: center;
    gap: 10px;
    margin-left: 18px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(98, 4, 4, 0.08);
    color: #620404;
    font-family: 'Inconsolata', monospace;
    font-size: 13px;
    line-height: 1;
    white-space: nowrap;
  }
  .dev-readout strong {
    font-weight: 900;
    color: #be572a;
  }
  .dev-readout.is-visible {
    display: inline-flex;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 27px;
    border-radius: 48px;
    background: #d2892d;
    color: #eee2d9;
    font-family: 'Inconsolata', monospace;
    font-weight: 900;
    text-decoration: none;
    flex-shrink: 0;
    box-shadow:
      0.8px 2.4px 0 #464646,
      0 6.4px 9.6px rgba(0,0,0,.15),
      0 3.2px 3.2px rgba(0,0,0,.3);
  }
  .cta:hover {
    color: #eee2d9;
    filter: brightness(0.98);
  }
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    pointer-events: auto;
    margin-left: auto;
  }
  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #000;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu.open .nav-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu.open .nav-toggle span:nth-child(2) {
    opacity: 0;
  }
  .menu.open .nav-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 1200px) {
    .menu { padding: 0 1rem; }
  }
  @media (max-width: 1200px) {
    .menu .brand {
      width: 130px;
      height: 130px;
    }
  }
  @media (max-width: 900px) {
    .menu {
      padding: 12px 16px;
      flex-direction: row;
      align-items: center;
      min-height: auto;
    }
    .menu .brand {
      width: 130px;
      height: 130px;
      position: relative;
      z-index: 2;
    }
    .menu .panel {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      min-height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border-radius: 0;
      padding: 132px 28px 32px;
      overflow-y: auto;
      overscroll-behavior: contain;
      background:
        linear-gradient(180deg, rgba(249, 245, 242, 0.98), rgba(238, 226, 217, 0.98));
      backdrop-filter: blur(12px);
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 28px;
      min-width: 0;
      max-width: none;
      box-shadow:
        8.8px 11.2px 6.12px rgba(0,0,0,.23),
        0 3.2px 1.6px rgba(0,0,0,.25),
        2.4px 3.2px 0 rgba(0,0,0,.25),
        -1.6px 3.2px 1.6px rgba(0,0,0,.4);
      transform: translate3d(100%, 0, 0);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        transform 0.35s ease,
        opacity 0.25s ease,
        visibility 0s linear 0.35s;
    }
    .menu .panel.open {
      transform: translate3d(0, 0, 0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition:
        transform 0.35s ease,
        opacity 0.25s ease,
        visibility 0s;
    }
    .links {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      width: 100%;
    }
    .links li {
      width: 100%;
    }
    .links a {
      display: block;
      width: 100%;
      font-size: clamp(2rem, 8vw, 3rem);
      line-height: 0.95;
      text-align: left;
    }
    .dev-readout {
      margin-left: 0;
    }
    .cta {
      align-self: flex-start;
      margin-top: auto;
      font-size: 1rem;
      padding: 14px 28px;
    }
    .nav-toggle {
      display: flex;
      position: relative;
      z-index: 2;
      width: 52px;
      height: 52px;
      align-items: center;
      justify-content: center;
      padding: 0;
      border-radius: 999px;
      background: rgba(249, 245, 242, 0.92);
      box-shadow:
        0.8px 2.4px 0 #464646,
        0 6.4px 9.6px rgba(0,0,0,.12);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu {
      opacity: 1;
      transform: none;
    }
    .menu .panel {
      transition: none;
    }
  }

  :global(body.nav-menu-open) {
    overflow: hidden;
  }
</style>
