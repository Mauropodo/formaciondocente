---
interface Props {
  title: string;
  slug: string;
  excerpt: string;
  fecha: string;
  categoria: string;
  categoriaSlug: string;
  autor?: string;
}
const { title, slug, excerpt, fecha, categoria, categoriaSlug, autor } = Astro.props;
---

<article class="blog-card">
  <div class="card-img-placeholder"></div>
  <div class="card-body">
    <div class="card-meta">
      <span class="card-categoria">{categoria}</span>
      <span class="card-fecha">{fecha}</span>
    </div>
    <h3><a href={`/publicaciones/${slug}`}>{title}</a></h3>
    <p>{excerpt}</p>
    {autor && <span class="card-autor">Por {autor}</span>}
    <a href={`/publicaciones/${slug}`} class="card-link">Leer más →</a>
  </div>
</article>

<style>
  .blog-card {
    background: var(--color-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--color-border);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }
  .card-img-placeholder {
    height: 180px;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-secondary));
  }
  .card-body {
    padding: var(--gap-md);
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--gap-sm);
    font-size: 0.8rem;
  }
  .card-categoria {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    padding: 2px 10px;
    border-radius: 20px;
    font-weight: 600;
  }
  .card-fecha { color: var(--color-text-light); }
  .blog-card h3 { font-size: 1.125rem; margin-bottom: var(--gap-sm); }
  .blog-card h3 a { color: var(--color-text); }
  .blog-card h3 a:hover { color: var(--color-primary); }
  .blog-card p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    flex: 1;
    margin-bottom: var(--gap-sm);
  }
  .card-autor {
    font-size: 0.8rem;
    color: var(--color-text-light);
    margin-bottom: var(--gap-sm);
  }
  .card-link {
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: auto;
  }
</style>
