---
interface Props {
  title: string;
  slug: string;
  excerpt: string;
  fecha: string;
  categoria: string;
  categoriaSlug: string;
  autor?: string;
  index?: number;
}
const { title, slug, excerpt, fecha, categoria, categoriaSlug, autor, index = 0 } = Astro.props;
const rotations = ["-2deg", "1deg", "-3deg"];
const rotation = rotations[index % 3];
const cardBg = "#eee2d9";
---

<article class="blog-card" style={`--card-rotate:${rotation};--card-bg:${cardBg}`}>
  <div class="card-inner">
    <div class="card-img"></div>
    <div class="card-content">
      <h3 class="card-title"><a href={`/publicaciones/${slug}`}>{title}</a></h3>
      <p class="card-text">{excerpt}</p>
      <div class="card-footer">
        <div class="card-tags">
          <span class="card-tag tag-relatos">Relatos</span>
          <span class="card-tag tag-marco">Marco teórico</span>
          <span class="card-tag tag-hitos">Hitos</span>
        </div>
        {autor && <span class="card-author">{autor}</span>}
      </div>
    </div>
  </div>
</article>

<style>
  .blog-card {
    transform: rotate(var(--card-rotate, 0deg));
    transition: transform 0.35s ease;
  }
  .blog-card:hover {
    transform: rotate(0deg);
  }
  .card-inner {
    display: flex;
    gap: 25px;
    background: var(--card-bg, #eee2d9);
    border-radius: 38.4px;
    padding-right: 24px;
    box-shadow:
      8.8px 11.2px 6.12px rgba(0,0,0,0.23),
      0px 3.2px 1.6px rgba(0,0,0,0.25),
      2.4px 3.2px 0px rgba(0,0,0,0.25),
      -1.6px 3.2px 1.6px rgba(0,0,0,0.4);
    overflow: hidden;
    height: 100%;
    min-height: 310px;
  }
  .card-img {
    flex: 0 0 auto;
    width: 77px;
    align-self: stretch;
    background: linear-gradient(135deg, var(--color-primary-300), var(--color-tertiary-300));
    border-radius: 38.4px 0 0 38.4px;
  }
  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 25px 0;
    min-width: 0;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 28.8px;
    line-height: 28px;
    color: var(--color-text-primary);
    margin: 0;
    word-break: break-word;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
  }
  .card-title a:hover {
    color: var(--color-primary);
  }
  .card-text {
    font-family: 'Inconsolata', monospace;
    font-weight: 400;
    font-size: 17.6px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.3;
  }
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: flex-start;
    width: 100%;
  }
  .card-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .card-tag {
    padding: 5px 10px;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #161616;
    border: 2px solid;
  }
  .tag-relatos { background: #e5e5c6; border-color: #7b7a4a; }
  .tag-marco { background: #f3b568; border-color: #f0a443; }
  .tag-hitos { background: #cee6dd; border-color: #98b5ab; }
  .card-author {
    font-family: 'Inconsolata', monospace;
    font-weight: 400;
    font-size: 17.6px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .blog-card { transform: none !important; }
    .card-inner { flex-direction: column; padding-right: 0; min-height: auto; }
    .card-img { width: 100%; height: 120px; border-radius: 38.4px 38.4px 0 0; }
    .card-content { padding: 20px; }
    .card-title { font-size: 22px; line-height: 1.2; }
    .card-text { font-size: 15px; }
  }
</style>
