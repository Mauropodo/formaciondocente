---
interface CardCategory {
  slug: string;
  name: string;
}

interface Props {
  title: string;
  slug: string;
  excerpt: string;
  fecha?: string;
  categoria?: string;
  categoriaSlug?: string;
  categories?: CardCategory[];
  imageUrl?: string | null;
  autor?: string;
  index?: number;
}

const {
  title,
  slug,
  excerpt,
  categoria,
  categoriaSlug,
  categories = [],
  imageUrl = null,
  autor,
  index = 0,
} = Astro.props;

const rotations = ["-2deg", "1deg", "-3deg"];
const rotation = rotations[index % 3];
const cardBg = "#eee2d9";

const fallbackCategories = categoria && categoriaSlug
  ? [{ name: categoria, slug: categoriaSlug }]
  : [];

const resolvedCategories = (categories.length > 0 ? categories : fallbackCategories).slice(0, 3);

const categoryColors = {
  "noticias":        { bg: "#f9f5f2", border: "#e6cbcb" },
  "marco-teorico":   { bg: "#f3b568", border: "#f0a443" },
  "reflexiones":     { bg: "#95b3a7", border: "#214d51" },
  "hitos":           { bg: "#cee6dd", border: "#98b5ab" },
  "relatos":         { bg: "#e5e5c6", border: "#7b7a4a" },
  "aprendizajes":    { bg: "#f0d0d0", border: "#620404" },
  "experiencias":    { bg: "#a1cad3", border: "#4a5c7c" },
  "papers":          { bg: "#f9f5f2", border: "#e6cbcb" },
  "buenas-practicas":{ bg: "#f9f5f2", border: "#e6cbcb" },
  "comentarios":     { bg: "#f9f5f2", border: "#e6cbcb" },
  "uncategorized":   { bg: "#f9f5f2", border: "#e6cbcb" },
};
---

<article class="blog-card" style={`--card-rotate:${rotation};--card-bg:${cardBg}`}>
  <a class="card-link" href={`/publicaciones/${slug}`} aria-label={`Leer ${title}`}>
    <div class="card-inner">
      <div class={`card-img ${imageUrl ? 'card-img--has-image' : 'card-img--fallback'}`}>
        {imageUrl && <img src={imageUrl} alt={title} loading="lazy" />}
      </div>
      <div class="card-content">
        <h3 class="card-title">{title}</h3>
        <p class="card-text">{excerpt}</p>
        <div class="card-footer">
          {resolvedCategories.length > 0 && (
            <div class="card-tags">
              {resolvedCategories.map((category) => {
                const colors = categoryColors[category.slug] || { bg: "#f9f5f2", border: "#e6cbcb" };
                return (
                  <span
                    class="card-tag"
                    style={`--tag-bg:${colors.bg};--tag-border:${colors.border}`}
                  >
                    {category.name}
                  </span>
                );
              })}
            </div>
          )}
          {autor && <span class="card-author">{autor}</span>}
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    transform: rotate(var(--card-rotate, 0deg));
    transition: transform 0.35s ease;
  }
  .blog-card:hover {
    transform: rotate(0deg) translateY(-8px) scale(1.015);
  }
  .card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .card-link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 5px;
    border-radius: 38.4px;
  }
  .card-inner {
    display: flex;
    gap: 25px;
    background: var(--card-bg, #eee2d9);
    border-radius: 38.4px;
    padding-right: 24px;
    box-shadow:
      8.8px 11.2px 6.12px rgba(0,0,0,0.23),
      0px 3.2px 1.6px rgba(0,0,0,0.25),
      2.4px 3.2px 0px rgba(0,0,0,0.25),
      -1.6px 3.2px 1.6px rgba(0,0,0,0.4);
    overflow: hidden;
    height: 100%;
    min-height: 310px;
    transition: transform 0.35s ease, box-shadow 0.35s ease, filter 0.35s ease;
  }
  .card-link:hover .card-inner,
  .card-link:focus-visible .card-inner {
    transform: translateY(-6px);
    filter: saturate(1.12) brightness(1.06);
    box-shadow:
      10px 16px 10px rgba(0,0,0,0.22),
      0px 4px 2px rgba(0,0,0,0.25),
      2.4px 3.2px 0px rgba(0,0,0,0.25),
      -1.6px 3.2px 1.6px rgba(0,0,0,0.4);
  }
  .card-img {
    flex: 0 0 auto;
    width: 110px;
    align-self: stretch;
    border-radius: 38.4px 0 0 38.4px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-primary-300), var(--color-tertiary-300));
  }
  .card-img--has-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 25px 0;
    min-width: 0;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-weight: 600;
    font-size: 28.8px;
    line-height: 28px;
    color: var(--color-text-primary);
    margin: 0;
    word-break: break-word;
  }
  .card-text {
    font-family: 'Inconsolata', monospace;
    font-weight: 400;
    font-size: 17.6px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: flex-start;
    width: 100%;
  }
  .card-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .card-tag {
    padding: 5px 10px;
    border-radius: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #161616;
    border: 2px solid var(--tag-border, #e6cbcb);
    background: var(--tag-bg, #f9f5f2);
  }
  .card-author {
    font-family: 'Inconsolata', monospace;
    font-weight: 400;
    font-size: 17.6px;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .blog-card { transform: none !important; }
    .card-inner { flex-direction: column; padding-right: 0; min-height: auto; }
    .card-img { width: 100%; height: 120px; border-radius: 38.4px 38.4px 0 0; }
    .card-content { padding: 20px; }
    .card-title { font-size: 22px; line-height: 1.2; }
    .card-text { font-size: 15px; -webkit-line-clamp: 5; }
  }
</style>
