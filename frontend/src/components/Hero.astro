---
interface Props {
  title: string;
  subtitle?: string;
  cta?: string;
  ctaLink?: string;
  secondaryCta?: string;
  secondaryLink?: string;
}
const { title, subtitle, cta, ctaLink, secondaryCta, secondaryLink } = Astro.props;
---

<section class="hero" id="hero-section">
  <div class="container hero-content">
    <h1 id="hero-title">{title}</h1>
    {subtitle && <p id="hero-subtitle" class="hero-subtitle">{subtitle}</p>}
    {(cta || secondaryCta) && (
      <div id="hero-cta" class="hero-cta">
        {cta && <a href={ctaLink || '#'} class="btn btn-primary">{cta}</a>}
        {secondaryCta && <a href={secondaryLink || '#'} class="btn btn-outline">{secondaryCta}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-secondary) 100%);
  }
  .hero-content { max-width: 700px; }
  .hero h1 { font-size: 3rem; color: var(--color-primary-dark); margin-bottom: var(--gap-md); }
  .hero-subtitle { font-size: 1.25rem; color: var(--color-text-light); margin-bottom: var(--gap-lg); }
  .hero-cta { display: flex; gap: var(--gap-md); justify-content: center; flex-wrap: wrap; }
  @media (max-width: 768px) {
    .hero h1 { font-size: 2.2rem; }
  }
</style>
