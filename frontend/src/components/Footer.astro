<script>
  const card = document.getElementById('footerCard');
  if (card) {
    const reveal = () => card.classList.add('is-visible');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            reveal();
            observer.unobserve(card);
          }
        },
        { threshold: 0.15 }
      );
      observer.observe(card);

      // WebKit can defer the observer when the page contains transformed sections.
      // Keep the normal reveal when it fires, but never leave the footer invisible.
      window.setTimeout(reveal, 1800);
    } else {
      reveal();
    }
  }
</script>

<style>
  .footer-section { position: relative; z-index: 1; width: 100%; padding: 4rem 0vw 5rem; }
  .footer-card {
    background: #fff; border-radius: 20px;
    width: 100%;
    max-width: 1200px;
    box-sizing: border-box;
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 3rem) 2rem;
    display: flex; flex-wrap: wrap; gap: 3rem;
    justify-content: space-between; align-items: flex-start;
    box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
    opacity: 0; transform: translateY(60px); transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .footer-card.is-visible { opacity: 1; transform: translateY(0); }
  .footer-col { display: flex; flex-direction: column; gap: 1.5rem; min-width: 140px; }
  .footer-col--interest { width: 25%; max-width: 25%; min-width: 0; }
  .footer-col--interest .footer-links { overflow-wrap: anywhere; font-weight: 400; }
  .footer-interest-list,
  .footer-site-list { list-style: none; margin: 0; padding: 0; }
  .footer-interest-list li,
  .footer-site-list li { display: flex; align-items: flex-start; gap: 0.5rem; }
  .footer-interest-list li::before,
  .footer-site-list li::before { content: "—"; flex: 0 0 auto; }
  .footer-title { font-family: 'Playfair Display', serif; font-weight: 700; font-size: clamp(18px, 1.5vw, 22px); color: #620404; text-transform: uppercase; }
  .footer-links { display: flex; flex-direction: column; gap: 0.5rem; font-family: 'Inconsolata', monospace; font-size: 14px; letter-spacing: 3px; line-height: 1.6; color: #620404; text-transform: uppercase; }
  .footer-links a { color: #620404; text-decoration: none; transition: opacity .2s; }
  .footer-links a:hover { opacity: .7; }
  .footer-social { display: flex; flex-direction: column; gap: 0.75rem; }
  .footer-social-link { display: flex; align-items: center; gap: 0.75rem; font-family: 'Inconsolata', monospace; font-size: 14px; letter-spacing: 3px; color: #620404; text-transform: uppercase; text-decoration: none; transition: opacity .2s; }
  .footer-social-link:hover { opacity: .7; }
  .footer-logo { width: 249px; max-width: 100%; padding: 25px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; }
  .footer-logo img { width: 100%; height: auto; display: block; object-fit: contain; }

  @media (max-width: 900px) {
    .footer-card {
      width: 80%;
      max-width: 80%;
      gap: 2rem;
      padding: 1.75rem 1.25rem;
    }

    .footer-col {
      width: 100%;
      min-width: 0;
      flex: 0 0 100%;
    }
    .footer-col--interest {
      width: 100%;
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-card { opacity: 1; transform: none; transition: none; }
  }
</style>
