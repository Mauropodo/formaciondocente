---
import VoicePostDeck from "../components/VoicePostDeck.astro";
import { getLatestPosts } from "../lib/posts";

const voicePosts = getLatestPosts(5);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sin título - Figma Home</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inconsolata:wght@400;700;900&family=Playfair+Display:wght@400;500;600;700&family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f9f5f2;
      --bg-soft: #f4ebe6;
      --paper: #eee2d9;
      --text: #620404;
      --text-soft: #514444;
      --primary: #be572a;
      --accent: #d2892d;
      --teal: #3b959e;
      --orange: #c36438;
      --green: #8bc5ae;
      --shadow-paper: 0 1px 0 rgba(255,255,255,.6) inset, 0 12px 26px rgba(76,54,43,.14), 0 3px 10px rgba(76,54,43,.08);
      --shadow-deep: 0 14px 34px rgba(76,54,43,.18);
      --nav-h: 161px;
      --radius: 24px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .page {
      position: relative;
      min-height: 100vh;
      isolation: isolate;
    }
    .layout {
      position: relative;
      z-index: 1;
      width: 100%;
    }
    .story-stack {
      position: relative;
      min-height: 3175px;
      overflow: clip;
      background: var(--bg);
    }
    .bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: #fff;
      overflow: hidden;
      pointer-events: none;
    }
    .bg-shape {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translate3d(-9vw, 0, 0);
      will-change: transform, opacity;
      backface-visibility: hidden;
    }
    .bg-shape svg {
      width: 100%;
      height: 100%;
      display: block;
      user-select: none;
      pointer-events: none;
      overflow: visible;
    }
    .story-stack.is-bg-revealed .bg-shape {
      animation: bgLayerEnter 1.25s cubic-bezier(.2,.75,.18,1) forwards;
    }
    .story-stack.is-bg-revealed .bg-shape--1 { animation-delay: 0.12s; }
    .story-stack.is-bg-revealed .bg-shape--2 { animation-delay: 0.34s; }
    .story-stack.is-bg-revealed .bg-shape--3 { animation-delay: 0.56s; }
    .story-stack.is-bg-revealed .bg-shape--4 { animation-delay: 0.78s; }
    @keyframes bgLayerEnter {
      0% {
        opacity: 0;
        transform: translate3d(-9vw, 0, 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }
    .menu {
      --enter-y: -18px;
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 40;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 0 max(16px, calc((100vw - 1200px) / 2));
      min-height: var(--nav-h);
      pointer-events: none;
      opacity: 0;
      transform: translate3d(0, var(--enter-y), 0);
      will-change: opacity, transform;
    }
    .menu .brand {
      width: 161px;
      height: 161px;
      flex: 0 0 auto;
      pointer-events: auto;
      overflow: clip;
      border-radius: 100px;
    }
    .menu .panel {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 12.8px 50.4px;
      background: #f9f5f2;
      border-radius: 0 0 12.8px 12.8px;
      box-shadow: 8.8px 11.2px 6.12px rgba(0,0,0,.23), 0 3.2px 1.6px rgba(0,0,0,.25), 2.4px 3.2px 0 rgba(0,0,0,.25), -1.6px 3.2px 1.6px rgba(0,0,0,.4);
      transform: translateX(-2px);
      margin-top: 0;
      min-width: min(100%, 735px);
    }
    .menu .dev-readout {
      display: none;
      align-items: center;
      gap: 10px;
      margin-left: 18px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(98, 4, 4, 0.08);
      color: var(--text);
      font-family: Inconsolata, monospace;
      font-size: 13px;
      line-height: 1;
      white-space: nowrap;
    }
    .menu .dev-readout strong {
      font-weight: 900;
      color: var(--primary);
    }
    .menu .dev-readout.is-visible {
      display: inline-flex;
    }
    .links {
      display: flex;
      align-items: center;
      gap: 25px;
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      color: #000;
      white-space: nowrap;
    }
    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 27px;
      border-radius: 48px;
      background: var(--accent);
      color: #eee2d9;
      font-family: Inconsolata, monospace;
      font-weight: 900;
      box-shadow:
        0.8px 2.4px 0 #464646,
        0 6.4px 9.6px rgba(0,0,0,.15),
        0 3.2px 3.2px rgba(0,0,0,.3);
    }
    .hero {
      position: sticky;
      top: 0;
      min-height: 100svh;
      width: min(100%, 1200px);
      margin: 0 auto;
      padding: 0 16px;
      overflow: clip;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(440px, 586px);
      align-items: center;
      column-gap: clamp(24px, 4vw, 56px);
      z-index: 2;
    }
    .hero-copy {
      --enter-x: -40px;
      --enter-y: -10px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 10px;
      align-self: center;
      transform: translate3d(var(--enter-x), var(--enter-y), 0);
      opacity: 0;
      max-width: 690px;
    }
    .hero h1 {
      margin: 0;
      font-family: "Playfair Display", serif;
      font-size: clamp(2.4rem, 3.5vw, 44.8px);
      line-height: 1.05;
      text-transform: uppercase;
      color: var(--text);
      max-width: 690px;
      text-wrap: balance;
    }
    .hero .eyebrow {
      margin: 0;
      font-family: "Red Hat Display", sans-serif;
      text-transform: uppercase;
      letter-spacing: 5.4px;
      font-size: 20px;
      color: var(--text);
    }
    .hero-slider {
      --enter-x: 40px;
      --enter-y: -10px;
      position: relative;
      width: 100%;
      max-width: 586px;
      aspect-ratio: 11 / 8;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      justify-self: end;
      transform: translate3d(var(--enter-x), var(--enter-y), 0);
      opacity: 0;
    }
    .hero-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 6.5px 9.8px 4.9px rgba(0,0,0,.15), 0 3.3px 3.3px rgba(0,0,0,.3);
      opacity: 0;
      transition: opacity 700ms ease, transform 700ms ease;
      will-change: opacity, transform;
      pointer-events: none;
      object-fit: cover;
      object-position: center;
    }
    .hero-slide.is-active {
      opacity: 1;
      transform: rotate(-2deg) translateZ(0);
      z-index: 2;
    }
    .hero-slide.is-second {
      opacity: 1;
      transform: rotate(1deg) translate(18px, 16px) scale(0.98);
      z-index: 1;
      filter: saturate(0.98) brightness(0.98);
    }
    .scroll-hint {
      position: absolute;
      right: 120px;
      bottom: 54px;
      width: 167px;
      min-height: 76px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      font-family: Inconsolata, monospace;
      font-weight: 400;
      color: var(--text);
      font-size: 17px;
      line-height: 1;
      pointer-events: none;
      opacity: 0;
    }
    .scroll-hint .hint-icons {
      position: relative;
      width: 100%;
      height: 28px;
    }
    .scroll-hint .hint-icons img {
      position: absolute;
      right: 4px;
      width: 32px;
      height: 14px;
      object-fit: contain;
      opacity: 0;
      transform: translateY(-2px);
      will-change: opacity, transform;
    }
    .scroll-hint .hint-icons img:first-child {
      top: 0;
      animation: hintChevronOne 3s infinite ease-in-out;
    }
    .scroll-hint .hint-icons img:last-child {
      top: 14px;
      animation: hintChevronTwo 3s infinite ease-in-out;
    }
    @keyframes hintChevronOne {
      0%, 14% { opacity: 0; transform: translateY(-2px); }
      18% { opacity: 1; transform: translateY(0); }
      64% { opacity: 1; transform: translateY(0); }
      68%, 100% { opacity: 0; transform: translateY(2px); }
    }
    @keyframes hintChevronTwo {
      0%, 48% { opacity: 0; transform: translateY(-2px); }
      52% { opacity: 1; transform: translateY(0); }
      64% { opacity: 1; transform: translateY(0); }
      68%, 100% { opacity: 0; transform: translateY(2px); }
    }
    .connect {
      position: relative;
      min-height: 220svh;
      width: 100%;
      margin: 0;
      overflow: clip;
      padding: 0 clamp(16px, 3vw, 32px);
      z-index: 2;
      pointer-events: none;
    }
    .connect.is-active {
      pointer-events: auto;
    }
    .connect .content {
      position: sticky;
      top: 0;
      width: min(100%, 1280px);
      height: 100svh;
      min-height: 620px;
      margin: 0 auto;
    }
    .bubble {
      position: relative;
      padding: 54px 40px 54px;
      color: white;
      border-radius: 92px;
      min-height: 310px;
      box-shadow: var(--shadow-paper);
      overflow: hidden;
    }
    .bubble::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -18px;
      width: 62px;
      height: 42px;
      transform: translateX(-50%) rotate(8deg);
      background: inherit;
      clip-path: polygon(48% 0, 100% 45%, 74% 100%, 0 42%);
      filter: drop-shadow(0 4px 8px rgba(0,0,0,.12));
    }
    .bubble h2, .bubble p { position: relative; z-index: 1; margin: 0; }
    .bubble h2 {
      font-family: "Playfair Display", serif;
      font-size: 28.8px;
      margin-bottom: 18px;
      line-height: 1.1;
    }
    .bubble p {
      font-family: Inconsolata, monospace;
      font-size: 17.6px;
      line-height: 1.35;
    }
    .bubble.teal { background: var(--teal); }
    .bubble.orange { background: #de8b21; }
    .bubble.coral { background: var(--orange); }
    .bubble--quote {
      background: none;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
      isolation: isolate;
      padding: 0;
      color: #111;
    }
    .bubble--quote.orange {
      background: none;
    }
    .bubble--quote.orange .bubble-text {
      color: #fff;
      transform: rotate(2deg);
    }
    .bubble--quote.orange .bubble-mark {
      color: #fff;
    }
    .bubble--quote.coral {
      background: none;
    }
    .bubble--quote.coral .bubble-text,
    .bubble--quote.coral .bubble-mark {
      color: #fff;
    }
    .bubble--quote.coral .bubble-text {
      transform: rotate(5deg);
    }
    .bubble--quote.teal {
      background: none;
    }
    .bubble--quote.teal .bubble-text,
    .bubble--quote.teal .bubble-mark {
      color: #fff;
    }
    .bubble--quote .bubble-shape {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      transform: rotate(0deg);
      transform-origin: center;
    }
    .bubble--quote .bubble-shape svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      filter: drop-shadow(0 4px 15.3px rgba(0, 0, 0, 0.25));
    }
    .bubble--quote .bubble-quote {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4.6rem 4.2rem;
      transform: rotate(0deg);
      transform-origin: center;
    }
    .bubble--quote .bubble-text {
      margin: 0;
      max-width: 80%;
      font-family: Inconsolata, monospace;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-align: center;
      text-wrap: balance;
      color: #111;
      align-self: center;
      transform: rotate(-3deg);
      transform-origin: center;
    }
    .bubble--quote .bubble-mark {
      position: absolute;
      z-index: 2;
      font-family: "Playfair Display", serif;
      font-size: 5.4rem;
      line-height: 0.7;
      color: #5b4747;
      pointer-events: none;
      user-select: none;
    }
    .bubble--quote .bubble-mark--open {
      top: 3.25rem;
      left: 4.1rem;
    }
    .bubble--quote .bubble-mark--close {
      right: 5.2rem;
      bottom: 4.2rem;
    }
    .connect .bubble {
      position: absolute;
    }
    .connect .bubble--quote {
      --bubble-shift-x: 0px;
      --bubble-shift-y: 0px;
      --bubble-rotate: 0deg;
      opacity: 0;
      transform: translate3d(var(--bubble-shift-x), var(--bubble-shift-y), 0) rotate(var(--bubble-rotate));
      will-change: transform, opacity;
    }
    .connect .bubble.green {
      left: 0;
      top: -6px;
      width: 558px;
      aspect-ratio: 589 / 370;
      min-height: 0;
    }
    .connect .bubble.orange {
      right: 0;
      top: 0;
      width: 558px;
      aspect-ratio: 589 / 370;
      min-height: 0;
    }
    .connect .content > article.bubble.orange:not(.bubble--quote) {
      display: none;
    }
    .connect .bubble.coral {
      left: 0;
      bottom: 14px;
      width: 558px;
      aspect-ratio: 591 / 379;
      min-height: 0;
    }
    .connect .content > article.bubble.coral:not(.bubble--quote) {
      display: none;
    }
    .connect .bubble.teal {
      right: 0;
      bottom: 0;
      width: 558px;
      aspect-ratio: 590 / 375;
      min-height: 0;
    }
    .connect .content > article.bubble.teal:not(.bubble--quote) {
      display: none;
    }
    .voices {
      position: relative;
      min-height: 1064px;
      padding: 10px 10px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 71px;
      overflow: clip;
      z-index: 1;
    }
    .voices h2,
    .question h2,
    .closing h2 {
      margin: 0;
      font-family: "Playfair Display", serif;
      font-size: 44.8px;
      text-transform: uppercase;
      color: var(--primary);
      text-align: center;
      line-height: 1.05;
    }
    .cards {
      position: relative;
      width: min(1216px, 100%);
      height: 410px;
    }
    .voice-card {
      position: absolute;
      width: 544px;
      min-height: 310px;
      border-radius: 48px;
      padding: 32px 24px 32px 40px;
      color: white;
      box-shadow: 8.8px 11.2px 6.12px rgba(0,0,0,.23), 0 3.2px 1.6px rgba(0,0,0,.25), 2.4px 3.2px 0 rgba(0,0,0,.25), -1.6px 3.2px 1.6px rgba(0,0,0,.4);
      display: grid;
      grid-template-columns: 180px 1fr;
      align-items: stretch;
      overflow: hidden;
    }
    .voice-card.teal { left: 0; top: 53px; transform: rotate(-3deg); }
    .voice-card.orange { left: 328px; top: 0; transform: rotate(4deg); }
    .voice-card.coral { left: 658px; top: 49px; transform: rotate(-4deg); }
    .voice-card .photo {
      border-radius: 38.4px 0 0 38.4px;
      overflow: hidden;
      margin-right: 24px;
    }
    .voice-card .body {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 18px;
      font-family: Inter, sans-serif;
    }
    .voice-card h3 {
      margin: 0;
      font-family: "Playfair Display", serif;
      font-size: 28.8px;
      line-height: 1.1;
    }
    .voice-card p {
      margin: 0;
      font-size: 17.6px;
      line-height: 1.6;
    }
    .voice-card .author {
      font-family: Inconsolata, monospace;
      font-size: 17.6px;
    }
    .voice-card.teal { background: var(--teal); }
    .voice-card.orange { background: #de8b21; }
    .voice-card.coral { background: var(--orange); }
    .voices .more {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 16px 105px;
      border-radius: 38px;
      background: #464646;
      color: white;
      font-family: Inconsolata, monospace;
      font-size: 28.8px;
      font-weight: 900;
      box-shadow: 0.8px 2.4px 0 #464646, 0 6.4px 9.6px rgba(0,0,0,.15), 0 3.2px 3.2px rgba(0,0,0,.3);
    }
    .question-story {
      position: relative;
      background: linear-gradient(90deg, var(--paper) 0%, var(--paper) 50%, #f7efe6 50%, #f7efe6 100%);
      overflow: hidden;
      z-index: 1;
      min-height: 100svh;
    }
    .question-story__prompt-float {
      position: absolute;
      inset: 0 auto 0 -1400px;
      z-index: 12;
      width: 1920px;
      height: 100%;
      pointer-events: none;
    }
    .question-story__prompt-float svg {
      display: block;
      width: auto;
      height: 100%;
      overflow: visible;
    }
    .question-story__viewport {
      position: relative;
      width: 100%;
      height: auto;
      overflow: visible;
      z-index: 1;
    }
    .question-story__track {
      display: grid;
      width: 100%;
      height: auto;
    }
    .question-story__panel {
      position: relative;
      width: 100%;
      min-height: 100svh;
      height: auto;
      display: grid;
      align-items: center;
      overflow: hidden;
    }
    .question-story__panel--prompt {
      background: var(--paper);
      place-items: center;
      grid-template-columns: minmax(0, 1fr);
      padding: 0;
    }
    .question-story__panel--followup {
      background: #f7efe6;
      grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1.05fr);
      gap: clamp(32px, 5vw, 88px);
      padding: 0 clamp(32px, 5vw, 88px);
    }
    .question-story__prompt-copy,
    .question-story__followup-copy {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: 18px;
      max-width: 600px;
    }
    .question-story__prompt-copy {
      text-align: center;
      align-items: center;
      justify-content: center;
      min-height: 100%;
      padding-bottom: 0;
      width: 100%;
      padding-inline: clamp(32px, 5vw, 88px);
    }
    .question-story__followup-copy {
      align-self: center;
      padding-top: 32px;
      transform: none;
      opacity: 1;
    }
    .question-story__prompt-copy h2,
    .question-story__followup-copy h2 {
      margin: 0;
      font-family: "Playfair Display", serif;
      font-size: clamp(2.5rem, 4vw, 4.5rem);
      line-height: 0.95;
      text-transform: uppercase;
      color: var(--primary);
      text-wrap: nowrap;
    }
    .question-story__prompt-copy p,
    .question-story__followup-copy p {
      margin: 0;
      max-width: 460px;
      font-family: Inconsolata, monospace;
      font-size: 18px;
      line-height: 1.45;
      color: var(--text-soft);
    }
    .question-story__followup-copy span {
      display: inline-flex;
      width: fit-content;
      padding: 8px 18px;
      border-radius: 999px;
      background: rgba(98, 4, 4, 0.08);
      font-family: Inconsolata, monospace;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text);
    }
    .question-story__followup-bg {
      position: absolute;
      left: -4vw;
      bottom: -8px;
      width: min(540px, 40vw);
      height: auto;
      opacity: 0.28;
      pointer-events: none;
      filter: saturate(.9);
      transform: translate3d(0, 0, 0) scale(1.02);
      transform-origin: bottom left;
    }
    .question-story__voices {
      position: relative;
      z-index: 2;
      display: flex;
      justify-content: center;
      align-items: end;
      min-height: 100%;
      padding: 0 0 56px;
      transform: none;
      opacity: 1;
    }
    .question-story__voices .row {
      display: flex;
      gap: 0;
      align-items: flex-end;
      justify-content: center;
      transform: translateY(0);
    }
    .question-story__voices .row img {
      width: clamp(96px, 8vw, 122px);
      height: clamp(96px, 8vw, 122px);
      object-fit: contain;
      margin-right: -10px;
      filter: drop-shadow(0 8px 18px rgba(0,0,0,.14));
      transform-origin: center bottom;
    }
    .closing {
      padding: 71px 200px 43px;
      background: rgba(249,244,241,.65);
    }
    .closing .wrap {
      display: grid;
      gap: 71px;
      width: min(1216px, 100%);
      margin: 0 auto;
    }
    .gallery {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 20px;
      width: 100%;
    }
    .gallery img, .closing .col img {
      width: 100%;
      height: auto;
      border-radius: 8px;
      box-shadow: 0 6.5px 9.8px 4.9px rgba(0,0,0,.15), 0 3.3px 3.3px rgba(0,0,0,.3);
    }
    .closing .grid {
      display: grid;
      grid-template-columns: 1.2fr 1.6fr .8fr .9fr;
      gap: 56px;
      align-items: start;
      background: white;
      border-radius: 20px;
      padding: 50px 56px;
      box-shadow: 0 4px 2px rgba(0,0,0,.25);
    }
    .col h3 {
      margin: 0 0 25px;
      font-family: "Playfair Display", serif;
      font-size: 24px;
      text-transform: uppercase;
    }
    .col ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 11px;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: 4.32px;
    }
    .social {
      display: grid;
      gap: 11px;
    }
    .social a {
      display: flex;
      align-items: center;
      gap: 11px;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      letter-spacing: 4.32px;
    }
    .social img { width: 24px; height: 24px; }
    @media (max-width: 1200px) {
      .hero { padding: 0 40px 0 120px; grid-template-columns: 1fr 1fr; }
      .menu { padding: 0 1rem; }
      .closing { padding-left: 1rem; padding-right: 1rem; }
      .connect { padding: 0 1rem; }
      .connect .content { width: min(100%, 1120px); }
    }
    @media (max-width: 900px) {
      .menu {
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }
      .menu .panel { flex-wrap: wrap; justify-content: center; }
      .hero {
        min-height: auto;
        width: 100%;
        padding: 48px 1rem 32px;
        grid-template-columns: 1fr;
        row-gap: 24px;
      }
      .hero-copy {
        align-items: flex-start;
        min-height: auto;
        --enter-x: -28px;
        --enter-y: 0px;
      }
      .hero-slider {
        min-height: 0;
        --enter-x: 28px;
        --enter-y: 0px;
        justify-self: start;
      }
      .hero-slide,
      .hero-slide.is-active {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: none;
        opacity: 1;
        pointer-events: auto;
      }
      .scroll-hint {
        right: 1rem;
        bottom: 1rem;
      }
      .connect .content,
      .cards,
      .closing .grid,
      .gallery {
        grid-template-columns: 1fr;
        width: 100%;
      }
      .connect {
        position: relative;
        min-height: auto;
        padding: 3rem 1rem;
      }
      .connect .content {
        position: relative;
        top: auto;
        height: auto;
        min-height: 0;
      }
      .connect .bubble {
        position: relative;
        inset: auto;
        width: 100%;
        min-height: 210px;
      }
      .connect .bubble.green {
        top: auto;
        aspect-ratio: 589 / 370;
        min-height: 0;
      }
      .bubble--quote .bubble-quote {
        padding: 0 2.2rem 2.9rem;
        transform: rotate(0deg);
      }
      .bubble--quote .bubble-text {
        max-width: 72%;
        font-size: 20px;
        line-height: 1.18;
      }
      .bubble--quote .bubble-mark {
        font-size: 3.7rem;
      }
      .bubble--quote .bubble-mark--open {
        top: 1.9rem;
        left: 2rem;
      }
      .bubble--quote .bubble-mark--close {
        right: 2.5rem;
        bottom: 2rem;
      }
      .voice-card {
        position: relative;
        left: auto;
        top: auto;
        width: 100%;
        grid-template-columns: 1fr;
        transform: none;
      }
      .voice-card .photo {
        margin-right: 0;
        border-radius: 24px 24px 0 0;
      }
      .voices h2,
      .closing h2 {
        font-size: 30px;
      }
      .question-story {
        background: var(--paper);
      }
      .question-story__prompt-float {
        width: 1380px;
        left: -1220px;
      }
      .question-story__viewport,
      .question-story__track {
        height: auto;
      }
      .question-story__track {
        width: 100%;
        display: grid;
      }
      .question-story__panel {
        width: 100%;
        height: auto;
        min-height: auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 3rem 1rem;
      }
      .question-story__panel--followup {
        background: #f7efe6;
        padding-top: 2rem;
      }
      .question-story__followup-bg {
        position: relative;
        left: auto;
        bottom: auto;
        width: min(260px, 65vw);
        margin: 0 auto;
        opacity: 1;
      }
      .question-story__prompt-copy,
      .question-story__followup-copy {
        max-width: none;
        text-align: center;
        align-items: center;
        transform: none;
        opacity: 1;
      }
      .question-story__prompt-copy h2,
      .question-story__followup-copy h2 {
        font-size: clamp(2rem, 9vw, 3rem);
      }
      .question-story__prompt-copy p,
      .question-story__followup-copy p {
        font-size: 16px;
      }
      .question-story__voices {
        min-height: auto;
        padding-bottom: 0;
        transform: none;
        opacity: 1;
      }
      .question-story__voices .row {
        flex-wrap: wrap;
      }
      .question-story__voices .row img {
        width: 86px;
        height: 86px;
        transform: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .menu {
        opacity: 1;
        transform: none;
      }
      .bg-shape {
        opacity: 1;
        transform: none;
      }
      .hero-copy,
      .hero-slider {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
      .question-story__followup-copy,
      .question-story__voices,
      .question-story__followup-bg,
      .question-story__voices .row img {
        opacity: 1;
        transform: none;
      }
    }
    html.lenis,
    html.lenis body {
      height: auto;
    }
    .lenis.lenis-smooth {
      scroll-behavior: auto !important;
    }
    .lenis.lenis-stopped {
      overflow: clip;
    }
  </style>
</head>
