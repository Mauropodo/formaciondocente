---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCarousel from '../components/BlogCarousel.astro';
import { posts } from '../lib/posts';
---

<BaseLayout title="Inicio">
  <!-- LAYER 1: Fixed background -->
  <div class="parallax-bg" aria-hidden="true"></div>

  <!-- LAYER 2: Trayrecytoria (slow parallax) -->
  <div class="trayrecytoria" id="trayrecytoria" aria-hidden="true">
    <img src="/assets/img/home/trayrecytoria.svg" alt="" class="tray-svg" />
  </div>

  <!-- LAYER 3: Content -->
  <main class="main-content" id="main-content">

    <!-- ====== HERO ====== -->
    <section class="hero" id="s-hero">
      <div class="container text-center">
        <p class="hero-sup reveal" data-delay="0">Susurros del aula</p>
        <h1 class="reveal" data-delay="0.05">
          Historias que nos encuentran<br />
          <strong>Las voces que me habitan</strong>
        </h1>
        <div class="hero-scroll reveal" data-delay="0.15">
          <span>Descubre</span>
          <svg width="16" height="24" viewBox="0 0 16 24"><path d="M8 0v20M1 13l7 7 7-7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </section>

    <!-- ====== CITAS 2x2 ====== -->
    <section class="section section-alt" id="s-citas">
      <div class="container">
        <div class="citas-grid">
          <blockquote class="cita-card reveal" data-delay="0">
            <p>"Descubrí que ser educadora no significa tener todas las respuestas, sino desarrollar la capacidad de sostenerse incluso cuando aparece la frustración"</p>
          </blockquote>
          <blockquote class="cita-card reveal" data-delay="0.1">
            <p>"Hoy entiendo que dudar de una misma no es señal de debilidad, a veces es parte necesaria del proceso de convertirse en una docente más sensible frente al aula"</p>
          </blockquote>
          <blockquote class="cita-card reveal" data-delay="0.05">
            <p>"Enseñar también confronta nuestras propias emociones, límites y experiencias. Y en ese camino vas definiendo tu quehacer docente"</p>
          </blockquote>
          <blockquote class="cita-card reveal" data-delay="0.15">
            <p>"Aprendí que mi identidad profesional no se construye desde la perfección, sino desde la capacidad de reflexionar sobre mis experiencias y seguir aprendiendo incluso en medio de la incertidumbre"</p>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ====== VOCES DOCENTES ====== -->
    <section class="section" id="s-voces">
      <div class="container">
        <h2 class="section-title text-center reveal" data-delay="0">Voces docentes</h2>
        <div class="voces-grid">
          <div class="voces-row">
            <article class="voz-card reveal" data-delay="0">
              <h3>Las grietas de la vocación...</h3>
              <p>Durante mi práctica hubo momentos en los que sentí que la imagen que tenía de mí como futura educadora comenzó a derrumbarse...</p>
            </article>
            <article class="voz-card reveal" data-delay="0.1">
              <h3>Sostener sin soltarse a una misma...</h3>
              <p>La educación no termina al finalizar la jornada, porque las experiencias permanecen emocionalmente...</p>
            </article>
          </div>
          <article class="voz-card center reveal" data-delay="0.2">
            <h3>Máscaras que se caen...</h3>
            <p>Entendí que educar implica aceptar que no siempre podremos resolver todo de inmediato...</p>
          </article>
        </div>
        <div class="section-cta reveal" data-delay="0.25">
          <a href="/voces" class="btn btn-primary btn-lg">Ver más</a>
        </div>
      </div>
    </section>

    <!-- ====== ¿Y QUÉ PIENSAS TÚ? ====== -->
    <section class="section section-alt" id="s-piensas">
      <div class="container piensas-inner">
        <div class="piensas-content">
          <h2 class="reveal" data-delay="0">¿Y QUÉ PIENSAS TÚ?</h2>
          <p class="reveal" data-delay="0.1">Porque construir nuestra identidad docente también implica escucharnos, atrévete a compartir tu voz y aquello que el aula dejó en ti.</p>
          <a href="/contacto" class="btn btn-primary btn-lg reveal" data-delay="0.2">Saber más</a>
        </div>
        <div class="piensas-card reveal" data-delay="0.25" aria-hidden="true">
          <p>¿Qué has descubierto de ti misma/o al enseñar?</p>
        </div>
      </div>
    </section>

    <!-- ====== OBJETIVO GENERAL ====== -->
    <section class="section" id="s-objetivo">
      <div class="container objetivo-inner">
        <h2 class="section-title">OBJETIVO GENERAL GIT</h2>
        <p>Analizar los procesos de construcción de identidad profesional docente en estudiantes de Pedagogía en Educación Parvularia durante sus prácticas intermedia y final, con perfiles institucionales diversos.</p>
        <a href="/quienes-somos" class="btn btn-primary btn-lg">Saber más</a>
      </div>
    </section>

    <!-- ====== BLOG ====== -->
    <section class="section section-alt" id="s-blog">
      <div class="container">
        <span class="blog-label">Blog</span>
        <h2 class="section-title">Últimos relatos</h2>
        <p class="section-subtitle">Historias, investigaciones y guías sobre el desarrollo infantil</p>
        <BlogCarousel posts={posts.slice(0, 4)} />
        <div class="section-cta">
          <a href="/publicaciones" class="btn btn-outline btn-lg">Ver todos los artículos →</a>
        </div>
      </div>
    </section>

    <!-- ====== CHARLEMOS ====== -->
    <section class="charlemos" id="s-charlemos">
      <div class="container charlemos-inner">
        <div class="charlemos-text">
          <h2 class="section-title">Charlemos y compartamos también a través de...</h2>
          <div class="charlemos-links">
            <a href="#">
              <img src="/assets/img/home/linkedin.svg" alt="" /> LINKEDIN
            </a>
            <a href="#">
              <img src="/assets/img/home/instagram.svg" alt="" /> INSTAGRAM
            </a>
          </div>
          <a href="/contacto" class="btn btn-primary btn-lg">O contáctanos</a>
        </div>
        <div class="charlemos-grid">
          <div class="charlemos-img"></div>
          <div class="charlemos-img"></div>
          <div class="charlemos-img"></div>
          <div class="charlemos-img"></div>
          <div class="charlemos-img"></div>
          <div class="charlemos-img"></div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Layer 2: Trayrecytoria slow parallax
  const tray = document.getElementById("trayrecytoria");
  if (tray) {
    gsap.to(tray, {
      y: window.innerWidth >= 768 ? () => -(tray.offsetHeight - window.innerHeight) * 0.33 : 0,
      ease: "none",
      scrollTrigger: {
        trigger: "#main-content",
        start: "top top",
        end: "bottom bottom",
        scrub: 0.3,
      },
    });
  }

  // Layer 3: Scroll reveals
  mm.add("(min-width: 768px)", () => {
    gsap.utils.toArray(".reveal").forEach((el) => {
      const delay = parseFloat(el.dataset.delay) || 0;
      gsap.from(el, {
        opacity: 0,
        y: 50,
        duration: 0.9,
        ease: "power3.out",
        delay,
        scrollTrigger: { trigger: el, start: "top 88%", once: true },
      });
    });
  });

  mm.add("(max-width: 767px)", () => {
    gsap.utils.toArray(".reveal").forEach((el) => {
      const delay = parseFloat(el.dataset.delay) || 0;
      gsap.from(el, {
        opacity: 0,
        y: 30,
        duration: 0.6,
        ease: "power2.out",
        delay,
        scrollTrigger: { trigger: el, start: "top 92%", once: true },
      });
    });
  });

</script>

<style>
  /* === LAYER 1: FIXED BACKGROUND === */
  .parallax-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: var(--color-bg);
    pointer-events: none;
  }

  /* === LAYER 2: TRAYRECYTORIA === */
  .trayrecytoria {
    position: fixed;
    top: 0;
    left: 180px;
    z-index: 0;
    width: 1026px;
    height: 100vh;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.15;
  }
  .tray-svg {
    width: 100%;
    height: 5130px;
    display: block;
    will-change: transform;
  }
  @media (max-width: 1400px) {
    .trayrecytoria { display: none; }
  }

  /* === LAYER 3: MAIN CONTENT === */
  .main-content {
    position: relative;
    z-index: 1;
  }

  /* === SECTION TITLE === */
  .section-title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 700;
    margin: 0;
    color: var(--color-primary);
  }
  .section-subtitle {
    max-width: 600px;
    margin: 0 auto var(--gap-lg);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  /* === HERO === */
  .hero {
    padding: 180px 0 var(--gap-xl);
    min-height: 617px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-sup {
    font-family: var(--font-heading);
    font-size: var(--text-5xl);
    text-transform: uppercase;
    margin: 0 0 var(--gap-md);
    font-weight: 700;
    color: var(--color-text);
  }
  .hero h1 {
    font-size: var(--text-2xl);
    font-weight: 400;
    margin: 0;
    line-height: 1.3;
    color: var(--color-text-secondary);
  }
  .hero h1 strong {
    font-weight: 600;
    color: var(--color-text);
  }
  .hero-scroll {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--gap-xl);
  }
  .hero-scroll svg {
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  /* === CITAS 2x2 === */
  .citas-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-lg);
    max-width: 1167px;
    margin: 0 auto;
  }
  .cita-card {
    margin: 0;
    padding: 24px;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: var(--transition);
  }
  .cita-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-tertiary-200);
  }
  .cita-card p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text);
  }

  /* === VOCES DOCENTES === */
  .voces-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-lg);
    margin-top: var(--gap-lg);
  }
  .voces-row {
    display: flex;
    gap: var(--gap-lg);
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }
  .voz-card {
    background: var(--color-bg);
    padding: var(--gap-lg);
    width: 480px;
    max-width: 100%;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow);
    transition: var(--transition);
  }
  .voz-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--color-tertiary-200);
  }
  .voz-card h3 {
    margin: 0;
    font-size: var(--text-xl);
    color: var(--color-primary);
    font-weight: 600;
  }
  .voz-card p {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .voz-card.center {
    width: 540px;
  }
  .section-cta {
    text-align: center;
    margin-top: var(--gap-lg);
  }

  /* === ¿Y QUÉ PIENSAS TÚ? === */
  .piensas-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
  }
  .piensas-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-lg);
    max-width: 800px;
    text-align: center;
  }
  .piensas-content h2 {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin: 0;
    color: var(--color-primary);
  }
  .piensas-content p {
    max-width: 600px;
    font-size: var(--text-lg);
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-secondary);
  }
  .piensas-card {
    background: var(--color-bg);
    padding: var(--gap-lg);
    width: 100%;
    max-width: 680px;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }
  .piensas-card p {
    font-size: var(--text-2xl);
    font-weight: 600;
    text-align: center;
    max-width: 540px;
    color: var(--color-primary);
    margin: 0;
  }

  /* === OBJETIVO GENERAL === */
  .objetivo-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--gap-lg);
    text-align: right;
  }
  .objetivo-inner p {
    max-width: 600px;
    font-size: var(--text-lg);
    line-height: 1.6;
    margin: 0;
    color: var(--color-text-secondary);
  }

  /* === BLOG === */
  .blog-label {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    margin-bottom: var(--gap-sm);
  }

  /* === CHARLEMOS === */
  .charlemos {
    background: var(--color-primary);
    padding: var(--gap-xl) 0;
  }
  .charlemos-inner {
    display: flex;
    gap: var(--gap-xl);
    align-items: center;
  }
  .charlemos-text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    align-items: flex-start;
    flex: 1;
  }
  .charlemos .section-title {
    color: var(--color-text-inverse);
    text-align: left;
    max-width: 700px;
    margin: 0;
  }
  .charlemos-links {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }
  .charlemos-links a {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    color: var(--color-text-inverse);
    text-decoration: none;
    font-size: var(--text-lg);
    font-weight: 500;
  }
  .charlemos-links a:hover { opacity: 0.8; color: var(--color-text-inverse); }
  .charlemos-links img { width: 24px; height: 24px; }
  .charlemos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-lg);
    flex-shrink: 0;
  }
  .charlemos-img {
    width: 180px;
    height: 180px;
    background: var(--color-tertiary-100);
    border-radius: var(--radius-lg);
    opacity: 0.4;
  }

  /* UTILITIES */
  .text-center { text-align: center; }
  .btn-lg {
    padding: 16px 48px;
    font-size: var(--text-lg);
  }

  /* === RESPONSIVE === */
  @media (max-width: 1024px) {
    .charlemos-inner { flex-direction: column; text-align: center; }
    .charlemos-text { align-items: center; }
    .charlemos .section-title { text-align: center; }
    .objetivo-inner { align-items: center; text-align: center; }
  }
  @media (max-width: 768px) {
    .hero { padding-top: 120px; }
    .hero-sup { font-size: var(--text-3xl); }
    .hero h1 { font-size: var(--text-xl); }
    .citas-grid { grid-template-columns: 1fr; gap: var(--gap-md); }
    .voz-card { width: 100%; }
    .voz-card.center { width: 100%; }
    .voces-row { flex-direction: column; align-items: center; }
    .charlemos-grid { grid-template-columns: repeat(2, 1fr); }
    .charlemos-img { width: 100%; height: auto; aspect-ratio: 1; }
    .piensas-card p { font-size: var(--text-xl); }
  }
  @media (max-width: 480px) {
    .charlemos-grid { grid-template-columns: 1fr; }
    .charlemos-img { max-width: 180px; margin: 0 auto; }
  }
</style>
