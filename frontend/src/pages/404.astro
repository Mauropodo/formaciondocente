---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no existe dentro del sitio Identidad Profesional Docente."
  canonical="/404/"
  noindex={true}
>
  <section class="not-found">
    <div class="container text-center">
      <h1>404</h1>
      <p class="text-lg">Página no encontrada</p>
      <p>La página que buscas no existe o fue movida.</p>
      <a href="/" class="btn btn-primary">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .not-found h1 { font-size: 6rem; color: var(--color-primary); }
  .text-center { text-align: center; }
  .text-lg { font-size: 1.5rem; margin-bottom: var(--gap-md); }
</style>
