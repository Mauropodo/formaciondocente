---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Madam Speaker">
  <div class="page-bg" aria-hidden="true"></div>

  <main class="main">

    <!-- ====== HERO ====== -->
    <section class="hero" id="s-hero">
      <div class="hero-cont">
        <div class="hero-intro">
          <span>Let&rsquo;s face the facts</span>
          <div class="hero-logo-small">
            <svg viewBox="0 0 100 59.5" xmlns="http://www.w3.org/2000/svg">
              <path d="M8.9 59.5C4 59.5 0 55.5 0 50.6V8.9C0 4 4 0 8.9 0h82.2c4.9 0 8.9 4 8.9 8.9v41.7c0 4.9-4 8.9-8.9 8.9H8.9Z" fill="none"/>
              <text x="50" y="38" text-anchor="middle" font-family="serif" font-size="28" font-weight="bold" fill="#000">MS</text>
            </svg>
          </div>
        </div>
        <div class="hero-main">
          <div class="hero-main-bg"></div>
          <div class="hero-quote quote-1">
            <svg viewBox="0 0 142 120" xmlns="http://www.w3.org/2000/svg">
              <text x="10" y="100" font-size="140" font-weight="bold" font-family="Georgia,serif" fill="#000" opacity="0.15">&ldquo;</text>
            </svg>
          </div>
          <div class="hero-quote quote-2">
            <svg viewBox="0 0 142 120" xmlns="http://www.w3.org/2000/svg">
              <text x="10" y="100" font-size="140" font-weight="bold" font-family="Georgia,serif" fill="#000" opacity="0.15">&rdquo;</text>
            </svg>
          </div>
          <h1 class="hero-title">
            <span>Let&rsquo;s face</span>
            <span>the facts</span>
          </h1>
          <div class="hero-lottie-placeholder"></div>
        </div>
        <div class="hero-footnote">
          Madam Speaker <small>est. 2024</small>
        </div>
      </div>
    </section>

    <!-- ====== BIG HAND ====== -->
    <section class="bighand" id="s-bighand">
      <div class="bighand-cont">
        <div class="bighand-title">
          <span class="serif">It&rsquo;s time we changed this</span>
          <h3 class="serif">&ldquo;Deep?&rdquo; &ldquo;Self assured?&rdquo; &ldquo;Masculine?&rdquo;</h3>
        </div>
        <div class="bighand-hand">
          <svg viewBox="0 0 400 700" xmlns="http://www.w3.org/2000/svg">
            <path d="M200 0 C250 100 300 200 350 350 C380 450 380 550 350 650 C320 700 250 700 200 700 C150 700 80 700 50 650 C20 550 20 450 50 350 C100 200 150 100 200 0Z" fill="#fff" opacity="0.1"/>
            <text x="200" y="350" text-anchor="middle" font-family="Georgia,serif" font-size="60" fill="#fff" opacity="0.3">&ldquo;</text>
          </svg>
        </div>
        <div class="bighand-stamp">
          <span>VOICES MATTER</span>
        </div>
      </div>
    </section>

    <!-- ====== BANNERS ====== -->
    <section class="banners" id="s-banners">
      <div class="banners-cont">
        <div class="banners-card">
          <h3>Let&rsquo;s set the<br />(public) record straight.</h3>
        </div>
        <div class="banners-rows">
          <div class="banner-row row-1">
            <span>We grow up mainly hearing male voices</span>
            <span>Power = Masculinity</span>
            <span>Women have always spoken out</span>
          </div>
          <div class="banner-row row-2">
            <span>Their voices have not been amplified</span>
            <span>We can change this</span>
            <span>Madam Speaker is a digital archive</span>
          </div>
          <div class="banner-row row-3">
            <span>Notable speeches made by women</span>
            <span>Preserve &amp; celebrate</span>
            <span>Diverse perspectives</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== CARDS ====== -->
    <section class="cards-section" id="s-cards">
      <div class="cards-sticky">
        <div class="cards-stack">
          <div class="card-item card-1">
            <h2>We grow up mainly hearing male voices</h2>
          </div>
          <div class="card-item card-2">
            <h2>We associate power with masculinity</h2>
          </div>
          <div class="card-item card-3">
            <h2>Women have always spoken out</h2>
          </div>
          <div class="card-item card-4">
            <h2>Their voices deserve to be amplified</h2>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== FOLDERS / WOMEN SPEAKING ====== -->
    <section class="folders" id="s-folders">
      <div class="folders-cont">
        <h2>Women speaking about:</h2>
        <div class="folders-grid">
          <div class="folder-item">Leadership</div>
          <div class="folder-item">Climate</div>
          <div class="folder-item">Equality</div>
          <div class="folder-item">Education</div>
          <div class="folder-item">Health</div>
          <div class="folder-item">Rights</div>
          <div class="folder-item">Science</div>
          <div class="folder-item">Arts</div>
          <div class="folder-item">Politics</div>
          <div class="folder-item">Sport</div>
        </div>
      </div>
    </section>

    <!-- ====== SUBSCRIBE ====== -->
    <section class="subscribe" id="s-subscribe">
      <div class="subscribe-scrollbtn">
        <span>Are you ready?</span>
        <svg width="14" height="24" viewBox="0 0 14 24"><path d="M7 0v20M1 14l6 6 6-6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="subscribe-cont">
        <div class="subscribe-card">
          <h3>Let&rsquo;s reshape the idea<br />of leadership and authority.</h3>
        </div>
        <div class="subscribe-form">
          <h5 class="serif">Subscribe for updates</h5>
          <form>
            <input type="text" placeholder="Name" name="name" />
            <input type="email" placeholder="Email address" name="email" />
            <button type="submit">Subscribe</button>
          </form>
        </div>
    </div>
  </section>

</main>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  // Hero parallax
  const hero = document.getElementById("s-hero");
  if (hero) {
    gsap.to(".hero-quote.quote-1", {
      y: 80, rotate: -15,
      ease: "none",
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.5 },
    });
    gsap.to(".hero-quote.quote-2", {
      y: -80, rotate: 10,
      ease: "none",
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.5 },
    });
    gsap.to(".hero-title", {
      scale: 0.9, y: 60, opacity: 0.5,
      ease: "none",
      scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.4 },
    });
  }

  // BigHand stickies
  const bh = document.getElementById("s-bighand");
  if (bh) {
    gsap.from(".bighand-stamp", {
      y: 200, opacity: 0, rotate: 10,
      scrollTrigger: { trigger: bh, start: "top 60%", end: "center center", scrub: 0.5 },
    });
  }

  mm.add("(min-width: 768px)", () => {
    // Banners card reveal
    gsap.from(".banners-card", {
      opacity: 0, scale: 0.9,
      scrollTrigger: { trigger: "#s-banners", start: "top 40%", end: "top 20%", scrub: 0.5 },
    });
    gsap.utils.toArray(".banner-row").forEach((row, i) => {
      gsap.from(row, {
        x: i % 2 === 0 ? -200 : 200, opacity: 0,
        scrollTrigger: { trigger: "#s-banners", start: "top 30%", end: "bottom 60%", scrub: 0.4 },
      });
    });

    // Cards stack reveal
    gsap.utils.toArray(".card-item").forEach((card, i) => {
      gsap.from(card, {
        y: 200 + i * 50, rotate: i * 5, opacity: 0, scale: 0.95,
        scrollTrigger: { trigger: card, start: "top 90%", end: "top 40%", scrub: 0.6 },
      });
    });

    // Folders stagger
    gsap.utils.toArray(".folder-item").forEach((item, i) => {
      gsap.from(item, {
        opacity: 0, y: 30, scale: 0.9,
        duration: 0.5, delay: i * 0.05,
        scrollTrigger: { trigger: "#s-folders", start: "top 70%", once: true },
      });
    });

    // Subscribe card
    gsap.from(".subscribe-card", {
      opacity: 0, y: 60,
      scrollTrigger: { trigger: "#s-subscribe", start: "top 70%", once: true },
    });
    gsap.from(".subscribe-form form", {
      opacity: 0, y: 40,
      scrollTrigger: { trigger: "#s-subscribe", start: "top 60%", once: true },
    });
  });

  mm.add("(max-width: 767px)", () => {
    gsap.utils.toArray("[class*=reveal]").forEach((el) => {
      gsap.from(el, { opacity: 0, y: 20, duration: 0.5, scrollTrigger: { trigger: el, start: "top 90%", once: true } });
    });
  });

  // Navbar
  const navbar = document.getElementById("navbar");
  if (navbar) {
    ScrollTrigger.create({
      start: "top -80px",
      onUpdate: (self) => {
        navbar.style.background = self.progress > 0 ? "rgba(14,14,14,0.95)" : "transparent";
        navbar.style.backdropFilter = self.progress > 0 ? "blur(10px)" : "none";
      },
    });
  }
</script>

<style>
  :root {
    --chanterelle: #9d7a3c;
    --chanterelle-light: #baa277;
    --tomato: #ff5f3b;
    --blueberry: #5f00f6;
    --peach: #fac0f9;
    --lavender: #c3a0f8;
    --black: #0e0e0e;
    --brown-tint: #f3ecfe;
    --border-radius-small: 5px;
    --border-radius-medium: 10px;
    --border-radius-large: 30px;
  }

  .page-bg {
    position: fixed; inset: 0; z-index: 0;
    background: var(--black); pointer-events: none;
  }
  .main { position: relative; z-index: 1; }
  .serif { font-family: Georgia, 'Times New Roman', serif; }

  html, body { scroll-behavior: smooth; }

  /* ====== HERO ====== */
  .hero {
    min-height: 100vh; background: var(--lavender);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .hero-cont { width: 100%; position: relative; }
  .hero-intro {
    position: absolute; top: 40px; left: 50px; right: 50px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: Georgia, serif; font-size: 17px; color: var(--black);
  }
  .hero-logo-small svg { width: 60px; height: auto; }
  .hero-main {
    position: relative; display: flex; justify-content: center; align-items: center;
    padding: 30px; margin: 100px 30px 0;
    background: var(--brown-tint); border-radius: var(--border-radius-large) var(--border-radius-large) 0 0;
    min-height: 70vh;
  }
  .hero-main-bg {
    position: absolute; bottom: 0; left: 50px; right: 50px;
    height: calc(100% - 100px);
    background: linear-gradient(to bottom, var(--black), var(--brown-tint) 1px, var(--brown-tint) 20px);
    background-size: 100% 80px;
  }
  .hero-title {
    position: relative; z-index: 2;
    text-align: center; rotate: -4deg;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 70; line-height: 1.1;
  }
  .hero-title span { display: block; }
  .hero-quote {
    position: absolute; z-index: 1;
    width: 100px; rotate: -5deg;
  }
  .hero-quote svg { width: 100%; height: auto; }
  .quote-1 { top: 18%; left: 5%; }
  .quote-2 { bottom: 18%; right: 2%; rotate: 172deg; }
  .hero-lottie-placeholder { display: none; }
  .hero-footnote {
    position: absolute; bottom: 20px; right: 50px;
    font-size: 17px; font-weight: 50; color: var(--black);
  }
  .hero-footnote small { font-size: 12px; }

  /* ====== BIG HAND ====== */
  .bighand {
    min-height: 100vh; background: var(--tomato);
    position: relative; overflow: hidden;
  }
  .bighand-cont {
    display: grid; grid-template-columns: 1fr 1fr;
    align-items: center; height: 100vh; padding: 80px 40px;
    position: sticky; top: 0;
  }
  .bighand-title { font-family: Georgia, serif; display: flex; flex-direction: column; gap: 30px; }
  .bighand-title span { font-size: 32px; }
  .bighand-title h3 { font-size: clamp(1.8rem, 4vw, 2.8rem); max-width: 480px; color: #000; margin: 0; }
  .bighand-hand { display: flex; justify-content: center; }
  .bighand-hand svg { height: 80vh; width: auto; }
  .bighand-stamp {
    position: absolute; bottom: 80px; right: 60px;
    background: #fff; border: 2px solid #000; border-radius: var(--border-radius-small);
    padding: 10px 20px; text-transform: uppercase; rotate: 4deg;
    font-weight: bold; font-size: 14px;
  }

  /* ====== BANNERS ====== */
  .banners {
    min-height: 100vh; background: var(--black); color: #fff;
    display: flex; justify-content: center; align-items: center;
    position: relative;
  }
  .banners-cont {
    text-align: center; width: 100%; max-width: 800px;
    position: sticky; top: 50%; transform: translateY(-50%);
  }
  .banners-card {
    background: #fff; color: var(--black);
    border-radius: var(--border-radius-medium);
    padding: 30px; text-transform: uppercase;
    display: inline-block;
  }
  .banners-card h3 { font-size: clamp(1.5rem, 3.5vw, 2.5rem); margin: 0; font-weight: 600; }
  .banners-rows { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .banner-row {
    position: absolute; width: 100%; display: flex; gap: 10px;
    font-size: 20px; white-space: nowrap;
  }
  .banner-row span {
    padding: 10px 14px; border-radius: var(--border-radius-small);
    background: var(--chanterelle); color: #000;
  }
  .row-1 { top: 20%; left: 0; rotate: -2deg; }
  .row-2 { top: 50%; right: 0; rotate: 2deg; justify-content: flex-end; }
  .row-3 { bottom: 20%; left: 0; rotate: -2deg; }

  /* ====== CARDS ====== */
  .cards-section {
    min-height: 100vh; background: var(--brown-tint);
    display: flex; justify-content: center; align-items: center;
    padding: 80px 20px;
  }
  .cards-stack { display: flex; flex-direction: column; gap: 20px; max-width: 700px; width: 100%; }
  .card-item {
    padding: 40px 30px; border-radius: var(--border-radius-medium);
    text-align: center;
  }
  .card-item h2 { font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 70; margin: 0; }
  .card-1 { background: var(--peach); rotate: -2deg; }
  .card-2 { background: var(--tomato); rotate: 1deg; }
  .card-3 { background: var(--chanterelle); rotate: -1deg; }
  .card-4 { background: var(--blueberry); color: var(--peach); rotate: 2deg; }
  .card-4 h2 { font-size: clamp(2rem, 4.5vw, 3.5rem); }

  /* ====== FOLDERS ====== */
  .folders {
    min-height: 100vh; background: var(--peach);
    display: flex; justify-content: center; align-items: center;
    padding: 80px 20px;
  }
  .folders-cont { text-align: center; max-width: 1200px; width: 100%; }
  .folders-cont h2 {
    font-size: clamp(2rem, 5vw, 4rem); font-weight: 70;
    color: var(--blueberry); margin-bottom: 50px;
  }
  .folders-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 15px;
  }
  .folder-item {
    aspect-ratio: 1.5; display: flex; justify-content: center; align-items: center;
    text-transform: uppercase; text-align: center;
    background: var(--blueberry); color: #fff;
    border-radius: var(--border-radius-small);
    padding: 20px; font-size: 1rem; font-weight: 600;
    transition: 0.3s;
  }
  .folder-item:hover { transform: scale(1.05); }

  /* ====== SUBSCRIBE ====== */
  .subscribe {
    min-height: 100vh; background: var(--chanterelle);
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    padding: 80px 20px; position: relative;
  }
  .subscribe-scrollbtn {
    position: absolute; top: -50px; left: 50%; transform: translateX(-50%);
    background: var(--chanterelle); color: #000;
    border: none; padding: 18px 30px 8px; cursor: pointer;
    display: flex; align-items: center; gap: 10px;
    font-size: 1rem; border-radius: var(--border-radius-large) var(--border-radius-large) 0 0;
  }
  .subscribe-cont { text-align: center; max-width: 700px; width: 100%; }
  .subscribe-card {
    background: #fff; border-radius: var(--border-radius-large);
    padding: 30px; text-transform: uppercase;
    display: inline-block; max-width: 100%;
  }
  .subscribe-card h3 { font-size: clamp(1.5rem, 3.5vw, 2.8rem); margin: 0; font-weight: 70; }
  .subscribe-form { max-width: 600px; margin: 50px auto 0; }
  .subscribe-form h5 { font-size: 1.2rem; margin-bottom: 20px; }
  .subscribe-form form { display: flex; flex-direction: column; gap: 10px; align-items: center; }
  .subscribe-form input {
    width: 100%; padding: 20px; border: none; border-radius: var(--border-radius-small);
    font-size: 1.2rem; outline: none;
  }
  .subscribe-form input:focus { outline: 2px solid #000; }
  .subscribe-form button {
    margin-top: 20px; padding: 20px 40px;
    background: var(--black); color: #fff; border: none;
    border-radius: var(--border-radius-medium); font-size: 1.2rem; cursor: pointer;
    transition: 0.3s;
  }
  .subscribe-form button:hover { background: var(--blueberry); }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 768px) {
    .hero-intro { left: 20px; right: 20px; font-size: 14px; }
    .hero-main { margin: 100px 10px 0; padding: 15px; }
    .hero-title { font-size: 2rem; }
    .hero-quote { width: 65px; }
    .hero-footnote { right: 20px; left: 20px; font-size: 12px; }
    .bighand-cont { grid-template-columns: 1fr; padding: 40px 20px; text-align: center; }
    .bighand-hand svg { height: 40vh; }
    .bighand-stamp { bottom: 40px; right: 20px; }
    .banners-card { padding: 20px; }
    .banner-row { font-size: 14px; }
    .folder-item { font-size: 0.8rem; }
    .folders-grid { grid-template-columns: repeat(2, 1fr); }
    .subscribe-form input { font-size: 1rem; }
  }
</style>