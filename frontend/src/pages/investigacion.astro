<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title="Investigación"
      description="Investigación Fondecyt sobre cómo estudiantes de Pedagogía en Educación Parvularia construyen su identidad profesional durante sus prácticas intermedia y final."
      path="/investigacion/"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Playfair+Display:wght@400;600;700&family=Inconsolata:wght@400;900&family=Roboto:wght@400&family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      :root {
        --vw: 1vw;
        --vh: 1vh;
        --viewport-scale: 1;
        --viewport-scale-x: 1;
        --viewport-scale-y: 1;
        --is-compact-desktop: 0;
        --hero-section-padding-top: 200px;
        --temas-section-padding-top: 200px;
        --objetivos-stage-padding-top: 168px;
        --objetivos-stage-padding-bottom: 80px;
        --obj-hand-width: 150px;
        --obj-hand-height: 220px;
        --objetivos-progress-bottom: 28px;
        --qs-ornament-height: 321px;
      }
      body {
        font-family: 'Inter', sans-serif;
        background: #fff;
        overflow-x: hidden;
        color: #161616;
      }
      a { text-decoration: none; color: inherit; }
      button { cursor: pointer; border: none; outline: none; background: none; font-family: inherit; }

      /* ── Page wrapper ── */
      .page {
        position: relative;
        background: #fff;
        overflow-x: hidden;
      }

      /* Diagnostic: prevents overflow-x from creating a nested vertical scroller on desktop. */
      @media (min-width: 901px) {
        .page { overflow: clip; }
      }

      .intro-stack {
        position: relative;
        isolation: isolate;
        background: #f9f5f2;
        overflow: clip;
      }
      .intro-stack__backdrop {
        position: absolute;
        inset: 0;
        z-index: 0;
        background: #fff;
        opacity: 0.2;
        overflow: hidden;
        pointer-events: none;
      }
      .intro-stack__bg-fallback {
        position: absolute;
        inset: 0;
        z-index: 0;
        opacity: 0;
        visibility: hidden;
        overflow: hidden;
        background: #f9f4f1;
      }
      .intro-stack__bg-fallback img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center top; }
      .intro-stack.is-bg-fallback .intro-stack__bg-fallback { opacity: 1; visibility: visible; }
      .intro-stack.is-bg-fallback .intro-stack__bg-shape { opacity: 0 !important; visibility: hidden; animation: none !important; }
      .intro-stack__bg-shape {
        position: absolute;
        inset: 0;
        opacity: 0;
        transform: translate3d(-9vw, 0, 0);
        will-change: transform, opacity;
        backface-visibility: hidden;
      }
      .intro-stack__bg-shape svg {
        width: 100%;
        height: 100%;
        display: block;
        user-select: none;
        pointer-events: none;
        overflow: visible;
      }
      .intro-stack.is-bg-revealed .intro-stack__bg-shape {
        animation: heroBgLayerEnter 1.25s cubic-bezier(.2,.75,.18,1) forwards;
      }
      .intro-stack.is-bg-revealed .intro-stack__bg-shape--1 { animation-delay: 0.12s; }
      .intro-stack.is-bg-revealed .intro-stack__bg-shape--2 { animation-delay: 0.34s; }
      .intro-stack.is-bg-revealed .intro-stack__bg-shape--3 { animation-delay: 0.56s; }
      .intro-stack.is-bg-revealed .intro-stack__bg-shape--4 { animation-delay: 0.78s; }

      /* ══ Hero ══ */
      .hero {
        position: relative;
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        background: transparent;
        overflow: visible;
        padding-top: var(--hero-section-padding-top);
        padding-bottom: 60px;
      }
      @keyframes heroBgLayerEnter {
        0% {
          opacity: 0;
          transform: translate3d(-9vw, 0, 0);
        }
        100% {
          opacity: 1;
          transform: translate3d(0, 0, 0);
        }
      }
      .hero__top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: clamp(1.5rem, 3vw, 3rem);
        width: min(100%, 1200px);
        margin-inline: auto;
        padding: 0 1rem;
      }
      .hero__heading {
        flex: 0 1 900px;
        font-family: 'Open Sans', sans-serif;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        position: relative;
        z-index: 1;
      }
      .hero__eyebrow {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28.8px;
        line-height: 28px;
        color: #620404;
        text-transform: uppercase;
      }
      .hero__body {
        font-family: 'Open Sans', sans-serif;
        font-size: 20px;
        line-height: 1.5;
        text-align: justify;
        color: #000;
      }
      .hero__title {
        flex: 0 0 auto;
        margin-bottom: 60px;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: clamp(28px, 2.8vw, 44.8px);
        line-height: 1.15;
        color: #be572a;
        text-transform: uppercase;
        text-align: center;
        position: relative;
        z-index: 1;
      }
      .hero__bottom {
        position: relative;
        width: min(100%, 1200px);
        margin-inline: auto;
        padding: 0 1rem;
        margin-top: clamp(2.75rem, 6vw, 4.5rem);
      }
      .hero__bottom-inner {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: clamp(1.5rem, 4vw, 4rem);
        min-height: 26rem;
      }
      .hero__illustration {
        position: relative;
        z-index: 2;
        pointer-events: none;
        flex: 0 0 clamp(210px, 24vw, 300px);
        width: clamp(210px, 24vw, 300px);
        margin-right: clamp(-2rem, -3vw, -0.5rem);
        margin-bottom: clamp(1rem, 3vw, 2.5rem);
        transform: translateX(clamp(1rem, 2.5vw, 2.25rem));
      }
      .hero__illustration img {
        width: 100%;
        height: auto;
        object-fit: contain;
      }
      .fondecyt {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
      }
      @media (min-width: 901px) {
        .hero__bottom-inner .fondecyt {
          width: min(561px, 82vw);
        }
      }
      .fondecyt__label {
        position: relative;
        z-index: 20;
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28.8px;
        color: white;
        white-space: nowrap;
        margin-bottom: 1rem;
      }
      .fondecyt__bubbles {
        position: relative;
        width: 100%;
        height: auto;
        height: auto;
      }
      .bubble-q {
        position: absolute;
        pointer-events: none;
      }
      .bubble-q--orange {
        width: 98%; height: var(--qs-ornament-height);
        top: 0;
        right: 0;
        left: auto;
        transform: translate(33.333%, -16.333%) rotate(2deg);
        z-index: 0;
        filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
      }
      .bubble-q--copper {
        width: 100%; height: var(--qs-ornament-height);
        bottom: 0;
        left: 0;
        top: auto;
        transform: translate(-33.333%, 40.333%) rotate(175deg) scaleY(-1);
        z-index: 1;
        filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
      }

      .qs-bubble {
        position: relative;
        inset: auto;
        z-index: 3;
        isolation: isolate;
        width: 100%;
        min-height: 0;
        height: auto;
        margin: 0;
      }
      .qs-bubble .bubble-shape {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
      }
      .qs-bubble .bubble-shape svg {
        display: block;
        width: 100%;
        height: 100%;
        overflow: visible;
        filter: drop-shadow(0 4px 15.3px rgba(0,0,0,0.25));
      }
      .qs-bubble .bubble-quote {
        position: relative;
        inset: auto;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-width: 0;
        align-self: center;
        margin-inline: auto;
        box-sizing: border-box;
        padding: 3rem 4.6rem;
        background: #83BAA4;
        border-radius: 85px;
        box-shadow: 0 4px 15.3px rgba(0,0,0,0.25);
        rotate: -3deg;
      }
      .qs-bubble .bubble-text {
        margin: 0;
        max-width: 100%;
        font-family: "Open Sans", sans-serif;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.18;
        letter-spacing: 0.01em;
        text-align: justify;
        text-wrap: balance;
        overflow-wrap: normal;
        word-break: normal;
        hyphens: none;
        color: #111;
        align-self: center;
        transform: none;
      }

      /* ══ Temas Section ══ */
      .temas-section {
        position: relative;
        z-index: 10;
        min-height: 86vh;
        padding: var(--temas-section-padding-top) 0 40px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 48px;
        overflow: hidden;
        background: transparent;
      }
      .temas-info-group {
        position: relative;
        z-index: 10;
        right: auto;
        top: auto;
        align-self: flex-end;
        width: fit-content;
        margin-right: clamp(40px, 13vw, 260px);
      }
      .temas-info-card {
        position: relative;
        transform: rotate(-2deg);
        background: #3b959e;
        color: white;
        text-align: center;
        border-radius: 29px;
        padding: 20px 40px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: min(722px, 40vw);
        box-shadow: 8.8px 11.2px 6.12px rgba(0,0,0,0.23), 0px 3.2px 1.6px rgba(0,0,0,0.25), 2.4px 3.2px 0px rgba(0,0,0,0.25), -1.6px 3.2px 1.6px rgba(0,0,0,0.4);
      }
      .temas-info-card__title {
        font-family: 'Playfair Display', serif;
        font-weight: 600;
        font-size: 28.8px;
        line-height: 28px;
        text-transform: uppercase;
      }
      .temas-info-card__body {
        font-family: 'Open Sans', sans-serif;
        font-size: 20px;
        line-height: 1.4;
        max-width: 593px;
      }
      .temas-arm {
        position: absolute;
        pointer-events: none;
        right: 150px;
        top: 0;
        width: clamp(120px, 10vw, 168px);
        aspect-ratio: 217 / 439;
        height: auto;
        transform: translate(44%, -26%) rotate(-90deg);
        transform-origin: top right;
        z-index: 11;
      }
      .temas-marquee-wrap {
        position: relative;
        bottom: auto;
        left: auto;
        right: auto;
        width: 100vw;
        margin-inline: calc(-50vw + 50%);
        margin-top: 0;
        overflow: hidden;
        z-index: 3;
        background: none;
      }
      .temas-marquee {
        display: flex;
        flex-wrap: nowrap;
        align-items: stretch;
        width: max-content;
        gap: 25px;
        padding: 20px 0;
        will-change: transform;
        animation: temasScroll 140s linear infinite;
      }
      @keyframes temasScroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .marquee-tag {
        display: grid;
        grid-template-rows: 1fr 1fr;
        align-items: stretch;
        width: 260px;
        min-width: 260px;
        height: 188px;
      }
      .marquee-tag:nth-child(odd) .marquee-tag__chip {
        grid-row: 2;
      }
      .marquee-tag:nth-child(even) .marquee-tag__chip {
        grid-row: 1;
      }
      .marquee-tag__chip {
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        font-family: 'Inter', sans-serif;
        font-size: 28px;
        font-weight: 400;
        padding: 28px 32px;
        min-width: 260px;
        opacity: 1;
        transition: border .25s;
      }

      /* ══ Objetivos Section ══ */
      .objetivos-section {
        position: relative;
        min-height: 100vh;
        overflow: hidden;
        background: #be572a;
      }
      .objetivos-shell {
        position: relative;
        min-height: 100svh;
        overflow: visible;
      }
      .objetivos-track {
        display: grid;
        grid-template-areas: "stack";
        width: 100%;
        min-height: 100svh;
        will-change: transform;
      }
      .objetivos-panel {
        position: relative;
        grid-area: stack;
        width: 100%;
        min-height: 100svh;
        height: auto;
        padding: 0;
        display: grid;
        align-items: center;
        overflow: visible;
      }
      .objetivos-panel__stage {
        position: relative;
        width: 100%;
        height: 100%;
        padding: var(--objetivos-stage-padding-top) clamp(24px, 6vw, 88px) var(--objetivos-stage-padding-bottom);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .obj-frame37 {
        z-index: 1;
      }
      #objGroup0 {
        z-index: 2;
      }
      #objGroup1 {
        z-index: 3;
      }
      #objGroup2 {
        z-index: 4;
      }
      .objetivos-panel__animate {
        will-change: transform, opacity;
      }
      .obj-group {
        position: relative;
        width: 100%;
        height: 100%;
      }
      .obj-group__blob {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transform: none;
        pointer-events: none;
      }
      .obj-group__blob svg {
        width: 100%;
        height: 100%;
        display: block;
        transform: scale(1.08);
        transform-origin: center center;
      }
      .obj-group__content {
        position: relative;
        z-index: 10;
        width: 72%;
        margin-inline: auto;
        display: grid;
        grid-template-columns: minmax(0, 320px) minmax(320px, 460px);
        align-items: center;
        justify-content: space-between;
        gap: clamp(24px, 4vw, 64px);
        padding-inline: 1rem;
      }
      .obj-group__title {
        max-width: 320px;
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: clamp(2rem, 3.2vw, 3.4rem);
        text-transform: uppercase;
        line-height: 1.15;
      }
      .obj-group__card {
        justify-self: end;
        max-width: 440px;
        border-radius: 29px;
        padding: clamp(20px, 2.5vw, 28px) clamp(24px, 3vw, 38px);
        color: white;
        text-align: center;
        font-family: 'Open Sans', sans-serif;
        font-size: clamp(1rem, 1.35vw, 1.18rem);
        line-height: 1.5;
        white-space: pre-wrap;
        box-shadow: 8.8px 11.2px 6.12px rgba(0,0,0,0.23), 0px 3.2px 1.6px rgba(0,0,0,0.25), 2.4px 3.2px 0px rgba(0,0,0,0.25);
      }
      .obj-frame37,
      .obj-intro {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .obj-main-card-wrap {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: fit-content;
        max-width: min(100%, 720px);
        --hand-corner-offset: clamp(0px, 1vw, 12px);
      }
      .obj-hand {
        position: absolute;
        pointer-events: none;
        z-index: 2;
      }
      .obj-hand--left {
        left: var(--hand-corner-offset);
        top: calc(var(--hand-corner-offset) - clamp(8px, 2.5vw, 10px));
        width: var(--obj-hand-width);
        height: var(--obj-hand-height);
        transform: translate(-28%, -24%) rotate(35deg);
      }
      .obj-hand--right {
        right: calc(var(--hand-corner-offset) + clamp(16px, 5vw, 20px));
        bottom: calc(var(--hand-corner-offset) - clamp(8px, 2.5vw, 10px));
        width: var(--obj-hand-width);
        height: var(--obj-hand-height);
        transform: translate(28%, 24%) rotate(85deg);
      }
      .obj-main-card {
        background: white;
        color: #620404;
        text-align: center;
        border-radius: 29px;
        padding: clamp(24px, 3vw, 36px) clamp(28px, 4vw, 56px);
        display: flex;
        flex-direction: column;
        gap: 10px;
        transform: rotate(2deg);
        max-width: min(560px, 90%);
        box-shadow: 8.8px 11.2px 6.12px rgba(0,0,0,0.23), 0px 3.2px 1.6px rgba(0,0,0,0.25), 2.4px 3.2px 0px rgba(0,0,0,0.25), -1.6px 3.2px 1.6px rgba(0,0,0,0.4);
      }
      .obj-main-card__title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: clamp(2rem, 3.2vw, 3.4rem);
        text-transform: uppercase;
        white-space: nowrap;
      }
      .obj-main-card__body {
        font-family: 'Open Sans', sans-serif;
        font-size: clamp(1rem, 1.35vw, 1.2rem);
        line-height: 1.5;
        max-width: 479px;
      }
      .objetivos-progress {
        position: absolute;
        left: 50%;
        bottom: var(--objetivos-progress-bottom);
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 10px;
        transform: translateX(-50%);
      }
      .objetivos-progress__dot {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.35);
        transition: width .3s ease, background .3s ease, opacity .3s ease;
      }
      .objetivos-progress__dot.is-active {
        width: 38px;
        background: rgba(255,255,255,0.92);
      }

      /* ══ Referencias ══ */
      .referencias-section {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        padding: 80px 2rem;
        background: #f9f4f1;
      }
      .referencias-deco {
        position: absolute;
        pointer-events: none;
        left: 47%;
        top: 0;
        width: 50px;
        height: 100%;
      }
      .referencias-deco svg { width: 100%; height: 100%; }
      .referencias-title {
        font-family: 'Playfair Display', serif;
        font-weight: 700;
        font-size: 44.8px;
        text-transform: uppercase;
        color: #620404;
        text-align: center;
      }
      .referencias-list {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        width: 100%;
        max-width: 1050px;
      }
      .ref-card {
        border-radius: 10px;
        padding: 20px 30px;
        display: flex;
        flex-direction: column;
        gap: 15px;
        background: #95b3a7;
      }
      .ref-card__title {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 25px;
        color: #000;
      }
      .ref-card__desc {
        font-family: 'Inconsolata', monospace;
        font-size: 22px;
        color: #000;
      }
      .ref-card__link {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        text-decoration: underline;
        color: #000;
        cursor: pointer;
      }
      .pagination-section {
        width: 100%;
        max-width: 1050px;
        padding-top: 1.5rem;
      }
      .pagination-wrapper {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .pagination-info {
        margin: 0;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #4b4b4b;
      }
      .pagination-controls {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .page-btn,
      .pagination__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid rgba(10, 10, 10, 0.14);
        background: rgba(255,255,255,0.92);
        color: #0a0a0a;
        transition: border-color .15s ease, color .15s ease, background .15s ease;
      }
      .page-btn:hover:not(.disabled),
      .pagination__btn:hover:not(.pagination__btn--disabled) {
        border-color: #be572a;
        color: #be572a;
      }
      .page-btn.disabled,
      .pagination__btn--disabled {
        opacity: 0.3;
        pointer-events: none;
      }
      .page-numbers {
        display: flex;
        gap: 2px;
      }
      .page-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #0a0a0a;
        transition: background .15s ease, color .15s ease;
      }
      .page-num:hover {
        background: rgba(0,0,0,0.05);
      }
      .page-num.active {
        background: #be572a;
        color: #fff;
        font-weight: 700;
      }

      @media (prefers-reduced-motion: reduce) {
        .marquee-tag { transition: none !important; }
      }
      @media (max-width: 960px) {
        .hero__bottom-inner {
          min-height: 0;
          align-items: center;
          justify-content: center;
          flex-direction: column;
          gap: 1.5rem;
        }
        .hero__illustration {
          flex-basis: auto;
          margin-right: 0;
          margin-bottom: 0;
          transform: none;
        }
        .fondecyt {
          margin-left: 0;
        }
      }
      @media (max-width: 900px) {
        .intro-stack__backdrop {
          opacity: 0.2;
        }
        .hero__title {
          flex: 0 0 100%;
          width: 100%;
          max-width: none;
          text-align: center;
        }
        .fondecyt {
          width: 100%;
          max-width: none;
        }
        .fondecyt__bubbles {
          width: 100vw;
          max-width: 100vw;
          height: auto;
          aspect-ratio: auto;
        }
        .qs-bubble {
          width: 100%;
          max-width: 100%;
          margin-inline: auto;
          aspect-ratio: auto;
        }
        .qs-bubble .bubble-quote {
          padding: clamp(1.6rem, 6vw, 2.3rem) clamp(1.5rem, 7vw, 2.7rem) clamp(2.4rem, 9vw, 3.6rem);
        }
        .qs-bubble .bubble-text {
          max-width: 100%;
          font-size: 20px;
          line-height: 1.18;
          text-align: justify;
        }
        .temas-info-group {
          left: 0;
          right: auto;
          align-self: stretch;
          width: 100%;
          margin-right: 0;
        }
        .temas-info-card {
          width: 100vw;
          max-width: none;
        }
        .objetivos-shell {
          min-height: 100svh;
          overflow: hidden;
        }
        .objetivos-track {
          display: grid;
          grid-template-areas: "stack";
          width: 100%;
          min-height: 100svh;
        }
        .obj-frame37 {
          order: 0;
        }
        #objGroup0 {
          order: 1;
        }
        #objGroup1 {
          order: 2;
        }
        #objGroup2 {
          order: 3;
        }
        .objetivos-panel {
          width: 100%;
          min-width: 100%;
          grid-area: stack;
          height: 100svh;
          min-height: 100svh;
          padding: 0;
        }
        .objetivos-panel__stage {
          min-height: 100svh;
          padding: 128px 20px 40px;
        }
        .obj-group {
          height: 100%;
          min-height: 0;
        }
        .obj-group__blob {
          width: 100%;
          height: 100%;
          min-height: 0;
        }
        .obj-group__content {
          grid-template-columns: 1fr;
          justify-items: center;
          text-align: center;
          padding-inline: 0;
        }
        .obj-group__card {
          justify-self: center;
          max-width: 100%;
        }
        .obj-main-card {
          max-width: 100%;
        }
        .obj-main-card__title {
          white-space: normal;
        }
        .obj-hand {
          display: block;
          width: clamp(90px, 28vw, 150px);
          height: auto;
        }
        .objetivos-progress {
          display: none;
        }
        .pagination-wrapper {
          flex-direction: column;
          align-items: center;
        }
        .page-numbers {
          gap: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .objetivos-section {
          min-height: 0;
          overflow: visible;
        }
        .objetivos-shell {
          min-height: 0;
          overflow: visible;
        }
        .objetivos-track {
          display: flex;
          flex-direction: column;
          min-height: 0;
          height: auto;
          overflow: visible;
        }
        .obj-frame37 {
          order: 0;
        }
        #objGroup0 {
          order: 1;
        }
        #objGroup1 {
          order: 2;
        }
        #objGroup2 {
          order: 3;
        }
        .objetivos-panel,
        .obj-group,
        .obj-frame37 {
          grid-area: auto;
          position: relative;
          display: grid;
          width: 100%;
          min-width: 0;
          min-height: 100svh;
          height: auto;
          transform: none !important;
          opacity: 1 !important;
          visibility: visible !important;
        }
        .objetivos-panel__stage {
          min-height: 100svh;
          height: auto;
        }
        .obj-group__blob svg {
          transform: scale(1.3);
        }
        .objetivos-panel__animate {
          will-change: auto;
        }
        .objetivos-progress {
          display: none;
        }
        #objMainCard {
          transform: rotate(2deg) !important;
        }
      }

    </style>
