    <!-- ══ GSAP Animations ══ -->
    <script>
      import gsap from 'gsap';
      import ScrollTrigger from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const DESIGN_VIEWPORT = Object.freeze({ width: 1902, height: 910 });
      const DESKTOP_BREAKPOINT = 901;
      const rootStyle = document.documentElement;
      const initialDevicePixelRatio = window.devicePixelRatio;
      let viewportMode = window.innerWidth < DESKTOP_BREAKPOINT ? 'mobile' : 'desktop';
      let viewportMetrics = {
        width: window.innerWidth,
        height: window.innerHeight,
        scaleX: 1,
        scaleY: 1,
        scale: 1,
        isCompactDesktop: false,
      };
      let viewportRefreshFrame = 0;

      ScrollTrigger.config({
        autoRefreshEvents: 'visibilitychange,DOMContentLoaded,load',
        ignoreMobileResize: true,
      });

      const designPx = (value, axis = 'y') => {
        const scale = axis === 'x' ? viewportMetrics.scaleX : viewportMetrics.scaleY;
        return value * scale;
      };

      const getViewportMode = () =>
        window.innerWidth < DESKTOP_BREAKPOINT ? 'mobile' : 'desktop';

      const syncViewportMetrics = () => {
        const width = Math.max(window.innerWidth, document.documentElement.clientWidth, 1);
        const height = Math.max(window.innerHeight, document.documentElement.clientHeight, 1);
        const scaleX = width / DESIGN_VIEWPORT.width;
        const scaleY = height / DESIGN_VIEWPORT.height;
        const isCompactDesktop = width >= DESKTOP_BREAKPOINT && height < 800;

        viewportMetrics = {
          width,
          height,
          scaleX,
          scaleY,
          scale: Math.min(scaleX, scaleY),
          isCompactDesktop,
        };

        rootStyle.style.setProperty('--vw', `${(width * 0.01).toFixed(4)}px`);
        rootStyle.style.setProperty('--vh', `${(height * 0.01).toFixed(4)}px`);
        rootStyle.style.setProperty('--viewport-scale', viewportMetrics.scale.toFixed(5));
        rootStyle.style.setProperty('--viewport-scale-x', scaleX.toFixed(5));
        rootStyle.style.setProperty('--viewport-scale-y', scaleY.toFixed(5));
        rootStyle.style.setProperty('--is-compact-desktop', isCompactDesktop ? '1' : '0');
        rootStyle.style.setProperty('--qs-ornament-height', `${Math.round(designPx(321, 'y'))}px`);

        if (width >= DESKTOP_BREAKPOINT) {
          rootStyle.style.setProperty('--hero-section-padding-top', `${Math.round(designPx(200, 'y'))}px`);
          rootStyle.style.setProperty('--temas-section-padding-top', `${Math.round(designPx(200, 'y'))}px`);
          rootStyle.style.setProperty('--objetivos-stage-padding-top', `${Math.round(designPx(168, 'y'))}px`);
          rootStyle.style.setProperty('--objetivos-stage-padding-bottom', `${Math.round(designPx(80, 'y'))}px`);
          rootStyle.style.setProperty('--obj-hand-width', `${Math.round(designPx(150, 'x'))}px`);
          rootStyle.style.setProperty('--obj-hand-height', `${Math.round(designPx(220, 'y'))}px`);
          rootStyle.style.setProperty('--objetivos-progress-bottom', `${Math.round(designPx(28, 'y'))}px`);
        } else {
          rootStyle.style.removeProperty('--hero-section-padding-top');
          rootStyle.style.removeProperty('--temas-section-padding-top');
          rootStyle.style.removeProperty('--objetivos-stage-padding-top');
          rootStyle.style.removeProperty('--objetivos-stage-padding-bottom');
          rootStyle.style.removeProperty('--obj-hand-width');
          rootStyle.style.removeProperty('--obj-hand-height');
          rootStyle.style.removeProperty('--objetivos-progress-bottom');
        }
      };

      const refreshViewportAnimations = () => {
        if (viewportRefreshFrame) return;

        viewportRefreshFrame = window.requestAnimationFrame(() => {
          viewportRefreshFrame = 0;
          syncViewportMetrics();
          window.dispatchEvent(new CustomEvent('investigacion:viewportchange'));
          window.requestAnimationFrame(() => ScrollTrigger.refresh());
        });
      };

      const handleViewportResize = () => {
        const nextViewportMode = getViewportMode();

        if (
          window.devicePixelRatio !== initialDevicePixelRatio ||
          nextViewportMode !== viewportMode
        ) {
          window.location.reload();
          return;
        }

        refreshViewportAnimations();
      };

      syncViewportMetrics();
      window.addEventListener('resize', handleViewportResize, { passive: true });
      window.addEventListener('orientationchange', handleViewportResize, { passive: true });
      window.visualViewport?.addEventListener('resize', handleViewportResize, { passive: true });
      window.addEventListener('load', refreshViewportAnimations, { once: true });
      document.fonts?.ready?.then(refreshViewportAnimations);

      // ── Tags data for scroll-driven updates ────────────────────
      const TAGS = [
        { label: "Trayectorias formativas",      color: "#f0a443", rotate: 0  },
        { label: "Agencia profesional",           color: "#95b3a7", rotate: -2 },
        { label: "Identidad profesional docente", color: "#f0a443", rotate: -1 },
        { label: "Educación parvularia",          color: "#3b959e", rotate: -1 },
        { label: "Incidentes críticos",           color: "#be572a", rotate: -2 },
        { label: "Emociones y reflexividad",      color: "#204d50", rotate: 2  },
        { label: "Experiencias de práctica",      color: "#95b3a7", rotate: 2  },
        { label: "Dilemas formativos",            color: "#3b959e", rotate: 0  },
      ];

      // ── Hero — entrance animations ──────────────────────────────
      const introStack = document.getElementById('introStack');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const bgFallback = introStack?.querySelector('.intro-stack__bg-fallback');
      const bgFallbackImage = bgFallback?.querySelector('img[data-bg-fallback-src]');
      const bgSVGs = Array.from(introStack?.querySelectorAll('.intro-stack__bg-shape svg') || []);
      const activateBackgroundFallback = (reason = 'unknown') => {
        if (!introStack || !bgFallback || introStack.classList.contains('is-bg-fallback')) return;
        if (bgFallbackImage && !bgFallbackImage.getAttribute('src')) {
          bgFallbackImage.setAttribute('src', bgFallbackImage.dataset.bgFallbackSrc || '');
        }
        introStack.classList.add('is-bg-fallback');
        console.warn(`[investigacion] Fondo SVG reemplazado por WebP (${reason}).`);
      };
      const verifyBackgroundSVG = () => {
        if (prefersReducedMotion.matches || !bgSVGs.length) return;
        const svgIsRenderable = bgSVGs.every((svg) => {
          const rect = svg.getBoundingClientRect();
          try {
            const box = svg.getBBox();
            return rect.width > 1 && rect.height > 1 && box.width > 1 && box.height > 1;
          } catch { return false; }
        });
        if (!svgIsRenderable) activateBackgroundFallback('verificación de renderizado SVG');
      };

      const revealHeroBackground = () => {
        if (!introStack) return;
        if (prefersReducedMotion.matches) {
          introStack.classList.add('is-bg-revealed');
          return;
        }

        requestAnimationFrame(() => {
          setTimeout(() => {
            introStack.classList.add('is-bg-revealed');
            setTimeout(verifyBackgroundSVG, 2200);
          }, 140);
        });
      };

      if (document.readyState === 'complete') {
        revealHeroBackground();
      } else {
        window.addEventListener('load', revealHeroBackground, { once: true });
      }

      const heroTl = gsap.timeline({ delay: 0.2 });
      heroTl
        .fromTo('#heroHeading',  { opacity: 0, x: () => designPx(-60, 'x') }, { opacity: 1, x: 0, duration: 0.9, ease: 'power3.out' })
        .fromTo('#heroTitle',    { opacity: 0, x: () => designPx(60, 'x') }, { opacity: 1, x: 0, duration: 0.9, ease: 'power3.out' }, '-=0.6')
        .fromTo('#heroIllust',   { opacity: 0, scale: 0.8, x: () => designPx(-30, 'x') }, { opacity: 1, scale: 1, x: 0, duration: 0.8, ease: 'back.out(1.4)' }, '-=0.5')
        .fromTo('#heroQuote',    { opacity: 0, y: () => designPx(40, 'y'), scale: 0.95 }, { opacity: 1, y: 0, scale: 1, duration: 0.8, ease: 'back.out(1.2)' }, '-=0.5');

      // ── Temas: update active tag ────────────────────────────────
      // ── Temas: GSAP pin + scroll progress ──────────────────────
      // ── Objetivos: panel principal flotante ─────────────────────
      gsap.to('#objMainCard', { y: () => designPx(-14, 'y'), duration: 2.8, yoyo: true, repeat: -1, ease: 'sine.inOut' });

      // ── Objetivos: scroll lateral de 4 paneles ──────────────────
      const objSection = document.getElementById('objetivosSection');
      const objPanels = [
        document.querySelector('.obj-frame37'),
        document.getElementById('objGroup0'),
        document.getElementById('objGroup1'),
        document.getElementById('objGroup2'),
      ].filter(Boolean);
      const objDots = Array.from(document.querySelectorAll('[data-obj-dot]'));
      let currentObjectiveStep = -1;

      function setObjectiveStep(step, animateContent = true) {
        if (step === currentObjectiveStep) return;
        currentObjectiveStep = step;

        objDots.forEach((dot, index) => {
          dot.classList.toggle('is-active', index === step);
        });

        if (!animateContent) return;

        objPanels.forEach((panel, index) => {
          const animatedNode = panel.querySelector('.obj-group__content, .obj-main-card-wrap');
          if (!animatedNode) return;

          gsap.to(animatedNode, {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            duration: 0.35,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        });
      }

      const objMM = gsap.matchMedia();
      objMM.add(
        {
          desktop: '(min-width: 901px)',
          mobile: '(max-width: 900px)',
          reduceMotion: '(prefers-reduced-motion: reduce)',
        },
        (context) => {
          const { desktop, mobile, reduceMotion } = context.conditions;

          currentObjectiveStep = -1;
          setObjectiveStep(0);

          if (reduceMotion) {
            const reducedBlobPaths = objPanels.slice(1)
              .map((panel) => panel.querySelector('.obj-group__blob path'))
              .filter(Boolean)
              .map((path) => ({ path, d: path.getAttribute('d') }));
            const firstObjectivePath = reducedBlobPaths[0]?.d;

            if (firstObjectivePath) {
              reducedBlobPaths.slice(1).forEach(({ path }) => {
                path.setAttribute('d', firstObjectivePath);
              });
            }

            gsap.killTweensOf(objPanels);
            gsap.killTweensOf('#objMainCard');
            gsap.set(objPanels, {
              autoAlpha: 1,
              clearProps: 'transform,opacity,visibility,x,y,scale',
            });
            objPanels.forEach((panel) => {
              const animatedNode = panel.querySelector('.obj-group__content, .obj-main-card-wrap');
              if (animatedNode) {
                gsap.set(animatedNode, {
                  autoAlpha: 1,
                  clearProps: 'transform,opacity,visibility,x,y,scale',
                });
              }
            });
            return () => {
              reducedBlobPaths.forEach(({ path, d }) => {
                if (d) path.setAttribute('d', d);
              });
            };
          }

          if (!objSection || objPanels.length !== 4) {
            gsap.set(objPanels, { clearProps: 'transform,opacity,visibility' });
            return;
          }

          if (mobile) {
            const mobileBlobPaths = objPanels.slice(1)
              .map((panel) => panel.querySelector('.obj-group__blob path'))
              .filter(Boolean);

            gsap.set(mobileBlobPaths, {
              x: () => designPx(80, 'x'),
            });

            gsap.set(objPanels[0], {
              autoAlpha: 1,
              y: 0,
              scale: 1,
            });

            gsap.set(objPanels.slice(1), {
              autoAlpha: 1,
              x: -window.innerWidth,
              scale: 1,
            });

            const mobilePanelTimeline = gsap.timeline({
              scrollTrigger: {
                trigger: objSection,
                start: 'top top',
                end: () => `+=${window.innerWidth * (objPanels.length - 1)}`,
                pin: true,
                scrub: 0.9,
                anticipatePin: 1,
                invalidateOnRefresh: true,
                snap: {
                  snapTo: 1 / (objPanels.length - 1),
                  duration: { min: 0.18, max: 0.38 },
                  delay: 0.04,
                  ease: 'power1.inOut',
                },
                onUpdate: (self) => {
                  const nextStep = Math.round(self.progress * (objPanels.length - 1));
                  setObjectiveStep(nextStep, false);
                },
              },
            });

            mobilePanelTimeline.to(objPanels[0], {
              autoAlpha: 0,
              duration: 1,
              ease: 'none',
            }, 0);

            const firstSpecificContent = objPanels[1].querySelector('.obj-group__content');
            if (firstSpecificContent) {
              mobilePanelTimeline.to(firstSpecificContent, {
                autoAlpha: 0,
                duration: 1,
                ease: 'none',
              }, 1);
            }

            const secondSpecificContent = objPanels[2].querySelector('.obj-group__content');
            if (secondSpecificContent) {
              mobilePanelTimeline.to(secondSpecificContent, {
                autoAlpha: 0,
                duration: 1,
                ease: 'none',
              }, 2);
            }

            objPanels.slice(1).forEach((panel, index) => {
              mobilePanelTimeline.to(panel, {
                x: 0,
                duration: 1,
                ease: 'none',
              }, index);
            });

            ScrollTrigger.refresh();
            return;
          }

          gsap.set(objPanels[0], {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            x: 0,
          });

          gsap.set(objPanels.slice(1), {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            x: (index) => {
              if (index === 0) return -(viewportMetrics.width - designPx(400, 'x'));
              if (index === 1) return -(viewportMetrics.width - designPx(350, 'x'));
              if (index === 2) return -(viewportMetrics.width - designPx(300, 'x'));
              return -viewportMetrics.width * 1.2;
            },
          });

          const panelTimeline = gsap.timeline({
            scrollTrigger: {
              trigger: objSection,
              start: 'top top',
              end: () => `+=${Math.round(viewportMetrics.width * (objPanels.length - 1))}`,
              pin: true,
              scrub: 0.9,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              snap: {
                snapTo: 1 / (objPanels.length - 1),
                duration: { min: 0.18, max: 0.38 },
                delay: 0.04,
                ease: 'power1.inOut',
              },
              onUpdate: (self) => {
                const nextStep = Math.round(self.progress * (objPanels.length - 1));
                setObjectiveStep(nextStep);
              },
            },
          });

          objPanels.slice(1).forEach((panel) => {
            panelTimeline.to(panel, {
              x: 0,
              duration: 1,
              ease: 'none',
            });
          });

          ScrollTrigger.refresh();
        }
      );

      // ── Referencias: stagger fade-in ───────────────────────────
      let objectiveViewportRefreshQueued = false;
      window.addEventListener('investigacion:viewportchange', () => {
        if (objectiveViewportRefreshQueued) return;

        objectiveViewportRefreshQueued = true;
        window.requestAnimationFrame(() => {
          objectiveViewportRefreshQueued = false;
          gsap.matchMediaRefresh();
          ScrollTrigger.refresh();
        });
      });

      gsap.fromTo('.ref-card',
        { opacity: 0, y: 40 },
        {
          opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power2.out',
          scrollTrigger: { trigger: '#referenciasSection', start: 'top 75%' }
        }
      );

    </script>

  </body>
</html>
