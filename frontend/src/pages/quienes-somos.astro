<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>¿Quiénes Somos? | Parvularias</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inconsolata:wght@400;700;900&family=Playfair+Display:wght@400;500;600;700&family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f9f5f2;
      --bg-soft: #f4ebe6;
      --paper: #eee2d9;
      --text: #620404;
      --text-soft: #514444;
      --primary: #be572a;
      --accent: #d2892d;
      --teal: #3b959e;
      --orange: #c36438;
      --green: #8bc5ae;
      --nav-h: 161px;
      --radius: 24px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #fff;
      color: var(--text);
      font-family: Inter, sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .page {
      position: relative;
      min-height: 100vh;
      isolation: isolate;
    }

    .menu {
      --enter-y: -18px;
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 40;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 0 max(16px, calc((100vw - 1200px) / 2));
      min-height: var(--nav-h);
      pointer-events: none;
    }
    .menu .brand {
      width: 161px;
      height: 161px;
      flex: 0 0 auto;
      pointer-events: auto;
      overflow: clip;
      border-radius: 100px;
    }
    .menu .panel {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 12.8px 50.4px;
      background: #f9f5f2;
      border-radius: 0 0 12.8px 12.8px;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
      transform: translateX(-2px);
      margin-top: 0;
      min-width: min(100%, 735px);
    }
    .menu .dev-readout {
      display: none;
      align-items: center;
      gap: 10px;
      margin-left: 18px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(98, 4, 4, 0.08);
      color: var(--text);
      font-family: Inconsolata, monospace;
      font-size: 13px;
      line-height: 1;
      white-space: nowrap;
    }
    .menu .dev-readout strong {
      font-weight: 900;
      color: var(--primary);
    }
    .menu .dev-readout.is-visible {
      display: inline-flex;
    }
    .links {
      display: flex;
      align-items: center;
      gap: 25px;
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      color: #000;
      white-space: nowrap;
    }
    .links li a { transition: opacity 0.2s ease; }
    .links li a:hover { opacity: 0.7; }
    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 27px;
      border-radius: 48px;
      border: none;
      background: var(--accent);
      color: #eee2d9;
      font-family: Inconsolata, monospace;
      font-weight: 900;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
    }
    .cta:hover { color: #eee2d9; filter: brightness(0.98); }
    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
      pointer-events: auto;
      margin-left: auto;
    }
    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: #000;
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .menu.open .nav-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .menu.open .nav-toggle span:nth-child(2) {
      opacity: 0;
    }
    .menu.open .nav-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Quiénes Somos sections ── */

    .qs-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }
    .qs-bg svg {
      position: absolute;
      top: 0;
      height: 100%;
    }

    .qs-hero {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 80px 0 60px;
      background: #fff;
      overflow: clip;
    }
    .qs-hero__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--bg);
      overflow: hidden;
      pointer-events: none;
    }
    .qs-hero-bg-shape {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translate3d(-9vw, 0, 0);
      will-change: transform, opacity;
      backface-visibility: hidden;
    }
    .qs-hero-bg-shape svg {
      width: 100%;
      height: 100%;
      display: block;
      user-select: none;
      pointer-events: none;
      overflow: visible;
    }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape {
      animation: heroBgLayerEnter 1.25s cubic-bezier(.2,.75,.18,1) forwards;
    }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--1 { animation-delay: 0.12s; }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--2 { animation-delay: 0.34s; }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--3 { animation-delay: 0.56s; }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--4 { animation-delay: 0.78s; }
    @keyframes heroBgLayerEnter {
      0% {
        opacity: 0;
        transform: translate3d(-9vw, 0, 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }
    .qs-hero__content {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: center;
      gap: clamp(3rem, 10vw, 200px);
      padding: 0 clamp(2rem, 10vw, 260px);
      width: 100%;
      position: relative;
      z-index: 1;
    }
    .qs-hero__inner {
      position: relative;
      z-index: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(3rem, 6vw, 5rem);
    }
    .qs-hero__title {
      margin: 0;
      padding: 0 1.5rem;
      width: 100%;
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4.2vw, 4.2rem);
      line-height: 1.05;
      font-weight: 700;
      color: #620404;
      text-wrap: balance;
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    .fondecyt {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }
    .fondecyt__label {
      position: relative;
      z-index: 20;
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      font-size: 28.8px;
      color: white;
      white-space: nowrap;
      margin-bottom: 1rem;
    }
    .fondecyt__bubbles {
      position: relative;
      width: min(561px, 82vw);
      height: 363px;
    }
    .bubble-q {
      position: absolute;
      pointer-events: none;
    }
    .bubble-q--orange {
      width: 98%; height: 321px;
      bottom: -83px;
      left: 50%;
      transform: translateX(calc(-50% - 117px)) rotate(2deg);
      z-index: 0;
      filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
    }
    .bubble-q--copper {
      width: 100%; height: 321px;
      bottom: 86px;
      left: 50%;
      transform: translateX(calc(-50% + 161px)) rotate(175deg) scaleY(-1);
      z-index: 1;
      filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
    }

    .qs-bubble {
      position: absolute;
      inset: 0;
      z-index: 3;
      isolation: isolate;
      width: 100%;
      aspect-ratio: 589 / 370;
      min-height: 0;
    }
    .qs-bubble .bubble-shape {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .qs-bubble .bubble-shape svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      filter: drop-shadow(0 4px 15.3px rgba(0,0,0,0.25));
    }
    .qs-bubble .bubble-quote {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4.6rem 4.2rem;
    }
    .qs-bubble .bubble-text {
      margin: 0;
      max-width: 80%;
      font-family: Inconsolata, monospace;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-align: center;
      text-wrap: balance;
      color: #111;
      align-self: center;
      transform: rotate(-3deg);
    }
    .qs-bubble .bubble-mark {
      position: absolute;
      z-index: 2;
      font-family: "Playfair Display", serif;
      font-size: 5.4rem;
      line-height: 0.7;
      color: #5b4747;
      pointer-events: none;
      user-select: none;
    }
    .qs-bubble .bubble-mark--open {
      top: 3.25rem;
      left: 4.1rem;
    }
    .qs-bubble .bubble-mark--close {
      right: 5.2rem;
      bottom: 4.2rem;
    }

    .colaboran {
      flex-shrink: 0;
      width: 235px;
      height: 185px;
      margin-top: 120px;
    }
    .colaboran img { width: 100%; height: 100%; object-fit: cover; }

    .team-profile-stage {
      position: relative;
      min-height: 245dvh;
      background: #214d4f;
      z-index: 1;
    }

    .team-section {
      position: sticky;
      top: 0;
      z-index: 1;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      background: #214d4f;
      display: flex;
      flex-direction: column;
      padding: 50px 0;
    }

    .marquee-row {
      position: absolute;
      left: -10%;
      width: 120%;
    }
    .marquee-row--1 { top: 36.5%; transform: rotate(5deg);     z-index: 2; }
    .marquee-row--2 { top: 51.8%; transform: rotate(5deg);     z-index: 2; }
    .marquee-row--3 { top: 43.5%; transform: rotate(-7.34deg); z-index: 2; }

    .marquee-track {
      display: flex;
      align-items: center;
      gap: 34px;
      width: max-content;
    }
    .name-tag {
      display: flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      height: 57px;
      padding: 0 20px;
      border-radius: 11.885px;
      border: 2.377px solid rgba(255,255,255,0.25);
      font-family: 'Inter', sans-serif;
      font-size: 22px;
      font-weight: 400;
      flex-shrink: 0;
    }

    .marquee-container {
      position: relative;
      flex: 1;
      width: 100%;
    }

    .team-title {
      position: relative;
      text-align: center;
      padding: 2rem 1rem 0;
      z-index: 10;
    }
    .team-title h2 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(22px, 2.8vw, 44.8px);
      text-transform: uppercase;
      color: white;
      white-space: nowrap;
      margin: 0;
    }

    .profile-section {
      position: sticky;
      top: 0;
      z-index: 2;
      width: 100%;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 2%;
      margin-top: -100dvh;
      overflow: hidden;
      pointer-events: none;
    }
    .profile-shell {
      position: relative;
      width: min(1180px, 94vw);
      margin: 0 auto;
    }
    .profile-container {
      position: relative;
      width: min(1096px, 96vw);
      height: min(640px, 58vw);
      margin: 0 auto;
      overflow: visible;
    }
    .profile-card-wrap {
      position: absolute;
      left: 32.3%;
      top: 4%;
      width: 35.55%;
      height: 90%;
      opacity: 0;
      pointer-events: none;
      will-change: left, top, width, height, opacity, transform;
    }
    .profile-card-wrap.is-active {
      opacity: 1;
      z-index: 20;
      pointer-events: auto;
    }
    .profile-card-wrap.is-prev,
    .profile-card-wrap.is-next {
      opacity: 1;
      z-index: 12;
    }
    .profile-card-wrap.is-far-prev,
    .profile-card-wrap.is-far-next {
      opacity: 1;
      z-index: 6;
    }
    .profile-card-wrap.is-hidden {
      opacity: 0;
      z-index: 1;
    }
    .profile-carousel__button {
      position: absolute;
      top: 50%;
      z-index: 30;
      width: 58px;
      height: 58px;
      border: none;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(249, 245, 242, 0.94);
      color: var(--text);
      box-shadow: 0 18px 38px rgba(22, 22, 22, 0.16);
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
      transition: transform 180ms ease, background 180ms ease;
      transform: translateY(-50%);
      opacity: 0;
      pointer-events: none;
    }
    .profile-carousel__button--prev { left: -28px; }
    .profile-carousel__button--next { right: -28px; }
    .profile-carousel__button:hover {
      transform: translateY(calc(-50% - 2px));
      background: #fff;
    }
    .profile-carousel__button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    @media (max-width: 1200px) {
      .menu { padding: 0 1rem; }
    }
    @media (max-width: 900px) {
      .menu {
        padding: 12px 16px;
        flex-direction: row;
        align-items: center;
        min-height: auto;
      }
      .menu .brand {
        width: 88px;
        height: 88px;
        position: relative;
        z-index: 2;
      }
      .menu .panel {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100dvh;
        min-height: 100dvh;
        max-height: none;
        margin: 0;
        border-radius: 0;
        padding: 132px 28px 32px;
        background:
          linear-gradient(180deg, rgba(249, 245, 242, 0.98), rgba(238, 226, 217, 0.98));
        backdrop-filter: blur(12px);
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 28px;
        min-width: 0;
        max-width: none;
        box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
        transform: translate3d(100%, 0, 0);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
          transform 0.35s ease,
          opacity 0.25s ease,
          visibility 0s linear 0.35s;
      }
      .menu .panel.open {
        transform: translate3d(0, 0, 0);
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition:
          transform 0.35s ease,
          opacity 0.25s ease,
          visibility 0s;
      }
      .links {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
        width: 100%;
      }
      .links li {
        width: 100%;
      }
      .links a {
        display: block;
        width: 100%;
        font-size: clamp(2rem, 8vw, 3rem);
        line-height: 0.95;
      }
      .menu .dev-readout {
        margin-left: 0;
      }
      .cta {
        align-self: flex-start;
        margin-top: auto;
        font-size: 1rem;
        padding: 14px 28px;
      }
      .nav-toggle {
        display: flex;
        position: relative;
        z-index: 2;
        width: 52px;
        height: 52px;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 999px;
        background: rgba(249, 245, 242, 0.92);
        box-shadow: 0.8px 2.4px 0 #464646, 0 6.4px 9.6px rgba(0,0,0,.12);
      }
      .qs-hero { padding-top: 140px; }
      .qs-hero__content { flex-direction: column; align-items: center; }
      .qs-hero__inner { gap: 2rem; }
      .team-profile-stage {
        min-height: auto;
      }
      .profile-section {
        position: relative;
        top: auto;
        min-height: auto;
        margin-top: 0;
        opacity: 1;
        pointer-events: auto;
      }
      .profile-shell {
        width: 100%;
      }
      .profile-container {
        height: auto;
        display: flex;
        flex-direction: column;
        gap: 24px;
        width: min(560px, 100%);
      }
      .profile-card-wrap {
        position: static;
        inset: auto;
        width: 100% !important;
        height: auto !important;
        opacity: 1 !important;
        left: auto !important;
        top: auto !important;
        pointer-events: auto;
        will-change: auto;
      }
      .profile-carousel__button {
        display: none;
      }
      .team-section { min-height: 60vh; }
    }

    @media (prefers-reduced-motion: reduce) {
      .qs-hero-bg-shape {
        opacity: 1;
        transform: none;
      }
      .qs-hero__title {
        opacity: 1;
        transform: none;
      }
      .marquee-track { animation: none !important; }
    }

    :global(.quienes-footer .footer-section) {
      background: #f9f5f2;
    }
    body.nav-menu-open {
      overflow: hidden;
    }
  </style>
</head>
