<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const menu = document.getElementById("navbar");
  const navToggle = document.getElementById("nav-toggle");
  const navPanel = menu?.querySelector(".panel");
  const mobileMenuQuery = window.matchMedia("(max-width: 900px)");
  const qsHero = document.getElementById("qs-hero");
  const qsHeroTitle = document.querySelector(".qs-hero__title");
  const teamSection = document.querySelector(".team-section");
  const teamProfileStage = document.querySelector(".team-profile-stage");
  const profileSection = document.querySelector(".profile-section");
  const isDevScroll = new URLSearchParams(window.location.search).get("dev") === "1";
  const devReadout = document.querySelector("[data-dev-readout]");
  const devScrollValue = document.querySelector("[data-dev-scroll]");
  const devStageValue = document.querySelector("[data-dev-stage]");
  const devHeightValue = document.querySelector("[data-dev-height]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const mobileViewport = window.matchMedia("(max-width: 768px)");
  const profileCards = Array.from(document.querySelectorAll(".profile-card-wrap"));
  const profilePrevButton = document.querySelector(".profile-carousel__button--prev");
  const profileNextButton = document.querySelector(".profile-carousel__button--next");
  const profileCardLayouts = {
    "is-active": { left: 32.3, top: 4, width: 35.55, height: 90, opacity: 1, scale: 1, zIndex: 30 },
    "is-prev": { left: 5.9, top: 8.6, width: 31.95, height: 82.8, opacity: 1, scale: 1, zIndex: 18 },
    "is-next": { left: 62.1, top: 8.6, width: 31.95, height: 82.8, opacity: 1, scale: 1, zIndex: 18 },
    "is-far-prev": { left: -8.2, top: 12.5, width: 27.5, height: 74, opacity: 1, scale: 1, zIndex: 8 },
    "is-far-next": { left: 80.7, top: 12.5, width: 27.5, height: 74, opacity: 1, scale: 1, zIndex: 8 },
    "is-hidden": { left: 32.3, top: 16, width: 28, height: 74, opacity: 0, scale: 0.94, zIndex: 1 },
  };
  let isProfileAnimating = false;

  const syncMenuState = (isOpen) => {
    navPanel?.classList.toggle("open", isOpen);
    menu?.classList.toggle("open", isOpen);
    navToggle?.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("nav-menu-open", isOpen && mobileMenuQuery.matches);
  };

  navToggle?.addEventListener("click", () => {
    syncMenuState(!navPanel?.classList.contains("open"));
  });

  [...(menu?.querySelectorAll(".links a") ?? []), ...(menu?.querySelectorAll(".cta") ?? [])].forEach((link) => {
    link.addEventListener("click", () => {
      syncMenuState(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && navPanel?.classList.contains("open")) {
      syncMenuState(false);
    }
  });

  mobileMenuQuery.addEventListener("change", (event) => {
    if (!event.matches) {
      syncMenuState(false);
    } else {
      document.body.classList.toggle("nav-menu-open", navPanel?.classList.contains("open") ?? false);
    }
  });

  const wrapProfileIndex = (value, total) => {
    if (!total) return 0;
    return (value % total + total) % total;
  };

  const getProfileState = (index, activeIndex, total) => {
    const delta = wrapProfileIndex(index - activeIndex, total);
    if (delta === 0) return "is-active";
    if (delta === 1) return "is-next";
    if (delta === total - 1) return "is-prev";
    if (delta === 2) return "is-far-next";
    if (delta === total - 2) return "is-far-prev";
    return "is-hidden";
  };

  const syncProfileCarousel = (activeIndex, immediate = false) => {
    profileCards.forEach((card, index) => {
      const state = getProfileState(index, activeIndex, profileCards.length);
      const flipCard = card.querySelector(".profile-flip-card");
      const layout = profileCardLayouts[state];

      card.classList.remove("is-active", "is-prev", "is-next", "is-far-prev", "is-far-next", "is-hidden");
      card.classList.add(state);

      if (!mobileViewport.matches && layout) {
        gsap.to(card, {
          left: `${layout.left}%`,
          top: `${layout.top}%`,
          width: `${layout.width}%`,
          height: `${layout.height}%`,
          opacity: layout.opacity,
          scale: layout.scale,
          duration: immediate ? 0 : 0.62,
          ease: "power3.inOut",
          overwrite: true,
          onStart: () => {
            card.style.zIndex = String(state === "is-active" ? 30 : layout.zIndex);
          },
          onComplete: () => {
            card.style.zIndex = String(layout.zIndex);
          },
        });
      }

      if (flipCard) {
        const isInteractive = state === "is-active";
        flipCard.dataset.interactive = isInteractive ? "true" : "false";
        flipCard.tabIndex = isInteractive ? 0 : -1;
      }
    });
  };

  let activeProfileIndex = 0;
  syncProfileCarousel(activeProfileIndex, true);

  const changeProfile = (direction) => {
    if (isProfileAnimating || !profileCards.length) return;
    isProfileAnimating = true;
    activeProfileIndex = wrapProfileIndex(activeProfileIndex + direction, profileCards.length);
    syncProfileCarousel(activeProfileIndex);
    window.setTimeout(() => {
      isProfileAnimating = false;
    }, 640);
  };

  profilePrevButton?.addEventListener("click", () => {
    changeProfile(-1);
  });

  profileNextButton?.addEventListener("click", () => {
    changeProfile(1);
  });

  if (menu && !prefersReducedMotion.matches) {
    const enterY = Number.parseFloat(getComputedStyle(menu).getPropertyValue("--enter-y")) || -18;
    menu.style.opacity = "0";
    menu.style.transform = `translate3d(0, ${enterY}px, 0)`;

    const startTime = performance.now();
    const duration = 720;

    const step = (now) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      menu.style.opacity = String(progress);
      menu.style.transform = `translate3d(0, ${enterY * (1 - progress)}px, 0)`;
      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };
    requestAnimationFrame(step);
  } else if (menu) {
    menu.style.opacity = "1";
    menu.style.transform = "none";
  }

  const revealHeroBackground = () => {
    if (!qsHero) return;
    if (prefersReducedMotion.matches) {
      qsHero.classList.add("is-bg-revealed");
      if (qsHeroTitle) {
        qsHeroTitle.style.opacity = "1";
        qsHeroTitle.style.transform = "none";
      }
      return;
    }

    requestAnimationFrame(() => {
      setTimeout(() => {
        qsHero.classList.add("is-bg-revealed");
        if (qsHeroTitle) {
          gsap.to(qsHeroTitle, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: "power2.out",
            delay: 1.02,
            overwrite: true,
          });
        }
      }, 140);
    });
  };

  if (document.readyState === "complete") {
    revealHeroBackground();
  } else {
    window.addEventListener("load", revealHeroBackground, { once: true });
  }

  gsap.fromTo('.qs-hero .fondecyt',
    { opacity: 0, scale: 0.88, y: 40 },
    { opacity: 1, scale: 1, y: 0, duration: 0.9, ease: 'back.out(1.3)', delay: 0.6 }
  );

  const row1 = document.getElementById('marqueeRow1');
  if (row1) {
    const half1 = row1.scrollWidth / 2;
    gsap.to(row1, {
      x: -half1, duration: 28, ease: 'none', repeat: -1,
      modifiers: { x: (x) => (parseFloat(x) % half1) + 'px' }
    });
  }

  const row2 = document.getElementById('marqueeRow2');
  if (row2) {
    const half2 = row2.scrollWidth / 2;
    gsap.to(row2, {
      x: -half2, duration: 20, ease: 'none', repeat: -1,
      modifiers: { x: (x) => (parseFloat(x) % half2) + 'px' }
    });
  }

  const row3 = document.getElementById('marqueeRow3');
  if (row3) {
    const half3 = row3.scrollWidth / 2;
    gsap.fromTo(row3, { x: -half3 }, { x: 0, duration: 32, ease: 'none', repeat: -1 });
  }

  gsap.fromTo('.team-title h2',
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
      scrollTrigger: { trigger: '.team-title', start: 'top 85%' } }
  );

  if (profileSection && (prefersReducedMotion.matches || mobileViewport.matches)) {
    gsap.set(profileSection, { pointerEvents: "auto" });
    gsap.set('.profile-card-wrap', { yPercent: 0, opacity: 1 });
    gsap.set('.profile-carousel__button', { autoAlpha: 1, yPercent: 0, y: 0, pointerEvents: "auto" });
  } else if (teamProfileStage && profileSection && teamSection) {
    gsap.set(profileSection, { pointerEvents: "none" });
    gsap.set('.profile-card-wrap', { yPercent: 135, y: 200, opacity: 0.42 });
    gsap.set('.profile-carousel__button', { autoAlpha: 0, yPercent: 135, y: 100, pointerEvents: "none" });

    const profileTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: teamSection,
        endTrigger: profileSection,
        start: 'top top',
        end: 'bottom 50%',
        scrub: 1,
        onUpdate: (self) => {
          profileSection.style.pointerEvents = self.progress > 0.72 ? "auto" : "none";
          gsap.set('.profile-carousel__button', {
            pointerEvents: self.progress > 0.72 ? "auto" : "none",
          });
        },
      }
    });

    profileTimeline.to('.profile-card-wrap', {
      yPercent: 0,
      y: 0,
      opacity: 1,
      duration: 0.28,
      ease: 'none',
    }, 0.72);

    profileTimeline.to('.profile-carousel__button', {
      autoAlpha: 1,
      yPercent: 0,
      y: 0,
      duration: 0.28,
      ease: 'none',
    }, 0.72);
  }

  if (isDevScroll && devReadout && teamProfileStage) {
    devReadout.classList.add("is-visible");

    const updateDevReadout = () => {
      const stageRect = teamProfileStage.getBoundingClientRect();
      const scrollableDistance = Math.max(teamProfileStage.offsetHeight - window.innerHeight, 1);
      const stageProgress = Math.min(Math.max((-stageRect.top) / scrollableDistance, 0), 1);

      if (devScrollValue) {
        devScrollValue.textContent = `${Math.round(window.scrollY)}px`;
      }

      if (devStageValue) {
        devStageValue.textContent = `${Math.round(stageProgress * 100)}%`;
      }

      if (devHeightValue) {
        devHeightValue.textContent = `${Math.round(teamProfileStage.offsetHeight)}px`;
      }
    };

    updateDevReadout();
    window.addEventListener("scroll", updateDevReadout, { passive: true });
    window.addEventListener("resize", updateDevReadout);

    ScrollTrigger.create({
      trigger: teamProfileStage,
      start: "top top",
      end: "bottom bottom",
      markers: {
        startColor: "#be572a",
        endColor: "#be572a",
        fontSize: "12px",
        indent: 20,
      },
      id: "team-profile-stage",
    });

    ScrollTrigger.create({
      trigger: ".team-section",
      endTrigger: teamProfileStage,
      start: "top top",
      end: "bottom 50%",
      markers: {
        startColor: "#3b959e",
        endColor: "#3b959e",
        fontSize: "11px",
        indent: 36,
      },
      id: "team-section",
    });

    ScrollTrigger.create({
      trigger: ".profile-section",
      start: "top top",
      end: "bottom 50%",
      markers: {
        startColor: "#d2892d",
        endColor: "#d2892d",
        fontSize: "11px",
        indent: 52,
      },
      id: "profile-section",
    });

    ScrollTrigger.refresh();
  }
</script>
</html>
