<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SeoHead
    title="Quiénes somos"
    description="Conoce al equipo y la comunidad que desarrolla una investigación narrativa y longitudinal sobre identidad profesional docente y educación parvularia."
    path="/quienes-somos/"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Inconsolata:wght@400;700;900&family=Playfair+Display:wght@400;500;600;700&family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet">
  <script is:inline>
    (() => {
      const isIOS = /iP(ad|hone|od)/.test(navigator.platform) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const isIOSWebKit = isIOS && /AppleWebKit/.test(navigator.userAgent);
      const isMobileSafari = isIOSWebKit && /Safari/.test(navigator.userAgent) &&
        !/CriOS|FxiOS|EdgiOS|OPiOS/.test(navigator.userAgent);
      if (isIOSWebKit) document.documentElement.classList.add('mobile-webkit');
      if (isMobileSafari) document.documentElement.classList.add('mobile-safari');
    })();
  </script>
  <style>
    :root {
      --bg: #f9f5f2;
      --bg-soft: #f4ebe6;
      --paper: #eee2d9;
      --text: #620404;
      --text-soft: #514444;
      --primary: #be572a;
      --accent: #d2892d;
      --teal: #3b959e;
      --orange: #c36438;
      --green: #8bc5ae;
      --nav-h: 130px;
      --radius: 24px;
      --vw: 1vw;
      --vh: 1vh;
      --viewport-scale: 1;
      --viewport-scale-x: 1;
      --viewport-scale-y: 1;
      --is-compact-desktop: 0;
      --qs-ornament-height: 321px;
      --team-section-padding-y: 50px;
      --profile-section-padding-y: 80px;
      --profile-carousel-height: 640px;
      --profile-control-size: 58px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #fff;
      color: var(--text);
      font-family: Inter, sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .page {
      position: relative;
      min-height: 100vh;
      isolation: isolate;
    }

    .menu {
      --enter-y: -18px;
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 40;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 0 max(16px, calc((100vw - 1200px) / 2));
      min-height: var(--nav-h);
      pointer-events: none;
    }
    .menu .brand {
      width: 130px;
      height: 130px;
      flex: 0 0 auto;
      pointer-events: auto;
      overflow: clip;
      border-radius: 100px;
    }
    .menu .panel {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 25px;
      padding: 10px 28px;
      background: #f9f5f2;
      border-radius: 0 0 12.8px 12.8px;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
      transform: translateX(-2px);
      margin-top: 0;
      min-width: 0;
      width: max-content;
    }
    .menu .dev-readout {
      display: none;
      align-items: center;
      gap: 10px;
      margin-left: 18px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(98, 4, 4, 0.08);
      color: var(--text);
      font-family: Inconsolata, monospace;
      font-size: 13px;
      line-height: 1;
      white-space: nowrap;
    }
    .menu .dev-readout strong {
      font-weight: 900;
      color: var(--primary);
    }
    .menu .dev-readout.is-visible {
      display: inline-flex;
    }
    .links {
      display: flex;
      align-items: center;
      gap: 25px;
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      color: #000;
      white-space: nowrap;
    }
    .links li a { transition: opacity 0.2s ease; }
    .links li a:hover { opacity: 0.7; }
    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 27px;
      border-radius: 48px;
      border: none;
      background: var(--accent);
      color: #eee2d9;
      font-family: Inconsolata, monospace;
      font-weight: 900;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
    }
    .cta:hover { color: #eee2d9; filter: brightness(0.98); }
    .nav-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
      pointer-events: auto;
      margin-left: auto;
    }
    .nav-toggle span {
      display: block;
      width: 24px;
      height: 2px;
      background: #000;
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .menu.open .nav-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .menu.open .nav-toggle span:nth-child(2) {
      opacity: 0;
    }
    .menu.open .nav-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* ── Quiénes Somos sections ── */

    .qs-bg {
      position: absolute;
      inset: 0 auto auto 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }
    .qs-bg svg {
      position: absolute;
      top: 0;
      height: 100%;
    }

    .qs-hero {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 150px 0 60px;
      background: #fff;
      overflow: clip;
    }
    .qs-hero__backdrop {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: var(--bg);
      opacity: 0.2;
      overflow: hidden;
      pointer-events: none;
    }
    .qs-hero__bg-fallback {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      background: #f9f4f1;
    }
    .qs-hero__bg-fallback img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center top; }
    .qs-hero.is-bg-fallback .qs-hero__bg-fallback { opacity: 1; visibility: visible; }
    .qs-hero.is-bg-fallback .qs-hero-bg-shape { opacity: 0 !important; visibility: hidden; animation: none !important; }
    .qs-hero-bg-shape {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: translate3d(-9vw, 0, 0);
      will-change: transform, opacity;
      backface-visibility: hidden;
    }
    .qs-hero-bg-shape svg {
      width: 100%;
      height: 100%;
      display: block;
      user-select: none;
      pointer-events: none;
      overflow: visible;
    }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape {
      animation: heroBgLayerEnter 1.25s cubic-bezier(.2,.75,.18,1) forwards;
    }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--1 { animation-delay: 0.12s; }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--2 { animation-delay: 0.34s; }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--3 { animation-delay: 0.56s; }
    .qs-hero.is-bg-revealed .qs-hero-bg-shape--4 { animation-delay: 0.78s; }
    @keyframes heroBgLayerEnter {
      0% {
        opacity: 0;
        transform: translate3d(-9vw, 0, 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }
    .qs-hero__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(235px, 1fr);
      align-items: center;
      gap: 2rem;
      padding: 0 clamp(1.5rem, 5vw, 5rem);
      width: 100%;
      position: relative;
      z-index: 1;
    }
    .qs-hero__inner {
      position: relative;
      z-index: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(3rem, 6vw, 5rem);
    }
    .qs-hero__title {
      margin: 0;
      padding: 0 1.5rem;
      width: 100%;
      text-align: center;
      font-family: 'Playfair Display', serif;
      font-size: clamp(2rem, 4.2vw, 4.2rem);
      line-height: 1.05;
      font-weight: 700;
      color: #620404;
      text-wrap: balance;
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }

    .fondecyt {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }
    /* Visible by default: only hide it after GSAP has initialized successfully. */
    :global(html.gsap-motion-ready) .fondecyt {
      opacity: 0;
    }
    .fondecyt__label {
      position: relative;
      z-index: 20;
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      font-size: 28.8px;
      color: white;
      white-space: nowrap;
      margin-bottom: 1rem;
    }
    .fondecyt__bubbles {
      position: relative;
      width: 100%;
      height: auto;
      height: auto;
    }
    .bubble-q {
      position: absolute;
      pointer-events: none;
    }
    .bubble-q--orange {
       width: 98%; height: var(--qs-ornament-height);
      top: 0;
      right: 0;
      left: auto;
      transform: translate(33.333%, -16.333%) rotate(2deg);
      z-index: 0;
      filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
    }
    .bubble-q--copper {
       width: 100%; height: var(--qs-ornament-height);
      bottom: 0;
      left: 0;
      top: auto;
      transform: translate(-33.333%, 40.333%) rotate(175deg) scaleY(-1);
      z-index: 1;
      filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
    }

    .qs-bubble {
      position: relative;
      inset: auto;
      z-index: 3;
      isolation: isolate;
      width: 100%;
      min-height: 0;
      height: auto;
      margin: 0;
    }
    .qs-bubble .bubble-shape {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .qs-bubble .bubble-shape svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      filter: drop-shadow(0 4px 15.3px rgba(0,0,0,0.25));
    }
    .qs-bubble .bubble-quote {
      position: relative;
      inset: auto;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-width: 0;
      align-self: center;
      margin-inline: auto;
      box-sizing: border-box;
      padding: 3rem 4.6rem;
      background: #83BAA4;
      border-radius: 85px;
      box-shadow: 0 4px 15.3px rgba(0,0,0,0.25);
      rotate: -3deg;
    }
    .qs-bubble .bubble-text {
      margin: 0;
      max-width: 100%;
      font-family: "Open Sans", sans-serif;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-align: justify;
      text-wrap: balance;
      color: #111;
      align-self: center;
      transform: none;
    }
    .colaboran {
      flex-shrink: 0;
      width: 350px;
      max-width: 100%;
      min-height: 185px;
      margin-top: 0;
      justify-self: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
    }
    .colaboran img { width: 100%; height: auto; object-fit: contain; }

    .team-profile-stage {
      position: relative;
      min-height: 245dvh;
      background: #214d4f;
      z-index: 1;
    }

    .team-section {
      position: sticky;
      top: 0;
      z-index: 1;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      background: #214d4f;
      display: flex;
      flex-direction: column;
       padding: var(--team-section-padding-y) 0;
    }

    .marquee-row {
      position: absolute;
      left: -10%;
      width: 120%;
    }
    .marquee-row--1 { top: 36.5%; transform: rotate(5deg);     z-index: 2; }
    .marquee-row--2 { top: 51.8%; transform: rotate(5deg);     z-index: 2; }
    .marquee-row--3 { top: 43.5%; transform: rotate(-7.34deg); z-index: 2; }

    .marquee-track {
      display: flex;
      align-items: center;
      gap: 34px;
      width: max-content;
    }
    .name-tag {
      display: flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      height: 57px;
      padding: 0 20px;
      border-radius: 11.885px;
      border: 2.377px solid rgba(255,255,255,0.25);
      font-family: 'Inter', sans-serif;
      font-size: 22px;
      font-weight: 400;
      flex-shrink: 0;
    }

    .marquee-container {
      position: relative;
      flex: 1;
      width: 100%;
      opacity: 0.3;
    }

    .team-title {
      position: relative;
      text-align: center;
      padding: 2rem 1rem 0;
      z-index: 10;
    }
    .team-title h2 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(22px, 2.8vw, 44.8px);
