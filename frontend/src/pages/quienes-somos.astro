        <div class="colaboran">
          <img src="/images/investigacion/logo-anid-ministerio-ciencia.png" alt="Ministerio de Ciencia, Tecnología, Conocimiento e Innovación y ANID" />
          <img src="/images/investigacion/Logo_Universidad_Diego_Portales.png" alt="Universidad Diego Portales" />
        </div>
        </div>
      </div>
    </section>

    <section class="team-profile-stage">
    <div class="team-section">
      <div class="team-title">
        <h2>EQUIPO DE INVESTIGACIÓN</h2>
      </div>
      <div class="marquee-container">
        <div class="marquee-row marquee-row--1" aria-hidden="true">
          <div class="marquee-track" id="marqueeRow1">
            {doubled1.map((idx) => (
              <div class="name-tag" style={`background:${TAGS[idx].bg}; color:${TAGS[idx].text};`}>
                {TEAM_NAMES[idx]}
              </div>
            ))}
          </div>
        </div>

        <div class="marquee-row marquee-row--2" aria-hidden="true">
          <div class="marquee-track" id="marqueeRow2">
            {doubled2.map((idx) => (
              <div class="name-tag" style={`background:${TAGS[idx].bg}; color:${TAGS[idx].text};`}>
                {TEAM_NAMES[idx]}
              </div>
            ))}
          </div>
        </div>

        <div class="marquee-row marquee-row--3" aria-hidden="true">
          <div class="marquee-track" id="marqueeRow3">
            {doubled3.map((idx) => (
              <div class="name-tag" style={`background:${TAGS[idx].bg}; color:${TAGS[idx].text};`}>
                {TEAM_NAMES[idx]}
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <section class="profile-section">
      <div class="profile-shell">
        <div class="profile-container" data-profile-carousel>
          <button class="profile-carousel__button profile-carousel__button--prev" type="button" aria-label="Ver perfil anterior">
            &#8249;
          </button>
          {DISPLAY_PROFILES.map((profile, index) => (
          <div class:list={["profile-card-wrap", { "is-active": index === 0 }]} data-profile-index={index}>
            <ProfileFlipCard
              name={profile.name}
              photoSrc={profile.photoSrc}
              backPhotoSrc={profile.backPhotoSrc}
              size={profile.size}
              tilt={profile.tilt}
              interactive={index === 0}
              frontItems={profile.frontItems}
              backEyebrow={profile.backEyebrow}
              backTitle={profile.backTitle}
              backItems={profile.backItems}
            />
          </div>
        ))}
          <button class="profile-carousel__button profile-carousel__button--next" type="button" aria-label="Ver siguiente perfil">
            &#8250;
          </button>
        </div>
      </div>
    </section>
    </section>

    <div class="quienes-footer">
      <Footer />
    </div>
  </div>
</body>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Lenis from "lenis";
  gsap.registerPlugin(ScrollTrigger);

  const enableGsapFallbackMode = () => {
    document.documentElement.classList.add('gsap-motion-ready');
  };

  const DESIGN_VIEWPORT = Object.freeze({ width: 1902, height: 910 });
  const DESKTOP_BREAKPOINT = 901;
  const rootStyle = document.documentElement;

  // Quienes somos-only smooth scroll pilot.
  // To revert: remove this block and keep the `lenis` dependency only if another page uses it.
  const quienesMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const previousScrollBehavior = rootStyle.style.scrollBehavior;
  let quienesLenis;

  if (!quienesMotionQuery.matches) {
    quienesLenis = new Lenis({
      lerp: 0.12,
      autoRaf: false,
      smoothWheel: true,
      syncTouch: false,
    });

    rootStyle.style.scrollBehavior = "auto";
    quienesLenis.on("scroll", ScrollTrigger.update);
    gsap.ticker.add((time) => quienesLenis?.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    window.addEventListener("beforeunload", () => {
      quienesLenis?.destroy();
      rootStyle.style.scrollBehavior = previousScrollBehavior;
    }, { once: true });
  }

  const initialDevicePixelRatio = window.devicePixelRatio;
  let viewportMode = window.innerWidth < DESKTOP_BREAKPOINT ? "mobile" : "desktop";
  let viewportMetrics = {
    width: window.innerWidth,
    height: window.innerHeight,
    scaleX: 1,
    scaleY: 1,
    scale: 1,
    isCompactDesktop: false,
  };
  let viewportRefreshFrame = 0;

  ScrollTrigger.config({
    autoRefreshEvents: "visibilitychange,DOMContentLoaded,load",
    ignoreMobileResize: true,
  });

  const designPx = (value, axis = "y") => {
    const scale = axis === "x" ? viewportMetrics.scaleX : viewportMetrics.scaleY;
    return value * scale;
  };

  const getViewportMode = () =>
    window.innerWidth < DESKTOP_BREAKPOINT ? "mobile" : "desktop";

  const syncViewportMetrics = () => {
    const width = Math.max(window.innerWidth, document.documentElement.clientWidth, 1);
    const height = Math.max(window.innerHeight, document.documentElement.clientHeight, 1);
    const scaleX = width / DESIGN_VIEWPORT.width;
    const scaleY = height / DESIGN_VIEWPORT.height;
    const isCompactDesktop = width >= DESKTOP_BREAKPOINT && height < 800;

    viewportMetrics = {
      width,
      height,
      scaleX,
      scaleY,
      scale: Math.min(scaleX, scaleY),
      isCompactDesktop,
    };

    rootStyle.style.setProperty("--vw", `${(width * 0.01).toFixed(4)}px`);
    rootStyle.style.setProperty("--vh", `${(height * 0.01).toFixed(4)}px`);
    rootStyle.style.setProperty("--viewport-scale", viewportMetrics.scale.toFixed(5));
    rootStyle.style.setProperty("--viewport-scale-x", scaleX.toFixed(5));
    rootStyle.style.setProperty("--viewport-scale-y", scaleY.toFixed(5));
    rootStyle.style.setProperty("--is-compact-desktop", isCompactDesktop ? "1" : "0");

    if (width >= DESKTOP_BREAKPOINT) {
      rootStyle.style.setProperty("--qs-ornament-height", `${Math.round(designPx(321, "y"))}px`);
      rootStyle.style.setProperty("--team-section-padding-y", `${Math.round(designPx(50, "y"))}px`);
      rootStyle.style.setProperty("--profile-section-padding-y", `${Math.round(designPx(80, "y"))}px`);
      rootStyle.style.setProperty("--profile-carousel-height", `${Math.round(designPx(640, "y"))}px`);
      rootStyle.style.setProperty("--profile-control-size", `${Math.round(designPx(58, "y"))}px`);
    } else {
      rootStyle.style.removeProperty("--qs-ornament-height");
      rootStyle.style.removeProperty("--team-section-padding-y");
      rootStyle.style.removeProperty("--profile-section-padding-y");
      rootStyle.style.removeProperty("--profile-carousel-height");
      rootStyle.style.removeProperty("--profile-control-size");
    }
  };

  const refreshViewportAnimations = () => {
    if (viewportRefreshFrame) return;

    viewportRefreshFrame = window.requestAnimationFrame(() => {
      viewportRefreshFrame = 0;
      syncViewportMetrics();
      window.dispatchEvent(new CustomEvent("quienes:viewportchange"));
      window.requestAnimationFrame(() => ScrollTrigger.refresh());
    });
  };

  let lastLayoutWidth = document.documentElement.clientWidth;
  let viewportRefreshTimer = 0;

  const handleViewportResize = (source = "window") => {
    const nextViewportMode = getViewportMode();

    // Safari puede emitir resize al mostrar u ocultar la barra de dirección.
    // El layout se actualiza sin recargar la página.
    viewportMode = nextViewportMode;

    const nextLayoutWidth = document.documentElement.clientWidth;
    const widthChanged = Math.abs(nextLayoutWidth - lastLayoutWidth) > 1;
    if (source === "visualViewport" && !widthChanged) return;
    if (source !== "orientationchange" && !widthChanged) return;

    window.clearTimeout(viewportRefreshTimer);
    viewportRefreshTimer = window.setTimeout(() => {
      lastLayoutWidth = document.documentElement.clientWidth;
      refreshViewportAnimations();
    }, 180);
  };

  syncViewportMetrics();
  window.addEventListener("resize", handleViewportResize, { passive: true });
  window.addEventListener("orientationchange", () => handleViewportResize("orientationchange"), { passive: true });
  window.visualViewport?.addEventListener("resize", () => handleViewportResize("visualViewport"), { passive: true });
  window.addEventListener("load", refreshViewportAnimations, { once: true });
  document.fonts?.ready?.then(refreshViewportAnimations);

  const menu = document.getElementById("navbar");
  const navToggle = document.getElementById("nav-toggle");
  const navPanel = menu?.querySelector(".panel");
  const mobileMenuQuery = window.matchMedia("(max-width: 900px)");
  const qsHero = document.getElementById("qs-hero");
  const qsHeroTitle = document.querySelector(".qs-hero__title");
  const bgFallback = qsHero?.querySelector(".qs-hero__bg-fallback");
  const bgFallbackImage = bgFallback?.querySelector("img[data-bg-fallback-src]");
  const bgSVGs = Array.from(qsHero?.querySelectorAll(".qs-hero-bg-shape svg") || []);
  const teamSection = document.querySelector(".team-section");
  const teamProfileStage = document.querySelector(".team-profile-stage");
  const profileSection = document.querySelector(".profile-section");
  const isDevScroll = new URLSearchParams(window.location.search).get("dev") === "1";
  const devReadout = document.querySelector("[data-dev-readout]");
  const devScrollValue = document.querySelector("[data-dev-scroll]");
  const devStageValue = document.querySelector("[data-dev-stage]");
  const devHeightValue = document.querySelector("[data-dev-height]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const activateBackgroundFallback = (reason = "unknown") => {
    if (!qsHero || !bgFallback || qsHero.classList.contains("is-bg-fallback")) return;
    if (bgFallbackImage && !bgFallbackImage.getAttribute("src")) {
      bgFallbackImage.setAttribute("src", bgFallbackImage.dataset.bgFallbackSrc || "");
    }
    qsHero.classList.add("is-bg-fallback");
    console.warn(`[quienes-somos] Fondo SVG reemplazado por WebP (${reason}).`);
  };
  const verifyBackgroundSVG = () => {
    if (prefersReducedMotion.matches || !bgSVGs.length) return;
    const svgIsRenderable = bgSVGs.every((svg) => {
      const rect = svg.getBoundingClientRect();
      try {
        const box = svg.getBBox();
        return rect.width > 1 && rect.height > 1 && box.width > 1 && box.height > 1;
      } catch { return false; }
    });
    if (!svgIsRenderable) activateBackgroundFallback("verificación de renderizado SVG");
  };
  const mobileViewport = window.matchMedia("(max-width: 900px)");
  const profileContainer = document.querySelector("[data-profile-carousel]");
  const profileCards = Array.from(document.querySelectorAll(".profile-card-wrap"));
  const profilePrevButton = document.querySelector(".profile-carousel__button--prev");
  const profileNextButton = document.querySelector(".profile-carousel__button--next");
  const profileCardLayouts = {
    "is-active": { left: 32.3, top: 4, width: 35.55, height: 92, opacity: 1, scale: 1, zIndex: 30 },
    "is-prev": { left: 5.9, top: 8.6, width: 35.55, height: 92, opacity: 1, scale: 0.8, zIndex: 18 },
    "is-next": { left: 62.1, top: 8.6, width: 35.55, height: 92, opacity: 1, scale: 0.8, zIndex: 18 },
    "is-far-prev": { left: -8.2, top: 12.5, width: 35.55, height: 92, opacity: 1, scale: 0.7, zIndex: 8 },
    "is-far-next": { left: 80.7, top: 12.5, width: 35.55, height: 92, opacity: 1, scale: 0.7, zIndex: 8 },
    "is-hidden": { left: 32.3, top: 16, width: 35.55, height: 92, opacity: 0, scale: 0.5, zIndex: 1 },
  };
  let isProfileAnimating = false;

  const syncMenuState = (isOpen) => {
    navPanel?.classList.toggle("open", isOpen);
    menu?.classList.toggle("open", isOpen);
    navToggle?.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("nav-menu-open", isOpen && mobileMenuQuery.matches);
  };

  navToggle?.addEventListener("click", () => {
    syncMenuState(!navPanel?.classList.contains("open"));
  });

  [...(menu?.querySelectorAll(".links a") ?? []), ...(menu?.querySelectorAll(".cta") ?? [])].forEach((link) => {
    link.addEventListener("click", () => {
      syncMenuState(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && navPanel?.classList.contains("open")) {
      syncMenuState(false);
    }
  });

  mobileMenuQuery.addEventListener("change", (event) => {
    if (!event.matches) {
      syncMenuState(false);
    } else {
      document.body.classList.toggle("nav-menu-open", navPanel?.classList.contains("open") ?? false);
    }
  });

  const wrapProfileIndex = (value, total) => {
    if (!total) return 0;
    return (value % total + total) % total;
  };

  const getProfileState = (index, activeIndex, total) => {
    const delta = wrapProfileIndex(index - activeIndex, total);
    if (delta === 0) return "is-active";
    if (delta === 1) return "is-next";
    if (delta === total - 1) return "is-prev";
    if (delta === 2) return "is-far-next";
    if (delta === total - 2) return "is-far-prev";
    return "is-hidden";
  };

  const syncProfileCarousel = (activeIndex, immediate = false) => {
    profileCards.forEach((card, index) => {
      const state = getProfileState(index, activeIndex, profileCards.length);
      const flipCard = card.querySelector(".profile-flip-card");
      const layout = profileCardLayouts[state];

      card.classList.remove("is-active", "is-prev", "is-next", "is-far-prev", "is-far-next", "is-hidden");
      card.classList.add(state);

      if (!mobileViewport.matches && layout) {
        gsap.to(card, {
          left: `${layout.left}%`,
          top: `${layout.top}%`,
          opacity: layout.opacity,
          scale: layout.scale,
          duration: immediate ? 0 : 0.62,
          ease: "power3.inOut",
          overwrite: true,
          onStart: () => {
            card.style.zIndex = String(state === "is-active" ? 30 : layout.zIndex);
          },
          onComplete: () => {
            card.style.zIndex = String(layout.zIndex);
          },
        });
      }

      if (flipCard) {
        const isInteractive = state === "is-active";
        flipCard.dataset.interactive = isInteractive ? "true" : "false";
        flipCard.tabIndex = isInteractive ? 0 : -1;
      }
    });
  };

  let activeProfileIndex = 0;
  syncProfileCarousel(activeProfileIndex, true);

  const changeProfile = (direction) => {
    if (isProfileAnimating || !profileCards.length) return;
    isProfileAnimating = true;
    activeProfileIndex = wrapProfileIndex(activeProfileIndex + direction, profileCards.length);
    syncProfileCarousel(activeProfileIndex);
    window.setTimeout(() => {
      isProfileAnimating = false;
    }, 640);
  };

  profileCards.forEach((card) => {
    card.addEventListener("click", (event) => {
      if (card.classList.contains("is-next")) {
        event.stopPropagation();
        changeProfile(1);
      } else if (card.classList.contains("is-prev")) {
        event.stopPropagation();
        changeProfile(-1);
      }
    }, true);
  });

  profilePrevButton?.addEventListener("click", () => {
    changeProfile(-1);
  });

  profileNextButton?.addEventListener("click", () => {
    changeProfile(1);
  });

  let profileTouchStartX = null;
  let profileTouchStartY = null;

  profileContainer?.addEventListener("touchstart", (event) => {
    if (event.touches.length !== 1) return;
    profileTouchStartX = event.touches[0].clientX;
    profileTouchStartY = event.touches[0].clientY;
  }, { passive: true });

  profileContainer?.addEventListener("touchend", (event) => {
    if (profileTouchStartX === null || profileTouchStartY === null) return;

    const deltaX = event.changedTouches[0].clientX - profileTouchStartX;
    const deltaY = event.changedTouches[0].clientY - profileTouchStartY;
    profileTouchStartX = null;
    profileTouchStartY = null;

    if (Math.abs(deltaX) < 50 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
    changeProfile(deltaX < 0 ? 1 : -1);
  }, { passive: true });

  profileContainer?.addEventListener("touchcancel", () => {
    profileTouchStartX = null;
    profileTouchStartY = null;
  }, { passive: true });

  if (menu && !prefersReducedMotion.matches) {
    const enterY = Number.parseFloat(getComputedStyle(menu).getPropertyValue("--enter-y")) || -18;
    menu.style.opacity = "0";
    menu.style.transform = `translate3d(0, ${enterY}px, 0)`;

    const startTime = performance.now();
    const duration = 720;

    const step = (now) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      menu.style.opacity = String(progress);
      menu.style.transform = `translate3d(0, ${enterY * (1 - progress)}px, 0)`;
      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };
    requestAnimationFrame(step);
  } else if (menu) {
    menu.style.opacity = "1";
    menu.style.transform = "none";
  }

  const revealHeroBackground = () => {
    if (!qsHero) return;
    if (prefersReducedMotion.matches) {
         qsHero.classList.add("is-bg-revealed");
         window.setTimeout(verifyBackgroundSVG, 2200);
      if (qsHeroTitle) {
        qsHeroTitle.style.opacity = "1";
        qsHeroTitle.style.transform = "none";
      }
      return;
    }

    requestAnimationFrame(() => {
      setTimeout(() => {
        qsHero.classList.add("is-bg-revealed");
        if (qsHeroTitle) {
          gsap.to(qsHeroTitle, {
            opacity: 1,
            y: 0,
            duration: 0.7,
            ease: "power2.out",
            delay: 1.02,
            overwrite: true,
          });
        }
      }, 140);
    });
  };

  if (document.readyState === "complete") {
    revealHeroBackground();
  } else {
    window.addEventListener("load", revealHeroBackground, { once: true });
  }

  try {
    enableGsapFallbackMode();
    gsap.fromTo('.qs-hero .fondecyt',
      { opacity: 0, scale: 0.88, y: () => designPx(40, 'y') },
      { opacity: 1, scale: 1, y: 0, duration: 0.9, ease: 'back.out(1.3)', delay: 0.6 }
    );
  } catch (error) {
    document.documentElement.classList.remove('gsap-motion-ready');
    console.warn('[quienes-somos] Fallback visual activado para FONDECYT.', error);
  }

  const isMobileWebKit = document.documentElement.classList.contains('mobile-webkit');
  const row1 = document.getElementById('marqueeRow1');
  if (row1 && !isMobileWebKit) {
    const half1 = row1.scrollWidth / 2;
    gsap.to(row1, {
      x: -half1, duration: 112, ease: 'none', repeat: -1,
      modifiers: { x: (x) => (parseFloat(x) % half1) + 'px' }
    });
  }

  const row2 = document.getElementById('marqueeRow2');
  if (row2 && !isMobileWebKit) {
    const half2 = row2.scrollWidth / 2;
    gsap.to(row2, {
      x: -half2, duration: 80, ease: 'none', repeat: -1,
      modifiers: { x: (x) => (parseFloat(x) % half2) + 'px' }
    });
  }

  const row3 = document.getElementById('marqueeRow3');
  if (row3 && !isMobileWebKit) {
    const half3 = row3.scrollWidth / 2;
    gsap.fromTo(row3, { x: -half3 }, { x: 0, duration: 128, ease: 'none', repeat: -1 });
  }

  if (mobileViewport.matches) {
    gsap.set('.team-title h2', { autoAlpha: 1, y: 0, clearProps: 'opacity,visibility,transform' });
  } else {
    gsap.fromTo('.team-title h2',
      { opacity: 0, y: () => designPx(30, 'y') },
      { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: '.team-title', start: 'top 85%' } }
    );
  }

  if (profileSection && (prefersReducedMotion.matches || mobileViewport.matches)) {
    gsap.set(profileSection, { pointerEvents: "auto" });
    gsap.set('.profile-card-wrap', { yPercent: 0, opacity: 1 });
    gsap.set('.profile-carousel__button', { autoAlpha: 1, yPercent: 0, y: 0, pointerEvents: "auto" });
  } else if (teamProfileStage && profileSection && teamSection) {
    gsap.set(profileSection, { pointerEvents: "none" });
    gsap.set('.profile-card-wrap', { yPercent: 135, y: () => designPx(200, 'y'), opacity: 0.42 });
    gsap.set('.profile-carousel__button', { autoAlpha: 0, yPercent: 135, y: () => designPx(100, 'y'), pointerEvents: "none" });

    let profileRevealStarted = false;
    let profileTimeline;
    profileTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: teamSection,
        endTrigger: profileSection,
        start: 'top top',
        end: 'bottom 50%',
        scrub: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          if (profileRevealStarted) return;

          if (self.progress > 0.72) {
            profileRevealStarted = true;
            profileSection.style.pointerEvents = "auto";
            gsap.set('.profile-carousel__button', {
              pointerEvents: "auto",
            });
            gsap.to('.profile-card-wrap', {
              yPercent: 0,
              y: 0,
              opacity: 1,
              duration: 0.62,
              ease: "power3.out",
              overwrite: true,
            });
            gsap.to('.profile-carousel__button', {
              autoAlpha: 1,
              yPercent: 0,
              y: 0,
              duration: 0.62,
              ease: "power3.out",
            });
            profileTimeline.kill();
            return;
          }

          profileSection.style.pointerEvents = self.progress > 0.72 ? "auto" : "none";
          gsap.set('.profile-carousel__button', {
            pointerEvents: self.progress > 0.72 ? "auto" : "none",
          });
        },
      }
    });

    profileTimeline.to('.profile-card-wrap', {
      yPercent: 0,
      y: 0,
      opacity: 1,
      duration: 0.28,
      ease: 'none',
    }, 0.72);

    profileTimeline.to('.profile-carousel__button', {
      autoAlpha: 1,
      yPercent: 0,
      y: 0,
      duration: 0.28,
      ease: 'none',
    }, 0.72);
  }

  if (isDevScroll && devReadout && teamProfileStage) {
    devReadout.classList.add("is-visible");

    const updateDevReadout = () => {
      const stageRect = teamProfileStage.getBoundingClientRect();
      const scrollableDistance = Math.max(teamProfileStage.offsetHeight - window.innerHeight, 1);
      const stageProgress = Math.min(Math.max((-stageRect.top) / scrollableDistance, 0), 1);

      if (devScrollValue) {
        devScrollValue.textContent = `${Math.round(window.scrollY)}px`;
      }

      if (devStageValue) {
        devStageValue.textContent = `${Math.round(stageProgress * 100)}%`;
      }

      if (devHeightValue) {
        devHeightValue.textContent = `${Math.round(teamProfileStage.offsetHeight)}px`;
      }
    };

    updateDevReadout();
    window.addEventListener("scroll", updateDevReadout, { passive: true });
    window.addEventListener("quienes:viewportchange", updateDevReadout);

    if (!mobileViewport.matches) {
      ScrollTrigger.create({
        trigger: teamProfileStage,
        start: "top top",
        end: "bottom bottom",
        markers: {
          startColor: "#be572a",
          endColor: "#be572a",
          fontSize: "12px",
          indent: 20,
        },
        id: "team-profile-stage",
      });

      ScrollTrigger.create({
        trigger: ".team-section",
        endTrigger: teamProfileStage,
        start: "top top",
        end: "bottom 50%",
        markers: {
          startColor: "#3b959e",
          endColor: "#3b959e",
          fontSize: "11px",
          indent: 36,
        },
        id: "team-section",
      });

      ScrollTrigger.create({
        trigger: ".profile-section",
        start: "top top",
        end: "bottom 50%",
        markers: {
          startColor: "#d2892d",
          endColor: "#d2892d",
          fontSize: "11px",
          indent: 52,
        },
        id: "profile-section",
      });
    }

    ScrollTrigger.refresh();
  }
</script>
</html>
