    <script>
      const storyStack = document.getElementById('story-stack');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const revealBackgroundLayers = () => {
        if (!storyStack) return;
        if (prefersReducedMotion.matches) { storyStack.classList.add('is-bg-revealed'); return; }
        requestAnimationFrame(() => {
          setTimeout(() => { storyStack.classList.add('is-bg-revealed'); }, 140);
        });
      };
      if (document.readyState === 'complete') { revealBackgroundLayers(); }
      else { window.addEventListener('load', revealBackgroundLayers, { once: true }); }
    </script>

    <script>
      gsap.registerPlugin(ScrollTrigger);

      const textarea = document.getElementById('comentarios');
      const charCount = document.getElementById('charCount');
      if (textarea && charCount) {
        textarea.addEventListener('input', () => {
          charCount.textContent = `${textarea.value.length}/500 caracteres`;
        });
      }

      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.fromTo('#heroHeading',
        { opacity: 0, x: -70 },
        { opacity: 1, x: 0, duration: 1 }
      ).fromTo('#formWrap',
        { opacity: 0, x: 70 },
        { opacity: 1, x: 0, duration: 1 },
        '-=0.7'
      );

      gsap.to('#formCard', {
        y: -14,
        duration: 2.8,
        ease: 'sine.inOut',
        yoyo: true,
        repeat: -1,
      });

      gsap.to('.hand--left', {
        y: -80,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top bottom', end: 'bottom top', scrub: 1.2 },
      });
      gsap.to('.hand--right', {
        y: 80,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top bottom', end: 'bottom top', scrub: 1.2 },
      });

      (function initMarquee() {
        const track = document.getElementById('facesTrack');
        if (!track) return;
        const halfWidth = track.scrollWidth / 2;
        gsap.set(track, { x: 0 });
        gsap.to(track, {
          x: -halfWidth,
          duration: 30,
          ease: 'none',
          repeat: -1,
          modifiers: {
            x: function(x) {
              const v = parseFloat(x) % halfWidth;
              return v + 'px';
            }
          }
        });
      })();

      gsap.fromTo('#socialHeading',
        { opacity: 0, y: 40 },
        { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
          scrollTrigger: { trigger: '#socialHeading', start: 'top 82%' } }
      );
      gsap.fromTo('#socialLinks .social-link',
        { opacity: 0, x: -24 },
        { opacity: 1, x: 0, duration: 0.55, stagger: 0.15, ease: 'power2.out',
          scrollTrigger: { trigger: '#socialLinks', start: 'top 85%' } }
      );
      gsap.fromTo('#photoGrid .photo-item',
        { opacity: 0, scale: 0.82, y: 28 },
        { opacity: 1, scale: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'back.out(1.5)',
          scrollTrigger: { trigger: '#photoGrid', start: 'top 82%' } }
      );
      gsap.fromTo('#ctaRow .cta-btn',
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.55, stagger: 0.12, ease: 'back.out(1.4)',
          scrollTrigger: { trigger: '#ctaRow', start: 'top 88%' } }
      );
    </script>
  </body>
