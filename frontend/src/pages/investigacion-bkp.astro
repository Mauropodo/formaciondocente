---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
---

<BaseLayout title="La Investigación">
  <section class="page-hero section">
    <div class="container text-center">
      <h1 id="page-title">La Investigación</h1>
      <p id="page-subtitle" class="text-lg">"Susurros del aula: Historias que nos encuentran" es un proyecto de investigación que indaga en las experiencias de formación inicial docente y su impacto en la construcción de la identidad profesional, a través de las voces y relatos de quienes protagonizan el aula.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="text-center">Metodología</h2>
      <div class="grid-3" id="metodologia">
        {[
          { t: "Enfoque", d: "Investigación cualitativa con enfoque biográfico-narrativo. Buscamos comprender los significados que las docentes en formación construyen sobre su experiencia educativa y su identidad profesional." },
          { t: "Participantes", d: "Estudiantes de pedagogía de diversas universidades del país, en distintos momentos de su formación inicial. Sus relatos son la materia prima de esta investigación." },
          { t: "Resultados", d: "Identificación de categorías emergentes como la vocación, la frustración, el acompañamiento, la reflexión crítica y la transformación personal como ejes de la identidad docente." },
        ].map(item => (
          <div class="card methodology-card">
            <h3>{item.t}</h3>
            <p>{item.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="text-center">Cronología del Estudio</h2>
      <Timeline items={[
        { year: "2019", title: "Revisión bibliográfica", description: "Identificación de vacíos en la literatura sobre identidad profesional docente y formación inicial en Chile." },
        { year: "2020", title: "Diseño del estudio", description: "Definición del marco metodológico con enfoque biográfico-narrativo. Selección de instrumentos y participantes." },
        { year: "2021", title: "Recolección de datos", description: "Realización de entrevistas en profundidad, grupos focales y talleres de narrativas autobiográficas." },
        { year: "2022", title: "Análisis de resultados", description: "Codificación y análisis temático de relatos. Identificación de patrones y categorías emergentes sobre identidad docente." },
        { year: "2023", title: "Publicación y difusión", description: "Publicación de hallazgos en revistas indexadas. Presentación en congresos nacionales e internacionales." },
      ]} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container text-center">
      <h2>Publicaciones Relacionadas</h2>
      <p class="text-lg">Conoce los artículos, reflexiones y relatos que han surgido de esta investigación. Cada publicación recoge una parte del camino recorrido.</p>
      <a href="/publicaciones" class="btn btn-primary">Ver todas las publicaciones</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { fadeInUp, staggerItems } from "../utils/gsap";
  fadeInUp(document.getElementById("page-title"));
  fadeInUp(document.getElementById("page-subtitle"), 0.2);
  staggerItems(document.getElementById("metodologia"));
</script>

<style>
  .page-hero { padding-bottom: 0; }
  .text-center { text-align: center; }
  .text-lg { max-width: 700px; margin: 0 auto var(--gap-lg); }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap-lg); }
  .methodology-card { padding: var(--gap-lg); }
  .methodology-card h3 {
    color: var(--color-primary);
    font-family: var(--font-ui);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.9rem;
    margin-bottom: var(--gap-md);
  }
  .methodology-card p { font-size: 0.95rem; margin: 0; }
  @media (max-width: 768px) { .grid-3 { grid-template-columns: 1fr; } }
</style>
