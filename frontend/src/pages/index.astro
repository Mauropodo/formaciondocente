<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const heroSlides = Array.from(document.querySelectorAll(".hero-slide"));
  const menu = document.getElementById("navbar");
  const navToggle = document.getElementById("nav-toggle");
  const navPanel = menu?.querySelector(".panel");
  const mobileMenuQuery = window.matchMedia("(max-width: 900px)");
  const heroSection = document.querySelector(".hero");
  const heroCopy = document.querySelector(".hero-copy");
  const heroSlider = document.querySelector(".hero-slider");
  const heroNodes = Array.from(document.querySelectorAll(".hero-copy, .hero-slider, .scroll-hint"));
  const heroBridge = document.querySelector(".hero-bridge");
  const heroBridgeCopy = document.querySelector(".hero-bridge__copy");
  const storyStack = document.querySelector(".story-stack");
  const storyBg = document.querySelector(".bg");
  const bgFallback = document.querySelector(".bg-fallback");
  const bgFallbackImage = bgFallback?.querySelector("img[data-bg-fallback-src]");
  const bgSVGs = Array.from(document.querySelectorAll(".bg-shape svg"));
  const bgFreezeLayer = document.querySelector(".bg-freeze-layer");
  const connectSection = document.querySelector(".connect");
  const connectContent = document.querySelector(".connect .content");

  const connectBubbles = Array.from(document.querySelectorAll(".connect .bubble--quote"));
  const voicesSection = document.querySelector(".voices");
  const questionStory = document.querySelector(".question-story");
  const questionPromptPanel = document.querySelector(".question-story__panel--prompt");
  const questionFollowupPanel = document.querySelector(".question-story__panel--followup");
  const questionPromptFloat = document.querySelector(".question-story__prompt-float");
  const questionPromptFloatSecondary = document.querySelector(".question-story__prompt-float-secondary");
  const mainFloatSVG = document.querySelector(".question-story__float-shape--main");
  const mainFloatPath = mainFloatSVG?.querySelector("path");
  const greenFloatSVG = document.querySelector(".question-story__float-shape--green");
  const grayFloatSVG = document.querySelector(".question-story__float-shape--gray");
  const isDevScroll = new URLSearchParams(window.location.search).get("dev") === "1";
  const devReadout = document.querySelector("[data-dev-readout]");
  const devScrollValue = document.querySelector("[data-dev-scroll]");
  const devHeroValue = document.querySelector("[data-dev-hero]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const narrowViewport = window.matchMedia("(max-width: 900px)");
  const BG_REVEAL_DELAY_MS = 140;
  const BG_LAYER_DURATION_MS = 1250;
  const BG_LAST_LAYER_DELAY_MS = 780;
  const clamp01 = (value) => Math.min(Math.max(value, 0), 1);
  const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
  const mm = gsap.matchMedia();
  const rootStyle = document.documentElement;
  const DESIGN_VIEWPORT = Object.freeze({ width: 1902, height: 910 });
  const DESKTOP_BREAKPOINT = 901;
  const initialDevicePixelRatio = window.devicePixelRatio;
  let viewportMode = window.innerWidth < DESKTOP_BREAKPOINT ? "mobile" : "desktop";
  let viewportMetrics = {
    width: window.innerWidth,
    height: window.innerHeight,
    scaleX: 1,
    scaleY: 1,
    scale: 1,
    isCompactDesktop: false,
  };
  let viewportRefreshFrame = 0;

  ScrollTrigger.config({
    autoRefreshEvents: "visibilitychange,DOMContentLoaded,load",
    ignoreMobileResize: true,
  });

  const getViewportMode = () =>
    window.innerWidth < DESKTOP_BREAKPOINT ? "mobile" : "desktop";

  const syncViewportMetrics = () => {
    const width = Math.max(window.innerWidth, document.documentElement.clientWidth, 1);
    const height = Math.max(window.innerHeight, document.documentElement.clientHeight, 1);
    const scaleX = width / DESIGN_VIEWPORT.width;
    const scaleY = height / DESIGN_VIEWPORT.height;
    const isCompactDesktop = width >= DESKTOP_BREAKPOINT && height < 800;

    viewportMetrics = {
      width,
      height,
      scaleX,
      scaleY,
      scale: Math.min(scaleX, scaleY),
      isCompactDesktop,
    };

    rootStyle.style.setProperty("--vw", `${(width * 0.01).toFixed(4)}px`);
    rootStyle.style.setProperty("--vh", `${(height * 0.01).toFixed(4)}px`);
    rootStyle.style.setProperty("--viewport-scale", viewportMetrics.scale.toFixed(5));
    rootStyle.style.setProperty("--viewport-scale-x", scaleX.toFixed(5));
    rootStyle.style.setProperty("--viewport-scale-y", scaleY.toFixed(5));
    rootStyle.style.setProperty("--is-compact-desktop", isCompactDesktop ? "1" : "0");

    if (width >= DESKTOP_BREAKPOINT) {
      const storyStackHeight = Math.max(
        designPx(3595, "y") - height * 0.7,
        height * 3.1
      );
      const heroTop = Math.max(135, 130 + 5);
      const heroStageHeight = Math.max(designPx(620, "y"), height - heroTop);

      rootStyle.style.setProperty("--story-stack-height", `${Math.round(storyStackHeight)}px`);
      rootStyle.style.setProperty("--hero-stage-height", `${Math.round(heroStageHeight)}px`);
      rootStyle.style.setProperty("--hero-bridge-stage-height", `${Math.round(designPx(655, "y"))}px`);
      rootStyle.style.setProperty("--connect-offset", `${Math.round(designPx(720, "y"))}px`);
    } else {
      rootStyle.style.removeProperty("--story-stack-height");
      rootStyle.style.removeProperty("--hero-stage-height");
      rootStyle.style.removeProperty("--hero-bridge-stage-height");
      rootStyle.style.removeProperty("--connect-offset");
    }
  };

  const designPx = (value, axis = "y") => {
    const scale = axis === "x" ? viewportMetrics.scaleX : viewportMetrics.scaleY;
    return value * scale;
  };

  const refreshViewportAnimations = () => {
    if (viewportRefreshFrame) return;

    viewportRefreshFrame = window.requestAnimationFrame(() => {
      viewportRefreshFrame = 0;
      syncViewportMetrics();
      window.dispatchEvent(new CustomEvent("inicio:viewportchange"));
      window.requestAnimationFrame(() => ScrollTrigger.refresh());
    });
  };

  let lastLayoutWidth = document.documentElement.clientWidth;
  let viewportRefreshTimer = 0;

  const handleViewportResize = (source = "window") => {
    const nextViewportMode = getViewportMode();

    // Safari puede emitir resize al mostrar u ocultar la barra de dirección.
    // El layout se actualiza sin recargar la página.
    viewportMode = nextViewportMode;

    const nextLayoutWidth = document.documentElement.clientWidth;
    const widthChanged = Math.abs(nextLayoutWidth - lastLayoutWidth) > 1;
    if (source === "visualViewport" && !widthChanged) return;
    if (source !== "orientationchange" && !widthChanged) return;

    window.clearTimeout(viewportRefreshTimer);
    viewportRefreshTimer = window.setTimeout(() => {
      lastLayoutWidth = document.documentElement.clientWidth;
      refreshViewportAnimations();
    }, 180);
  };

  syncViewportMetrics();
  window.addEventListener("resize", handleViewportResize, { passive: true });
  window.addEventListener("orientationchange", () => handleViewportResize("orientationchange"), { passive: true });
  window.visualViewport?.addEventListener("resize", () => handleViewportResize("visualViewport"), { passive: true });
  window.addEventListener("load", refreshViewportAnimations, { once: true });
  document.fonts?.ready?.then(refreshViewportAnimations);

  const setFrozenMobileViewportHeight = () => {
    if (!narrowViewport.matches) {
      rootStyle.style.removeProperty("--mobile-frozen-vh");
      return;
    }

    rootStyle.style.setProperty("--mobile-frozen-vh", `${window.innerHeight}px`);
  };

  setFrozenMobileViewportHeight();
  window.addEventListener("orientationchange", () => {
    window.setTimeout(setFrozenMobileViewportHeight, 120);
  });
  narrowViewport.addEventListener("change", setFrozenMobileViewportHeight);

  const syncMenuState = (isOpen) => {
    navPanel?.classList.toggle("open", isOpen);
    menu?.classList.toggle("open", isOpen);
    navToggle?.setAttribute("aria-expanded", String(isOpen));
    document.body.classList.toggle("nav-menu-open", isOpen && mobileMenuQuery.matches);
  };

  navToggle?.addEventListener("click", () => {
    syncMenuState(!navPanel?.classList.contains("open"));
  });

  [...(menu?.querySelectorAll(".links a") ?? []), ...(menu?.querySelectorAll(".cta") ?? [])].forEach((link) => {
    link.addEventListener("click", () => {
      syncMenuState(false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && navPanel?.classList.contains("open")) {
      syncMenuState(false);
    }
  });

  mobileMenuQuery.addEventListener("change", (event) => {
    if (!event.matches) {
      syncMenuState(false);
    } else {
      document.body.classList.toggle("nav-menu-open", navPanel?.classList.contains("open") ?? false);
    }
  });

  const getSectionProgress = (section, anticipationPx = 0) => {
    if (!section) return 0;
    const sectionRect = section.getBoundingClientRect();
    const scrollableDistance = Math.max(section.offsetHeight - window.innerHeight, 1);
    return clamp01(((-sectionRect.top) + anticipationPx) / scrollableDistance);
  };

  const loadScript = (src) =>
    new Promise((resolve, reject) => {
      const existing = document.querySelector(`script[src="${src}"]`);
      if (existing) {
        if (existing.dataset.loaded === "true") {
          resolve();
          return;
        }
        existing.addEventListener("load", () => resolve(), { once: true });
        existing.addEventListener("error", reject, { once: true });
        return;
      }

      const script = document.createElement("script");
      script.src = src;
      script.async = true;
      script.addEventListener(
        "load",
        () => {
          script.dataset.loaded = "true";
          resolve();
        },
        { once: true }
      );
      script.addEventListener("error", reject, { once: true });
      document.head.appendChild(script);
    });

  const revealBackgroundLayers = () => {
    if (!storyStack) return Promise.resolve();
    if (prefersReducedMotion.matches) {
      storyStack.classList.add("is-bg-revealed");
      return Promise.resolve();
    }

    return new Promise((resolve) => {
      window.requestAnimationFrame(() => {
        window.setTimeout(() => {
          storyStack.classList.add("is-bg-revealed");
          window.setTimeout(resolve, BG_LAST_LAYER_DELAY_MS + BG_LAYER_DURATION_MS);
        }, BG_REVEAL_DELAY_MS);
      });
    });
  };

  const activateBackgroundFallback = (reason = "unknown") => {
    if (!storyStack || !bgFallback || storyStack.classList.contains("is-bg-fallback")) return;

    if (bgFallbackImage && !bgFallbackImage.getAttribute("src")) {
      bgFallbackImage.setAttribute("src", bgFallbackImage.dataset.bgFallbackSrc || "");
    }

    storyStack.classList.add("is-bg-fallback");
    console.warn(`[inicio] Fondo SVG reemplazado por WebP (${reason}).`);
  };

  const verifyBackgroundSVG = () => {
    if (prefersReducedMotion.matches || !bgSVGs.length) return;

    const svgIsRenderable = bgSVGs.every((svg) => {
      const rect = svg.getBoundingClientRect();
      try {
        const box = svg.getBBox();
        return rect.width > 1 && rect.height > 1 && box.width > 1 && box.height > 1;
      } catch {
        return false;
      }
    });

    if (!svgIsRenderable) {
      activateBackgroundFallback("verificación de renderizado SVG");
    }
  };

  let backgroundRevealPromise;
  if (document.readyState === "complete") {
    backgroundRevealPromise = revealBackgroundLayers();
  } else {
    backgroundRevealPromise = new Promise((resolve) => {
      window.addEventListener(
        "load",
        () => {
          Promise.resolve(revealBackgroundLayers()).then(resolve);
        },
        { once: true }
      );
    });
  }

  const revealGroups = [
    { selector: ".voices h2", delay: 0 },
    { selector: ".voice-post-card", delayStep: 0.1 },
    { selector: ".voice-post-deck__more", delay: 0.25 },
  ];

  const registerIndexStyleReveals = (y, duration, ease, start) => {
    revealGroups.forEach(({ selector, delay = 0, delayStep = 0 }) => {
      gsap.utils.toArray(selector).forEach((element, index) => {
        if (prefersReducedMotion.matches) {
          gsap.fromTo(element,
            { autoAlpha: 0 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.24,
              ease: "none",
              scrollTrigger: {
                trigger: element,
                start,
                once: true,
              },
            }
          );
          return;
        }

        gsap.from(element, {
          opacity: 0,
          y,
          duration,
          ease,
          delay: delay + index * delayStep,
          scrollTrigger: {
            trigger: element,
            start,
            once: true,
          },
        });
      });
    });
  };

  mm.add("(min-width: 901px)", () => {
    registerIndexStyleReveals(50, 0.9, "power3.out", "top 88%");
  });

  mm.add("(max-width: 900px)", () => {
    registerIndexStyleReveals(30, 0.6, "power2.out", "top 92%");
  });

  if (heroBridge && heroBridgeCopy) {
    const getHeroBridgeStart = () =>
      narrowViewport.matches ? 80 : designPx(300, "y");
    const getHeroBridgeEnd = () =>
      narrowViewport.matches ? 900 : designPx(1650, "y");

    if (prefersReducedMotion.matches) {
      const setReducedHeroBridgeState = ({ bridgeVisible, copyVisible }) => {
        gsap.killTweensOf([heroBridge, heroBridgeCopy]);
        gsap.set(heroBridge, { pointerEvents: bridgeVisible ? "auto" : "none" });
        gsap.to(heroBridge, {
          autoAlpha: bridgeVisible ? 1 : 0,
          duration: 0.12,
          ease: "none",
          overwrite: true,
        });
        gsap.to(heroBridgeCopy, {
          autoAlpha: copyVisible ? 1 : 0,
          duration: 0.16,
          ease: "none",
          overwrite: true,
        });
      };

      gsap.set(heroBridge, { autoAlpha: 0, pointerEvents: "none", clearProps: "transform" });
      gsap.set(heroBridgeCopy, { autoAlpha: 0, clearProps: "transform" });

      let reducedHeroBridgeState = "hidden";
      let reducedHeroBridgeFrame = 0;
      const reducedHeroBridgeHideProgress = 0.4;
      const syncReducedHeroBridge = () => {
        if (reducedHeroBridgeFrame) return;

        reducedHeroBridgeFrame = window.requestAnimationFrame(() => {
          reducedHeroBridgeFrame = 0;
          const stackTop = storyStack.getBoundingClientRect().top + window.scrollY;
          const localScroll = window.scrollY - stackTop;
          const start = Number(getHeroBridgeStart());
          const end = Number(getHeroBridgeEnd());
          const progress = Math.min(Math.max((localScroll - start) / Math.max(end - start, 1), 0), 1);
          const connectReachedHalfViewport =
            connectSection && connectSection.getBoundingClientRect().top <= window.innerHeight * 0.5;
          const nextState =
            !connectReachedHalfViewport &&
              progress >= 0.08 &&
              progress < reducedHeroBridgeHideProgress
                ? "bridge-and-copy"
                : "hidden";

          if (nextState === reducedHeroBridgeState) return;
          reducedHeroBridgeState = nextState;
          setReducedHeroBridgeState({
            bridgeVisible: nextState !== "hidden",
            copyVisible: nextState === "bridge-and-copy",
          });
        });
      };

      syncReducedHeroBridge();
      window.addEventListener("scroll", syncReducedHeroBridge, { passive: true });
      window.addEventListener("resize", syncReducedHeroBridge, { passive: true });
      window.addEventListener("orientationchange", syncReducedHeroBridge, { passive: true });
      window.addEventListener("inicio:viewportchange", syncReducedHeroBridge);
    } else {
      gsap.set(heroBridge, { autoAlpha: 0 });
      gsap.set(heroBridgeCopy, { autoAlpha: 0 });

      const heroBridgeTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: storyStack,
          start: getHeroBridgeStart,
          end: getHeroBridgeEnd,
          scrub: 1,
          invalidateOnRefresh: true,
        },
      });

      heroBridgeTimeline
        .to(heroBridge, { autoAlpha: 1, duration: 0.18, ease: "none" }, 0.08)
        .to(heroBridgeCopy, { autoAlpha: 1, duration: 0.24, ease: "none" }, 0.12)
        .to(heroBridgeCopy, { autoAlpha: 0, duration: 0.2, ease: "none" }, 0.76)
        .to(heroBridge, { autoAlpha: 0, duration: 0.16, ease: "none" }, 0.8);
    }
  }

  if (heroSlides.length > 1) {
    let current = 0;
    const showSlide = (index) => {
      heroSlides.forEach((slide, slideIndex) => {
        slide.classList.toggle("is-active", slideIndex === index);
        slide.classList.toggle("is-second", slideIndex === (index + 1) % heroSlides.length);
        slide.style.zIndex = slideIndex === index ? "2" : slideIndex === (index + 1) % heroSlides.length ? "1" : "0";
      });
    };
    showSlide(current);
    setInterval(() => {
      current = (current + 1) % heroSlides.length;
      showSlide(current);
    }, 3800);
  }

  if (storyStack && heroNodes.length) {
    const heroState = {
      copyEntrance: prefersReducedMotion.matches ? 1 : 0,
      sliderEntrance: prefersReducedMotion.matches ? 1 : 0,
      scrollOpacity: 1,
    };

    const readOffset = (node, propertyName) => {
      if (!node) return 0;
      const value = window.getComputedStyle(node).getPropertyValue(propertyName);
      return Number.parseFloat(value) || 0;
    };

    const renderHero = () => {
      if (menu) {
        const menuOffsetY = readOffset(menu, "--enter-y");
        const menuOpacity = heroState.copyEntrance;
        menu.style.opacity = String(menuOpacity);
        menu.style.transform = `translate3d(0, ${(menuOffsetY * (1 - heroState.copyEntrance)).toFixed(2)}px, 0)`;
      }

      if (heroCopy) {
        const copyOffsetX = readOffset(heroCopy, "--enter-x");
        const copyOffsetY = readOffset(heroCopy, "--enter-y");
        const copyOpacity = heroState.copyEntrance * heroState.scrollOpacity;

        heroCopy.style.opacity = String(copyOpacity);
        heroCopy.style.transform = `translate3d(${(copyOffsetX * (1 - heroState.copyEntrance)).toFixed(2)}px, ${(copyOffsetY * (1 - heroState.copyEntrance)).toFixed(2)}px, 0)`;
      }

      if (heroSlider) {
        const sliderOffsetX = readOffset(heroSlider, "--enter-x");
        const sliderOffsetY = readOffset(heroSlider, "--enter-y");
        const sliderOpacity = heroState.sliderEntrance * heroState.scrollOpacity;

        heroSlider.style.opacity = String(sliderOpacity);
        heroSlider.style.transform = `translate3d(${(sliderOffsetX * (1 - heroState.sliderEntrance)).toFixed(2)}px, ${(sliderOffsetY * (1 - heroState.sliderEntrance)).toFixed(2)}px, 0)`;
      }

      const scrollHint = document.querySelector(".scroll-hint");
      if (scrollHint) {
        scrollHint.style.opacity = String(heroState.scrollOpacity);
      }
    };

    const animateHeroEntrance = () => {
      if (prefersReducedMotion.matches) {
        heroState.copyEntrance = 1;
        heroState.sliderEntrance = 1;
        renderHero();
        return;
      }

      const startTime = performance.now();
      const copyDuration = 720;
      const sliderDelay = 300;
      const sliderDuration = 720;

      const step = (now) => {
        const elapsed = now - startTime;
        heroState.copyEntrance = Math.min(elapsed / copyDuration, 1);
        heroState.sliderEntrance = Math.min(Math.max((elapsed - sliderDelay) / sliderDuration, 0), 1);

        renderHero();

        if (heroState.copyEntrance < 1 || heroState.sliderEntrance < 1) {
          window.requestAnimationFrame(step);
        }
      };

      window.requestAnimationFrame(step);
    };

    const updateHeroFade = () => {
      if (narrowViewport.matches) {
        const stackTop = storyStack.offsetTop;
        const mobileFadeDistance = 300;
        const progress = clamp01((window.scrollY - stackTop) / mobileFadeDistance);
        heroState.scrollOpacity = 1 - progress;
        renderHero();
        return;
      }

      const stackTop = storyStack.offsetTop;
      const fadeDistance = designPx(300, "y");
      const progress = clamp01((window.scrollY - stackTop) / fadeDistance);
      heroState.scrollOpacity = 1 - progress;
      renderHero();
    };

    Promise.resolve(backgroundRevealPromise).then(() => {
      if (!prefersReducedMotion.matches) {
        window.setTimeout(verifyBackgroundSVG, 260);
      }
      updateHeroFade();
      animateHeroEntrance();
      window.addEventListener("scroll", updateHeroFade, { passive: true });
      window.addEventListener("inicio:viewportchange", updateHeroFade);
    });
  }

  if (connectSection && connectContent && connectBubbles.length) {
    const connectMotionState = {
      initialOffsets: [],
      visibleOffsets: [],
      initialScale: [],
      visibleScale: [],
      visibleOpacity: [],
      cleanup: null,
    };

    const bubbleOrder = ["green", "teal", "coral", "orange"];
    const bubbleTargets = {
      green: { centerX: 0.228, centerY: 0.270, scaleAdjust: 0.8 },
      teal: { centerX: 0.614, centerY: 0.612, scaleAdjust: 0.8 },
      coral: { centerX: 0.263, centerY: 0.607, scaleAdjust: 0.8 },
      orange: { centerX: 0.614, centerY: 0.293, scaleAdjust: 0.8 },
    };

    const getBubbleOrderIndex = (bubble) => {
      const foundIndex = bubbleOrder.findIndex((className) => bubble.classList.contains(className));
      return foundIndex === -1 ? 0 : foundIndex;
    };

    const getBubbleKey = (bubble) =>
      bubbleOrder.find((className) => bubble.classList.contains(className)) || "green";

    const getConnectScale = (contentRect) => {
      const widthProgress = clamp01((contentRect.width - 900) / 380);
      const heightProgress = clamp01((contentRect.height - 700) / 220);
      const spaciousness = Math.min(1, widthProgress * 0.7 + heightProgress * 0.3);
      return 0.84 + spaciousness * 0.16;
    };

    const setupConnectMotion = () => {
      connectMotionState.initialOffsets = connectBubbles.map((bubble) => ({
        x: parseFloat(bubble.style.getPropertyValue("--bubble-shift-x")) || 0,
        y: parseFloat(bubble.style.getPropertyValue("--bubble-shift-y")) || 0,
      }));
      connectMotionState.initialScale = connectBubbles.map(() => 1);

      const contentRect = connectContent.getBoundingClientRect();
      const baseScale = getConnectScale(contentRect);

      connectMotionState.visibleOffsets = connectBubbles.map((bubble) => {
        const bubbleKey = getBubbleKey(bubble);
        const target = bubbleTargets[bubbleKey] || bubbleTargets.green;
        const scale = baseScale * target.scaleAdjust;
        const baseWidth = bubble.offsetWidth;
        const baseHeight = bubble.offsetHeight;
        const scaledWidth = baseWidth * scale;
        const scaledHeight = baseHeight * scale;
        const baseCenterX = bubble.offsetLeft + baseWidth / 2;
        const baseCenterY = bubble.offsetTop + baseHeight / 2;
        const targetCenterX = contentRect.width * target.centerX;
        const targetCenterY = contentRect.height * target.centerY;

        return {
          x: targetCenterX - (baseCenterX + (scaledWidth - baseWidth) / 2),
          y: targetCenterY - (baseCenterY + (scaledHeight - baseHeight) / 2),
        };
      });
      connectMotionState.visibleScale = connectBubbles.map((bubble) => {
        const bubbleKey = getBubbleKey(bubble);
        const target = bubbleTargets[bubbleKey] || bubbleTargets.green;
        return baseScale * target.scaleAdjust;
      });
      connectMotionState.visibleOpacity = connectBubbles.map((bubble) => {
        if (bubble.classList.contains("orange")) {
          return 0.995925;
        }
        return 1;
      });
    };

    const updateConnectMotion = () => {
      if (prefersReducedMotion.matches) {
        connectSection.classList.add("is-active");

        connectBubbles.forEach((bubble, index) => {
          const finalOffset = narrowViewport.matches
            ? { x: 0, y: 0 }
            : (connectMotionState.visibleOffsets[index] || { x: 0, y: 0 });
          const finalScale = narrowViewport.matches
            ? 1
            : (connectMotionState.visibleScale[index] ?? 1);
          const visibleOpacity = connectMotionState.visibleOpacity[index] ?? 1;
          bubble.style.setProperty("--bubble-shift-x", `${finalOffset.x.toFixed(2)}px`);
          bubble.style.setProperty("--bubble-shift-y", `${finalOffset.y.toFixed(2)}px`);
          bubble.style.setProperty("--bubble-scale", `${finalScale.toFixed(4)}`);
          bubble.style.opacity = String(visibleOpacity);
        });
        return;
      }

      if (narrowViewport.matches) {
        connectSection.classList.add("is-active");

        connectBubbles.forEach((bubble) => {
          bubble.style.setProperty("--bubble-shift-x", "0px");
          bubble.style.setProperty("--bubble-shift-y", "0px");
          bubble.style.setProperty("--bubble-scale", "1");
        });
        return;
      }

      const revealScrollStart = connectSection.getBoundingClientRect().top + window.scrollY;
      const revealScrollEnd = revealScrollStart + designPx(950, "y");
      const sectionProgress = clamp01(
        (window.scrollY - revealScrollStart) / Math.max(revealScrollEnd - revealScrollStart, 1)
      );
      const revealStart = 0;
      const revealEnd = 1;
      const revealSpan = Math.max(revealEnd - revealStart, 0.001);
      const revealSegment = revealSpan / connectBubbles.length;

      connectSection.classList.toggle("is-active", sectionProgress >= revealStart);

      connectBubbles.forEach((bubble, index) => {
        const orderedIndex = getBubbleOrderIndex(bubble);
        const initX = connectMotionState.initialOffsets[index]?.x || 0;
        const initY = connectMotionState.initialOffsets[index]?.y || 0;
        const visibleX = connectMotionState.visibleOffsets[index]?.x || 0;
        const visibleY = connectMotionState.visibleOffsets[index]?.y || 0;
        const initScale = connectMotionState.initialScale[index] ?? 1;
        const visibleScale = connectMotionState.visibleScale[index] ?? 1;
        const visibleOpacity = connectMotionState.visibleOpacity[index] ?? 1;
        const bubbleAppearStart = revealStart + orderedIndex * revealSegment;
        const bubbleAppearEnd = bubbleAppearStart + revealSegment;
        const appearProgress = clamp01((sectionProgress - bubbleAppearStart) / Math.max(bubbleAppearEnd - bubbleAppearStart, 0.001));
        const appeared = easeOutCubic(appearProgress);
        const currentX = initX + (visibleX - initX) * appeared;
        const currentY = initY + (visibleY - initY) * appeared;
        const currentScale = initScale + (visibleScale - initScale) * appeared;

        bubble.style.setProperty("--bubble-shift-x", `${currentX.toFixed(2)}px`);
        bubble.style.setProperty("--bubble-shift-y", `${currentY.toFixed(2)}px`);
        bubble.style.setProperty("--bubble-scale", `${currentScale.toFixed(4)}`);
        bubble.style.opacity = String(visibleOpacity * appeared);
      });
    };

    let connectScrollBound = false;

    const handleResize = () => {
      setupConnectMotion();
      updateConnectMotion();
      syncConnectMotionListeners();
    };

    const syncConnectMotionListeners = () => {
      if (narrowViewport.matches) {
        if (connectScrollBound) {
          window.removeEventListener("scroll", updateConnectMotion);
          connectScrollBound = false;
        }
        return;
      }

      if (!connectScrollBound) {
        window.addEventListener("scroll", updateConnectMotion, { passive: true });
        connectScrollBound = true;
      }
    };

    setupConnectMotion();
    updateConnectMotion();
    syncConnectMotionListeners();
    window.addEventListener("inicio:viewportchange", handleResize);
    narrowViewport.addEventListener("change", syncConnectMotionListeners);

    connectMotionState.cleanup = () => {
      if (connectScrollBound) {
        window.removeEventListener("scroll", updateConnectMotion);
      }
      window.removeEventListener("inicio:viewportchange", handleResize);
      narrowViewport.removeEventListener("change", syncConnectMotionListeners);
    };

    mm.add("(max-width: 900px) and (prefers-reduced-motion: no-preference)", () => {
      const mobileBubbleDirections = {
        green: -120,
        orange: 120,
        coral: -120,
        teal: 120,
      };
      const mobileBubbleTimelines = [];

      connectSection.classList.add("is-active");

      connectBubbles.forEach((bubble) => {
        const bubbleKey = getBubbleKey(bubble);
        const startX = mobileBubbleDirections[bubbleKey] ?? -120;
        const bubbleText = bubble.querySelector(".bubble-text");
        const bubbleMarks = bubble.querySelectorAll(".bubble-mark");

        gsap.set(bubble, { xPercent: startX, autoAlpha: 0 });
        if (bubbleText) {
          gsap.set(bubbleText, { x: startX > 0 ? 28 : -28, autoAlpha: 0 });
        }
        if (bubbleMarks.length) {
          gsap.set(bubbleMarks, { autoAlpha: 0 });
        }

        const bubbleTimeline = gsap.timeline({
          defaults: { ease: "power3.out" },
          scrollTrigger: {
            trigger: bubble,
            start: "top center",
            toggleActions: "play none none reverse",
            invalidateOnRefresh: true,
          },
        });

        bubbleTimeline.to(bubble, {
          xPercent: 0,
          autoAlpha: 1,
          duration: 0.62,
        });

        if (bubbleText) {
          bubbleTimeline.to(
            bubbleText,
            {
              x: 0,
              autoAlpha: 1,
              duration: 0.38,
            },
            "<+=0.10"
          );
        }

        if (bubbleMarks.length) {
          bubbleTimeline.to(
            bubbleMarks,
            {
              autoAlpha: 1,
              duration: 0.24,
              stagger: 0.04,
            },
            "<"
          );
        }

        mobileBubbleTimelines.push(bubbleTimeline);
      });

      return () => {
        mobileBubbleTimelines.forEach((timeline) => {
          timeline.scrollTrigger?.kill();
          timeline.kill();
        });
        connectBubbles.forEach((bubble) => {
          const bubbleText = bubble.querySelector(".bubble-text");
          const bubbleMarks = bubble.querySelectorAll(".bubble-mark");
          gsap.set(bubble, { clearProps: "xPercent,opacity,visibility" });
          if (bubbleText) {
            gsap.set(bubbleText, { clearProps: "x,opacity,visibility" });
          }
          if (bubbleMarks.length) {
            gsap.set(bubbleMarks, { clearProps: "opacity,visibility" });
          }
        });
      };
    });
  }

  if (storyStack && storyBg && bgFreezeLayer && voicesSection && questionStory) {
    const ensureFreezeBackground = () => {
      if (bgFreezeLayer.dataset.ready === "true") return;

      const freezeContent = document.createElement("div");
      freezeContent.className = "bg-freeze-content";
      freezeContent.innerHTML = storyBg.innerHTML;
      bgFreezeLayer.appendChild(freezeContent);
      bgFreezeLayer.dataset.ready = "true";
    };

    const updateQuestionStoryHandoff = () => {
      if (prefersReducedMotion.matches || narrowViewport.matches) {
        questionStory.classList.remove("is-handoff-active");
        questionStory.style.setProperty("--question-handoff-y", "0%");
        questionStory.style.setProperty("--question-handoff-opacity", "1");
        bgFreezeLayer.classList.remove("is-active");
        bgFreezeLayer.style.removeProperty("--bg-freeze-offset");
        return;
      }

      ensureFreezeBackground();

      const voicesRect = voicesSection.getBoundingClientRect();
      const questionRect = questionStory.getBoundingClientRect();
      const overlapProgress = clamp01((window.innerHeight - voicesRect.bottom) / Math.max(window.innerHeight, 1));
      const handoffProgress = easeOutCubic(overlapProgress);
      const handoffIsActive = questionRect.top > 0 && overlapProgress > 0;

      questionStory.style.setProperty("--question-handoff-y", `${((1 - handoffProgress) * 100).toFixed(2)}%`);
      questionStory.style.setProperty("--question-handoff-opacity", handoffProgress.toFixed(4));
      questionStory.classList.toggle("is-handoff-active", handoffIsActive);

      if (handoffIsActive) {
        const bgOffset = storyStack.getBoundingClientRect().top;
        bgFreezeLayer.style.setProperty("--bg-freeze-offset", `${bgOffset.toFixed(2)}px`);
        bgFreezeLayer.classList.add("is-active");
      } else {
        bgFreezeLayer.classList.remove("is-active");
        bgFreezeLayer.style.removeProperty("--bg-freeze-offset");

        if (questionRect.top <= 0) {
          questionStory.style.setProperty("--question-handoff-y", "0%");
          questionStory.style.setProperty("--question-handoff-opacity", "1");
        } else {
          questionStory.style.setProperty("--question-handoff-y", "100%");
          questionStory.style.setProperty("--question-handoff-opacity", "0");
        }
      }
    };

    let questionHandoffScrollBound = false;

    const syncQuestionHandoffListeners = () => {
      if (narrowViewport.matches) {
        if (questionHandoffScrollBound) {
          window.removeEventListener("scroll", updateQuestionStoryHandoff);
          questionHandoffScrollBound = false;
        }
        return;
      }

      if (!questionHandoffScrollBound) {
        window.addEventListener("scroll", updateQuestionStoryHandoff, { passive: true });
        questionHandoffScrollBound = true;
      }
    };

    updateQuestionStoryHandoff();
    syncQuestionHandoffListeners();
    window.addEventListener("inicio:viewportchange", updateQuestionStoryHandoff);
    narrowViewport.addEventListener("change", syncQuestionHandoffListeners);
  }

  if (questionStory && questionPromptPanel && questionFollowupPanel && questionPromptFloat && questionPromptFloatSecondary && mainFloatSVG && mainFloatPath && greenFloatSVG && grayFloatSVG) {
    const mainFloatPathStart = mainFloatPath.getAttribute("d");
    const translateMainFloatPathX = (shift) => {
      const xIndexes = { M: [0], L: [0], C: [0, 2, 4], H: [0] };

      return mainFloatPathStart.replace(/([MLCHVZ])([^MLCHVZ]*)/g, (match, command, values) => {
        if (!xIndexes[command]) return match;

        const numbers = values.match(/-?\d*\.?\d+/g)?.map(Number) ?? [];
        const translated = numbers.map((value, index) => {
          if (!xIndexes[command].includes(index) || value === -300) return value;
          return Number((value + shift).toFixed(3));
        });

        return `${command}${translated.join(" ")}`;
      });
    };
    const getMainFloatPathStart = ({ targetPosition = window.innerWidth * 0.05, edge = "min" } = {}) => {
      const xIndexes = { M: [0], L: [0], C: [0, 2, 4], H: [0] };
      let movingMinX = Infinity;
      let movingMaxX = -Infinity;

      mainFloatPathStart.replace(/([MLCHVZ])([^MLCHVZ]*)/g, (match, command, values) => {
        if (!xIndexes[command]) return match;

        const numbers = values.match(/-?\d*\.?\d+/g)?.map(Number) ?? [];
        numbers.forEach((value, index) => {
          if (xIndexes[command].includes(index) && value !== -300) {
            movingMinX = Math.min(movingMinX, value);
            movingMaxX = Math.max(movingMaxX, value);
          }
        });
        return match;
      });

      const scale = mainFloatSVG.getBoundingClientRect().height / mainFloatSVG.viewBox.baseVal.height;
      const safeScale = Math.max(scale, 0.01);
      const movingEdgeX = edge === "max" ? movingMaxX : movingMinX;
      const movingEdgePosition = mainFloatSVG.getBoundingClientRect().left
        + (movingEdgeX - mainFloatSVG.viewBox.baseVal.x) * safeScale;
      const shift = (targetPosition - movingEdgePosition) / safeScale;

      return translateMainFloatPathX(shift);
    };

    mm.add("(prefers-reduced-motion: reduce)", () => {
      const isMobile = narrowViewport.matches;
      const reducedPromptCopy = questionPromptPanel.querySelector("[data-question-copy]");
      const reducedFollowupCopy = questionFollowupPanel.querySelector("[data-question-next-copy]");
      const reducedFollowupFloat = questionPromptFloatSecondary.cloneNode(true);
      reducedFollowupFloat.className = "question-story__followup-float";
      reducedFollowupFloat.setAttribute("aria-hidden", "true");
      questionFollowupPanel.prepend(reducedFollowupFloat);
      const reducedGreenFloat = reducedFollowupFloat.querySelector(".question-story__float-shape--green");
      const reducedGrayFloat = reducedFollowupFloat.querySelector(".question-story__float-shape--gray");

      gsap.set([questionPromptPanel, questionFollowupPanel], {
        autoAlpha: 1,
        pointerEvents: "auto",
      });
      gsap.set([reducedPromptCopy, reducedFollowupCopy], {
        autoAlpha: 1,
        clearProps: "visibility",
      });
      gsap.set(questionPromptPanel, {
        autoAlpha: 1,
        visibility: "visible",
        pointerEvents: "auto",
      });
      gsap.set(reducedPromptCopy, {
        autoAlpha: 1,
        opacity: 1,
        visibility: "visible",
      });
      gsap.set(mainFloatSVG, { x: -20 });
      gsap.set(mainFloatPath, { attr: { d: mainFloatPathStart } });
      gsap.set(questionPromptFloat, {
        xPercent: isMobile ? -21 : 0,
        x: 0,
        left: 0,
      });
      gsap.set(questionPromptFloatSecondary, {
        autoAlpha: 0,
        left: 0,
      });
      gsap.set(greenFloatSVG, {
        autoAlpha: 0,
      });
      gsap.set(grayFloatSVG, {
        autoAlpha: 0,
      });
      gsap.set(reducedFollowupFloat, {
        x: isMobile ? 32 : designPx(200, "x"),
        autoAlpha: 1,
        left: 0,
      });
      gsap.set(reducedGreenFloat, {
        xPercent: isMobile ? -92 : -80,
        autoAlpha: 1,
      });
      gsap.set(reducedGrayFloat, {
        xPercent: isMobile ? -96 : -90,
        autoAlpha: 1,
      });

      return () => {
        gsap.set([questionPromptPanel, questionFollowupPanel], { clearProps: "all" });
        gsap.set(mainFloatPath, { attr: { d: mainFloatPathStart } });
        gsap.set([
          mainFloatSVG,
          questionPromptFloat,
          questionPromptFloatSecondary,
          greenFloatSVG,
          grayFloatSVG,
        ], { clearProps: "all" });
        reducedFollowupFloat.remove();
      };
    });

    mm.add("(min-width: 901px) and (prefers-reduced-motion: no-preference)", () => {
      gsap.set(mainFloatSVG, { x: -20 });
      gsap.set(mainFloatPath, { attr: { d: getMainFloatPathStart() } });
      gsap.set(questionPromptFloat, { x: 0 });
      gsap.set(greenFloatSVG, { xPercent: -180, opacity: 0 });
      gsap.set(grayFloatSVG, { xPercent: -180, opacity: 0 });
      gsap.set(questionFollowupPanel, { autoAlpha: 0 });

      const promptTimeline = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: questionStory,
          start: "top top",
          end: () => `+=${Math.round(designPx(2500, "y"))}`,
          scrub: 1,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      promptTimeline.to(mainFloatPath, { attr: { d: mainFloatPathStart } }, 0);
      promptTimeline.fromTo(
        questionPromptFloatSecondary,
        { x: () => designPx(-1400, "x") },
        { x: () => designPx(200, "x") },
        0.60
      );
      promptTimeline.to(greenFloatSVG, { xPercent: -80, opacity: 1, duration: 0.2 }, 0.60);
      promptTimeline.to(grayFloatSVG, { xPercent: -90, opacity: 1, duration: 0.2 }, 0.60);
      promptTimeline.to(questionFollowupPanel, { autoAlpha: 1 }, 0.65);

      return () => {
        promptTimeline.scrollTrigger?.kill();
        promptTimeline.kill();
        gsap.set(mainFloatPath, { attr: { d: mainFloatPathStart } });
        gsap.set(mainFloatSVG, { clearProps: "all" });
        gsap.set(greenFloatSVG, { clearProps: "all" });
        gsap.set(grayFloatSVG, { clearProps: "all" });
        gsap.set(questionPromptFloat, { clearProps: "all" });
        gsap.set(questionPromptFloatSecondary, { clearProps: "all" });
        gsap.set(questionFollowupPanel, { clearProps: "all" });
      };
    });

    mm.add("(max-width: 900px) and (prefers-reduced-motion: no-preference)", () => {
      gsap.set(mainFloatSVG, { x: -20 });
      gsap.set(questionPromptFloat, { xPercent: -21, x: 0 });
      gsap.set(mainFloatPath, { attr: { d: getMainFloatPathStart({ targetPosition: -10, edge: "max" }) } });
      gsap.set(greenFloatSVG, { xPercent: -175, opacity: 0 });
      gsap.set(grayFloatSVG, { xPercent: -175, opacity: 0 });
      gsap.set(questionPromptFloatSecondary, { x: -window.innerWidth * 1.15 });
      gsap.set(questionFollowupPanel, { autoAlpha: 0 });

      const promptTimelineMobile = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: questionStory,
          start: "top top",
          end: "+=1700",
          scrub: 1,
          pin: true,
          pinSpacing: true,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      promptTimelineMobile.to(mainFloatPath, { attr: { d: mainFloatPathStart } }, 0);
      promptTimelineMobile.fromTo(
        questionPromptFloatSecondary,
        { x: -window.innerWidth * 1.15 },
        { x: 32 },
        0.58
      );
      promptTimelineMobile.to(greenFloatSVG, { xPercent: -92, opacity: 1, duration: 0.18 }, 0.58);
      promptTimelineMobile.to(grayFloatSVG, { xPercent: -96, opacity: 1, duration: 0.18 }, 0.58);
      promptTimelineMobile.to(questionFollowupPanel, { autoAlpha: 1 }, 0.63);

      return () => {
        promptTimelineMobile.scrollTrigger?.kill();
        promptTimelineMobile.kill();
        gsap.set(mainFloatPath, { attr: { d: mainFloatPathStart } });
        gsap.set(mainFloatSVG, { clearProps: "all" });
        gsap.set(greenFloatSVG, { clearProps: "all" });
        gsap.set(grayFloatSVG, { clearProps: "all" });
        gsap.set(questionPromptFloat, { clearProps: "all" });
        gsap.set(questionPromptFloatSecondary, { clearProps: "all" });
        gsap.set(questionFollowupPanel, { clearProps: "all" });
      };
    });
  }

  if (document.querySelector("#socialHeading")) {
    gsap.fromTo("#socialHeading",
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out",
        scrollTrigger: { trigger: "#socialHeading", start: "top 82%" } }
    );
    gsap.fromTo("#socialLinks .social-link",
      { opacity: 0, x: -24 },
      { opacity: 1, x: 0, duration: 0.55, stagger: 0.15, ease: "power2.out",
        scrollTrigger: { trigger: "#socialLinks", start: "top 85%" } }
    );
    gsap.fromTo("#photoGrid .photo-item",
      { opacity: 0, scale: 0.82, y: 28 },
      { opacity: 1, scale: 1, y: 0, duration: 0.6, stagger: 0.08, ease: "back.out(1.5)",
        scrollTrigger: { trigger: "#photoGrid", start: "top 82%" } }
    );
    gsap.fromTo("#ctaRow .cta-btn",
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 0.55, stagger: 0.12, ease: "back.out(1.4)",
        scrollTrigger: { trigger: "#ctaRow", start: "top 88%" } }
    );
  }

  if (isDevScroll && devReadout && storyStack) {
    devReadout.classList.add("is-visible");

    const updateDevReadout = () => {
      const stackTop = storyStack.offsetTop;
      const heroHeight = window.innerHeight;
      const fadeDistance = heroHeight * 0.55;
      const heroProgress = clamp01((window.scrollY - stackTop) / fadeDistance);

      if (devScrollValue) {
        devScrollValue.textContent = `${Math.round(window.scrollY)}px`;
      }

      if (devHeroValue) {
        devHeroValue.textContent = `${Math.round(heroProgress * 100)}%`;
      }
    };

    updateDevReadout();
    window.addEventListener("scroll", updateDevReadout, { passive: true });
    window.addEventListener("resize", updateDevReadout);
  }

  if (isDevScroll && storyStack) {
    Promise.all([
      loadScript("https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"),
      loadScript("https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"),
    ])
      .then(() => {
        if (!window.gsap || !window.ScrollTrigger) return;

        window.gsap.registerPlugin(window.ScrollTrigger);

        const sections = [
          [".hero", "hero"],
          [".connect", "connect"],
          [".voices", "voices"],
          [".question-story", "question-story"],
          [".social-section", "social-section"],
        ];

        window.ScrollTrigger.create({
          trigger: storyStack,
          start: "top top",
          end: "bottom bottom",
          markers: {
            startColor: "#be572a",
            endColor: "#be572a",
            fontSize: "12px",
            indent: 20,
          },
          id: "story-stack",
        });

        sections.forEach(([selector, id], index) => {
          const element = document.querySelector(selector);
          if (!element) return;

          window.ScrollTrigger.create({
            trigger: element,
            start: "top 80%",
            end: "bottom 20%",
            markers: {
              startColor: index % 2 === 0 ? "#3b959e" : "#d2892d",
              endColor: index % 2 === 0 ? "#3b959e" : "#d2892d",
              fontSize: "11px",
              indent: 20 + index * 14,
            },
            id,
          });
        });

        window.ScrollTrigger.refresh();
      })
      .catch(() => {
        console.warn("No se pudo cargar GSAP dev markers.");
      });
  }
</script>
</html>
