---
import Footer from '../components/Footer.astro';
import SeoHead from "../components/SeoHead.astro";
import SmoothScroll from "../components/SmoothScroll.astro";
import TextSizeControl from "../components/TextSizeControl.astro";
import VoicePostDeck from "../components/VoicePostDeck.astro";
import { getAllPosts } from "../services/wordpress/posts";
import brandImage from "../assets/figma-mcp/inicio/logo.png";
import heroSlideOne from "../assets/figma-mcp/inicio/hero-foto-portada.jpg";
import heroSlideTwo from "../assets/figma-mcp/inicio/hero-ilustracion-5c.jpg";
import heroSlideThree from "../assets/figma-mcp/inicio/hero-educadoras.jpg";
import cardThumb from "../assets/figma-mcp/inicio/relato-thumb.png";
// Fotos de prueba (versión anterior, por si hay que revertir):
// import galeria2 from "../assets/figma-mcp/inicio/galeria-2.png";
// import galeria3 from "../assets/figma-mcp/inicio/galeria-3.png";
// import galeria5 from "../assets/figma-mcp/inicio/galeria-5.png";
// import galeria6 from "../assets/figma-mcp/inicio/galeria-6.png";
import InstagramGallery from "../components/InstagramGallery.astro";
// import LinkedInFeed from "../components/LinkedInFeed.astro";

const voicePosts = (await getAllPosts()).slice(0, 5).map((post) => ({
  title: post.title,
  slug: post.slug,
  excerpt: post.excerpt,
  autor: post.authorName ?? undefined,
  imagen: post.imageUrl ?? undefined,
}));
// const photos = [
//   galeria2, galeria3, galeria5, galeria6, galeria2, galeria3,
// ];
const carasImages = [
  "/assets/img/home/caras-1 2.svg",
  "/assets/img/home/caras-2 2.svg",
  "/assets/img/home/caras-3 2.svg",
  "/assets/img/home/caras-4 2.svg",
  "/assets/img/home/caras-6 2.svg",
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <SeoHead
    title="Identidad Profesional Docente en Educación Parvularia"
    description="Proyecto Fondecyt de Iniciación sobre la construcción de la identidad profesional docente en la formación práctica de educación parvularia en Chile."
    path="/"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Inter:wght@400;500;600;700&family=Inconsolata:wght@400;700;900&family=Playfair+Display:wght@400;500;600;700&family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet">
  <script is:inline>
    (() => {
      const isIOS = /iP(ad|hone|od)/.test(navigator.platform) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      if (isIOS && /AppleWebKit/.test(navigator.userAgent)) {
        document.documentElement.classList.add('mobile-webkit');
      }
    })();
  </script>
  <style>
    :root {
      --bg: #f9f5f2;
      --bg-soft: #f4ebe6;
      --paper: #eee2d9;
      --text: #620404;
      --text-soft: #514444;
      --primary: #be572a;
      --accent: #d2892d;
      --teal: #3b959e;
      --orange: #c36438;
      --green: #8bc5ae;
      --shadow-paper: 0 1px 0 rgba(255,255,255,.6) inset, 0 12px 26px rgba(76,54,43,.14), 0 3px 10px rgba(76,54,43,.08);
      --shadow-deep: 0 14px 34px rgba(76,54,43,.18);
      --nav-h: 130px;
      --radius: 24px;
      --vw: 1vw;
      --vh: 1vh;
      --viewport-scale: 1;
      --viewport-scale-x: 1;
      --viewport-scale-y: 1;
      --is-compact-desktop: 0;
      --story-stack-height: 3595px;
      --hero-stage-height: 100svh;
      --hero-bridge-stage-height: 100svh;
      --hero-top: max(135px, calc(var(--nav-h) + 5px));
      --mobile-frozen-vh: 100vh;
      --connect-offset: 0px;
      --connect-mobile-offset: 0px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Open Sans", sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .page {
      position: relative;
      min-height: 100vh;
      isolation: isolate;
    }
    .layout {
      position: relative;
      z-index: 1;
      width: 100%;
    }
    .story-stack {
      position: relative;
      min-height: var(--story-stack-height);
      overflow: clip;
      background: var(--bg);
    }
    .bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      background: #fff;
      overflow: hidden;
      pointer-events: none;
    }
    .bg-fallback {
      position: absolute;
      inset: 0;
      z-index: 0;
      opacity: 0;
      visibility: hidden;
      overflow: hidden;
      background: #f9f4f1;
    }
    .bg-fallback img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
      object-position: center top;
    }
    .story-stack.is-bg-fallback .bg-fallback {
      opacity: 1;
      visibility: visible;
    }
    .story-stack.is-bg-fallback .bg-shape {
      opacity: 0 !important;
      visibility: hidden;
      animation: none !important;
    }
    .bg-freeze-layer {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
    }
    .bg-freeze-layer.is-active {
      opacity: 1;
      visibility: visible;
    }
    .bg-freeze-content {
      position: absolute;
      inset: 0;
      height: var(--story-stack-height);
      transform: translate3d(0, var(--bg-freeze-offset, 0px), 0);
    }
    .bg-freeze-content .bg-shape {
      position: absolute;
      inset: 0;
      opacity: 1;
      transform: translate3d(0, 0, 0);
      animation: none !important;
    }
    .bg-shape {
      position: absolute;
      inset: 0;
      /* Keep the SVG layers hidden until the entrance sequence starts. */
      opacity: 0;
      transform: none;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }
    .bg-shape svg {
      width: 100%;
      height: 100%;
      display: block;
      user-select: none;
      pointer-events: none;
      overflow: visible;
    }
    .story-stack.is-bg-revealed .bg-shape {
      animation: bgLayerEnter 1.25s cubic-bezier(.2,.75,.18,1) forwards;
    }
    .story-stack.is-bg-revealed .bg-shape--1 { animation-delay: 0.12s; }
    .story-stack.is-bg-revealed .bg-shape--2 { animation-delay: 0.34s; }
    .story-stack.is-bg-revealed .bg-shape--3 { animation-delay: 0.56s; }
    .story-stack.is-bg-revealed .bg-shape--4 { animation-delay: 0.78s; }
    @keyframes bgLayerEnter {
      0% {
        opacity: 0;
        transform: translate3d(-9vw, 0, 0);
      }
      100% {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }
    .menu {
      --enter-y: -18px;
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 40;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 0 max(16px, calc((100vw - 1200px) / 2));
      min-height: var(--nav-h);
      pointer-events: none;
      opacity: 0;
      transform: translate3d(0, var(--enter-y), 0);
      will-change: opacity, transform;
    }
    .menu .brand {
      width: 130px;
      height: 130px;
      flex: 0 0 auto;
      pointer-events: auto;
      overflow: clip;
      border-radius: 100px;
    }
    .menu .panel {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 25px;
      padding: 10px 28px;
      background: #f9f5f2;
      border-radius: 0 0 12.8px 12.8px;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
      transform: translateX(-2px);
      margin-top: 0;
      min-width: 0;
      width: max-content;
    }
    .menu .dev-readout {
      display: none;
      align-items: center;
      gap: 10px;
      margin-left: 18px;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(98, 4, 4, 0.08);
      color: var(--text);
      font-family: Inconsolata, monospace;
      font-size: 13px;
      line-height: 1;
      white-space: nowrap;
    }
    .menu .dev-readout strong {
      font-weight: 900;
      color: var(--primary);
    }
    .menu .dev-readout.is-visible {
      display: inline-flex;
    }
    .links {
      display: flex;
      align-items: center;
      gap: 25px;
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      color: #000;
      white-space: nowrap;
    }
    .links li a { transition: opacity 0.2s ease; }
    .links li a:hover { opacity: 0.7; }
.cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
      padding: 12px 27px;
      border-radius: 48px;
      border: none;
      background: var(--accent);
      color: #eee2d9;
      font-family: Inconsolata, monospace;
      font-weight: 900;
  box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
}

    .hero {
      position: sticky;
      top: 0;
      min-height: var(--hero-stage-height);
      width: min(100%, 1200px);
      margin: 0 auto;
      padding: var(--hero-top) 16px 0;
      overflow: clip;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(440px, 586px);
      align-items: center;
      column-gap: clamp(24px, 4vw, 56px);
      z-index: 2;
    }
    .hero-copy {
      --enter-x: -40px;
      --enter-y: -10px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 10px;
      align-self: center;
      transform: translate3d(var(--enter-x), var(--enter-y), 0);
      opacity: 0;
      max-width: 690px;
    }
    .hero h1 {
      margin: 0;
      font-family: "Playfair Display", serif;
      font-size: clamp(2.4rem, 3.5vw, 44.8px);
      line-height: 1.05;
      text-transform: uppercase;
      color: var(--text);
      max-width: 690px;
      text-wrap: balance;
    }
    .hero .eyebrow {
      margin: 0;
      font-family: "Red Hat Display", sans-serif;
      text-transform: uppercase;
      letter-spacing: 5.4px;
      font-size: 20px;
      color: var(--text);
    }
    .hero-slider {
      --enter-x: 40px;
      --enter-y: -10px;
      position: relative;
      width: 100%;
      max-width: 586px;
      aspect-ratio: 11 / 8;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      justify-self: center;
      transform: translate3d(var(--enter-x), var(--enter-y), 0);
      opacity: 0;
    }
    .hero-media {
      grid-column: 2;
      width: 100%;
      max-width: 586px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-self: center;
      align-self: center;
    }
    .hero-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 6.5px 9.8px 4.9px rgba(0,0,0,.15), 0 3.3px 3.3px rgba(0,0,0,.3);
      opacity: 0;
      transition: opacity 700ms ease, transform 700ms ease;
      will-change: opacity, transform;
      pointer-events: none;
      object-fit: cover;
      object-position: center;
    }
    .hero-slide.is-active {
      opacity: 1;
      transform: rotate(-2deg) translateZ(0);
      z-index: 2;
    }
    .hero-slide.is-second {
      opacity: 1;
      transform: rotate(1deg) translate(18px, 16px) scale(0.98);
      z-index: 1;
      filter: saturate(0.98) brightness(0.98);
    }
    .scroll-hint {
      position: fixed;
      right: clamp(18px, 3vw, 48px);
      bottom: clamp(22px, 4vh, 48px);
      width: max-content;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      font-family: Inconsolata, monospace;
      font-size: clamp(15px, 1.35vw, 20px);
      font-weight: 700;
      color: var(--text);
      line-height: 1.2;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      pointer-events: none;
      opacity: 0;
      transform: none;
      margin: 0;
      z-index: 20;
    }
    .scroll-hint > span:first-child {
      display: block;
      width: min(100%, 240px);
      text-align: right;
    }
    .scroll-hint__rail {
      position: relative;
      width: 2px;
      height: 42px;
      margin-right: 11px;
      overflow: hidden;
      background: rgba(22, 22, 22, 0.18);
    }
    .scroll-hint__rail::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--primary);
      transform: translateY(-105%);
      animation: scrollHintRail 1.8s cubic-bezier(.22,.61,.36,1) infinite;
    }
    .scroll-hint__arrow {
      width: 24px;
      height: 13px;
      animation: scrollHintArrow 1.8s cubic-bezier(.22,.61,.36,1) infinite;
      will-change: transform, opacity;
    }
    @keyframes scrollHintRail {
      0% { transform: translateY(-105%); }
      55%, 100% { transform: translateY(105%); }
    }
    @keyframes scrollHintArrow {
      0%, 100% { opacity: 0.35; transform: translateY(-3px); }
      55% { opacity: 1; transform: translateY(3px); }
    }
    .hero-bridge {
      position: fixed;
      inset: 0;
      z-index: 3;
      width: 100%;
      margin: 0 auto;
      min-height: 100svh;
      padding: clamp(24px, 4vw, 40px);
      display: grid;
      place-items: center;
      isolation: isolate;
      overflow: clip;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
    }
    @media (min-width: 901px) {
      :root {
        --story-stack-height: calc(3595px - 70svh);
        --hero-stage-height: 90svh;
        --hero-bridge-stage-height: 72svh;
        --connect-offset: 720px;
      }
    }
    .hero-bridge::after {
      content: "";
      position: absolute;
      width: clamp(180px, 22vw, 320px);
      height: clamp(180px, 22vw, 320px);
      right: clamp(12px, 3vw, 48px);
      top: clamp(12px, 2vw, 26px);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(124, 124, 74, 0.18) 0%, rgba(124, 124, 74, 0.08) 42%, rgba(124, 124, 74, 0) 72%);
      z-index: -1;
      pointer-events: none;
    }
    .hero-bridge__copy {
      max-width: 760px;
      margin: 0;
      padding: clamp(24px, 3.2vw, 34px) clamp(24px, 4vw, 48px);
      border-radius: clamp(26px, 4vw, 40px);
      font-family: "Playfair Display", serif;
      font-size: clamp(1.45rem, 2.6vw, 2.2rem);
      line-height: 1.5;
      text-align: center;
      color: rgba(98, 4, 4, 0.96);
      text-wrap: balance;
      background: linear-gradient(180deg, rgb(255 255 255 / 78%), rgb(255 255 255 / 67%));
      border: 2px solid #620404;
      box-shadow: 10px 12px #620404, 0 18px 28px #00000029;
      transform: translate3d(0, calc(28px - 12vh), 0);
      opacity: 0;
    }
    .connect {
      position: relative;
      min-height: 220svh;
      width: 100%;
      margin: var(--connect-offset) 0 0;
      overflow: clip;
      padding: 0 clamp(16px, 3vw, 32px);
      z-index: 2;
      pointer-events: none;
    }
    .connect.is-active {
      pointer-events: auto;
    }
    .connect .content {
      position: sticky;
      top: 0;
      width: min(100%, 1280px);
      height: 100svh;
      min-height: 620px;
      margin: 0 auto;
    }
    .bubble {
      position: relative;
      padding: 54px 40px 54px;
      color: white;
      border-radius: 92px;
      min-height: 310px;
      box-shadow: var(--shadow-paper);
      overflow: hidden;
    }
    .bubble::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -18px;
      width: 62px;
      height: 42px;
      transform: translateX(-50%) rotate(8deg);
      background: inherit;
      clip-path: polygon(48% 0, 100% 45%, 74% 100%, 0 42%);
      filter: drop-shadow(0 4px 8px rgba(0,0,0,.12));
    }
    .bubble h2, .bubble p { position: relative; z-index: 1; margin: 0; }
    .bubble h2 {
      font-family: "Playfair Display", serif;
      font-size: 28.8px;
      margin-bottom: 18px;
      line-height: 1.1;
    }
    .bubble p {
      font-family: Inconsolata, monospace;
      font-size: 17.6px;
      line-height: 1.35;
    }
    .bubble.teal { background: var(--teal); }
    .bubble.orange { background: #de8b21; }
    .bubble.coral { background: var(--orange); }
    .bubble--quote {
      background: none;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
      isolation: isolate;
      padding: 0;
      color: #111;
    }
    .bubble--quote.orange {
      background: none;
    }
    .bubble--quote.orange .bubble-text {
      color: #fff;
      transform: rotate(2deg);
    }
    .bubble--quote.orange .bubble-mark {
      color: #fff;
    }
    .bubble--quote.coral {
      background: none;
    }
    .bubble--quote.coral .bubble-text,
    .bubble--quote.coral .bubble-mark {
      color: #fff;
    }
    .bubble--quote.coral .bubble-text {
      transform: rotate(5deg);
    }
    .bubble--quote.teal {
      background: none;
    }
    .bubble--quote.teal .bubble-text,
    .bubble--quote.teal .bubble-mark {
      color: #fff;
    }
    .bubble--quote .bubble-shape {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      transform: rotate(0deg);
      transform-origin: center;
    }
    .bubble--quote .bubble-shape svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      filter: drop-shadow(0 4px 15.3px rgba(0, 0, 0, 0.25));
    }
    .bubble--quote .bubble-quote {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4.6rem 4.2rem;
      transform: rotate(0deg);
      transform-origin: center;
    }
    .bubble--quote .bubble-text {
      margin: 0;
      max-width: 80%;
      font-family: "Open Sans", sans-serif;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-align: center;
      text-wrap: balance;
      color: #111;
      align-self: center;
      transform: rotate(-3deg);
      transform-origin: center;
    }
    .bubble--quote .bubble-mark {
      position: absolute;
      z-index: 2;
      font-family: "Playfair Display", serif;
      font-size: 5.4rem;
      line-height: 0.7;
      color: #5b4747;
      pointer-events: none;
      user-select: none;
    }
    .bubble--quote .bubble-mark--open {
      top: 1.25rem;
      left: 3.1rem;
    }
    .bubble--quote .bubble-mark--close {
      right: 3.2rem;
      bottom: 3.2rem;
    }
    .connect .bubble {
      position: absolute;
    }
    .connect .bubble--quote {
      --bubble-shift-x: 0px;
      --bubble-shift-y: 0px;
      --bubble-position-offset-x: 0%;
      --bubble-rotate: 0deg;
      --bubble-scale: 1;
      opacity: 0;
      transform: translate3d(calc(var(--bubble-shift-x) + var(--bubble-position-offset-x)), var(--bubble-shift-y), 0) rotate(var(--bubble-rotate)) scale(var(--bubble-scale));
      will-change: transform, opacity;
    }
    @media (min-width: 901px) {
      .connect .bubble--quote.green,
      .connect .bubble--quote.coral {
        --bubble-position-offset-x: 2%;
      }
      .connect .bubble--quote.orange,
      .connect .bubble--quote.teal {
        --bubble-position-offset-x: -2%;
      }
      .bubble--quote .bubble-mark--open {
        top: 3.25rem;
        left: 3.1rem;
      }
      .bubble--quote .bubble-mark--close {
        right: 4.2rem;
        bottom: 5.2rem;
      }
    }
    .connect .bubble.green {
      left: 0;
      top: -6px;
      width: 558px;
      aspect-ratio: 589 / 370;
      min-height: 0;
    }
    .connect .bubble.orange {
      right: 0;
      top: 0;
      width: 558px;
      aspect-ratio: 589 / 370;
      min-height: 0;
    }
    .connect .content > article.bubble.orange:not(.bubble--quote) {
      display: none;
    }
    .connect .bubble.coral {
      left: 0;
      bottom: 14px;
      width: 558px;
      aspect-ratio: 591 / 379;
      min-height: 0;
    }
    .connect .content > article.bubble.coral:not(.bubble--quote) {
      display: none;
    }
    .connect .bubble.teal {
      right: 0;
      bottom: 0;
      width: 558px;
      aspect-ratio: 590 / 375;
      min-height: 0;
    }
    .connect .content > article.bubble.teal:not(.bubble--quote) {
      display: none;
    }
    .voices {
      position: relative;
      min-height: 1064px;
      padding: 10px 10px 150px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 71px;
      overflow: clip;
      z-index: 3;
    }
    .voices h2,
    .question h2 {
      margin: 0;
      font-family: "Playfair Display", serif;
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      text-transform: uppercase;
      color: var(--primary);
      text-align: center;
      line-height: 1.05;
    }
    .cards {
      position: relative;
      width: min(1216px, 100%);
      height: 410px;
    }
    .voice-card {
      position: absolute;
      width: 544px;
