---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contacto">
  <section class="page-hero section">
    <div class="container text-center">
      <h1 id="page-title">Contacto</h1>
      <p id="page-subtitle" class="text-lg">Charlemos y compartamos también a través de nuestras redes. Queremos escuchar tus experiencias, reflexiones y preguntas sobre la formación docente.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="contact-social" id="contact-social">
        <h2 class="text-center">Conéctate con nosotros</h2>
        <div class="social-links-row">
          <a href="https://linkedin.com" class="social-link-card" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a href="https://instagram.com" class="social-link-card" target="_blank" rel="noopener noreferrer">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/></svg>
            <span>Instagram</span>
          </a>
          <a href="mailto:contacto@susurrosdelaula.cl" class="social-link-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2m0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <span>contáctanos</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info" id="contact-info">
          <div class="info-item">
            <h3>Correo electrónico</h3>
            <p>contacto@susurrosdelaula.cl</p>
          </div>
          <div class="info-item">
            <h3>Redes sociales</h3>
            <p>Síguenos en LinkedIn e Instagram para estar al tanto de nuevas publicaciones, eventos y convocatorias.</p>
          </div>
          <div class="info-item">
            <h3>Ubicación</h3>
            <p>Proyecto FONDECYT · Santiago, Chile</p>
          </div>
          <div class="info-item">
            <h3>Horarios</h3>
            <p>Lunes a viernes de 9:00 a 18:00 hrs</p>
          </div>
        </div>
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="text-center">Galería</h2>
      <div class="gallery-grid" id="gallery">
        {[1, 2, 3, 4, 5, 6].map(i => (
          <div class="gallery-item" style={`background: linear-gradient(135deg, var(--color-primary-${200 + (i % 3) * 100}), var(--color-tertiary-${300 - (i % 3) * 100}))`}></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { fadeInUp, staggerItems } from "../utils/gsap";
  fadeInUp(document.getElementById("page-title"));
  fadeInUp(document.getElementById("page-subtitle"), 0.2);
  staggerItems(document.getElementById("contact-info"), 0.1);
  staggerItems(document.getElementById("gallery"), 0.08);
</script>

<style>
  .page-hero { padding-bottom: 0; }
  .text-center { text-align: center; }
  .text-lg { max-width: 650px; margin: 0 auto; }

  .contact-social { margin-bottom: var(--gap-lg); }
  .contact-social h2 { margin-bottom: var(--gap-lg); }
  .social-links-row {
    display: flex;
    justify-content: center;
    gap: var(--gap-lg);
    flex-wrap: wrap;
  }
  .social-link-card {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: var(--gap-md) var(--gap-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.95rem;
    transition: var(--transition);
    box-shadow: var(--shadow-sm);
  }
  .social-link-card:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .social-link-card svg { width: 22px; height: 22px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-xl);
    align-items: start;
  }
  .info-item {
    margin-bottom: var(--gap-lg);
    padding: var(--gap-lg);
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
  }
  .info-item h3 { color: var(--color-primary); font-size: 1rem; margin-bottom: var(--gap-sm); }
  .info-item p { margin: 0; font-size: 0.9rem; color: var(--color-text-secondary); }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-md);
    max-width: 900px;
    margin: 0 auto;
  }
  .gallery-item {
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .social-link-card { width: 100%; justify-content: center; }
  }
</style>
