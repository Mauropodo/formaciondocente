---
import Footer from '../components/Footer.astro';
import brandImage from "../assets/figma-mcp/inicio/logo.png";

const TAGS = [
  { bg: "#3b959e",  text: "white"   },
  { bg: "#f9f5f2",  text: "#161616" },
  { bg: "#204d50",  text: "white"   },
  { bg: "#f0a443",  text: "white"   },
  { bg: "#95b3a7",  text: "white"   },
];

const ROW1_IDX = [0, 1, 2, 3, 4, 1, 3, 0, 1, 2, 3, 4, 1, 3];
const ROW2_IDX = [3, 4, 0, 2, 4, 1, 2, 3, 4, 0, 2, 4, 1, 2];
const ROW3_IDX = [3, 1, 3, 0, 1, 4, 0, 3, 1, 3, 0, 1, 4, 0];

const doubled1 = [...ROW1_IDX, ...ROW1_IDX];
const doubled2 = [...ROW2_IDX, ...ROW2_IDX];
const doubled3 = [...ROW3_IDX, ...ROW3_IDX];

const ACHIEVEMENTS = [
  { bold: "Dirección de 3 proyectos",    rest: " de investigación con financiamiento público." },
  { bold: "Ponente internacional",        rest: " en más de 10 congresos de salud mental." },
  { bold: "Premio Nacional",              rest: " a la Investigación Psicológica Destacada." },
  { bold: "Desarrollo de un modelo",      rest: " de intervención clínica validado." },
];

const BUBBLE_PATH = "M11.44 101.04C11.44 50.2298 52.6298 9.04 103.44 9.04H463.44C514.25 9.04 555.44 50.2298 555.44 101.04V184.215C555.44 235.025 514.25 276.215 463.44 276.215H419.44H376.473C360.082 276.215 343.989 280.594 329.858 288.898L260.865 329.446C260.426 329.704 259.927 329.84 259.418 329.84C257.259 329.84 255.881 327.536 256.903 325.634L269.042 303.027C275.553 290.901 266.77 276.215 253.006 276.215H103.44C52.6298 276.215 11.44 235.025 11.44 184.215V101.04Z";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>¿Quiénes Somos? | Parvularias</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inconsolata:wght@400;700;900&family=Playfair+Display:wght@400;500;600;700&family=Red+Hat+Display:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f9f5f2;
      --bg-soft: #f4ebe6;
      --paper: #eee2d9;
      --text: #620404;
      --text-soft: #514444;
      --primary: #be572a;
      --accent: #d2892d;
      --teal: #3b959e;
      --orange: #c36438;
      --green: #8bc5ae;
      --nav-h: 161px;
      --radius: 24px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: #fff;
      color: var(--text);
      font-family: Inter, sans-serif;
      line-height: 1.5;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    .page {
      position: relative;
      min-height: 100vh;
      isolation: isolate;
    }

    .menu {
      --enter-y: -18px;
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 40;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 0 max(16px, calc((100vw - 1200px) / 2));
      min-height: var(--nav-h);
      pointer-events: none;
    }
    .menu .brand {
      width: 161px;
      height: 161px;
      flex: 0 0 auto;
      pointer-events: auto;
      overflow: clip;
      border-radius: 100px;
    }
    .menu .panel {
      pointer-events: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 12.8px 50.4px;
      background: #f9f5f2;
      border-radius: 0 0 12.8px 12.8px;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
      transform: translateX(-2px);
      margin-top: 0;
      min-width: min(100%, 735px);
    }
    .links {
      display: flex;
      align-items: center;
      gap: 25px;
      list-style: none;
      padding: 0;
      margin: 0;
      font-family: Inconsolata, monospace;
      font-size: 16px;
      color: #000;
      white-space: nowrap;
    }
    .links li a { transition: opacity 0.2s ease; }
    .links li a:hover { opacity: 0.7; }
    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 27px;
      border-radius: 48px;
      border: none;
      background: var(--accent);
      color: #eee2d9;
      font-family: Inconsolata, monospace;
      font-weight: 900;
      box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
    }
    .cta:hover { color: #eee2d9; filter: brightness(0.98); }

    /* ── Quiénes Somos sections ── */

    .qs-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }
    .qs-bg svg {
      position: absolute;
      top: 0;
      height: 100%;
    }

    .qs-hero {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 80px 0 60px;
      background: #fff;
    }
    .qs-hero__content {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: center;
      gap: clamp(3rem, 10vw, 200px);
      padding: 0 clamp(2rem, 10vw, 260px);
      width: 100%;
    }

    .fondecyt {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
    }
    .fondecyt__label {
      position: relative;
      z-index: 20;
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      font-size: 28.8px;
      color: white;
      white-space: nowrap;
      margin-bottom: 1rem;
    }
    .fondecyt__bubbles {
      position: relative;
      width: min(561px, 82vw);
      height: 363px;
    }
    .bubble-q {
      position: absolute;
      pointer-events: none;
    }
    .bubble-q--orange {
      width: 98%; height: 321px;
      bottom: -83px;
      left: 50%;
      transform: translateX(calc(-50% - 117px)) rotate(2deg);
      z-index: 0;
      filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
    }
    .bubble-q--copper {
      width: 100%; height: 321px;
      bottom: 86px;
      left: 50%;
      transform: translateX(calc(-50% + 161px)) rotate(175deg) scaleY(-1);
      z-index: 1;
      filter: drop-shadow(8.8px 11.2px 6.12px rgba(0,0,0,0.23)) drop-shadow(0px 3.2px 1.6px rgba(0,0,0,0.25));
    }

    .qs-bubble {
      position: absolute;
      inset: 0;
      z-index: 3;
      isolation: isolate;
      width: 100%;
      aspect-ratio: 589 / 370;
      min-height: 0;
    }
    .qs-bubble .bubble-shape {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .qs-bubble .bubble-shape svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      filter: drop-shadow(0 4px 15.3px rgba(0,0,0,0.25));
    }
    .qs-bubble .bubble-quote {
      position: absolute;
      inset: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4.6rem 4.2rem;
    }
    .qs-bubble .bubble-text {
      margin: 0;
      max-width: 80%;
      font-family: Inconsolata, monospace;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.18;
      letter-spacing: 0.01em;
      text-align: center;
      text-wrap: balance;
      color: #111;
      align-self: center;
      transform: rotate(-3deg);
    }
    .qs-bubble .bubble-mark {
      position: absolute;
      z-index: 2;
      font-family: "Playfair Display", serif;
      font-size: 5.4rem;
      line-height: 0.7;
      color: #5b4747;
      pointer-events: none;
      user-select: none;
    }
    .qs-bubble .bubble-mark--open {
      top: 3.25rem;
      left: 4.1rem;
    }
    .qs-bubble .bubble-mark--close {
      right: 5.2rem;
      bottom: 4.2rem;
    }

    .colaboran {
      flex-shrink: 0;
      width: 235px;
      height: 185px;
      margin-top: 120px;
    }
    .colaboran img { width: 100%; height: 100%; object-fit: cover; }

    .team-section {
      position: relative;
      width: 100%;
      min-height: 100vh;
      overflow: hidden;
      background: #214d4f;
    }

    .marquee-row {
      position: absolute;
      left: -10%;
      width: 120%;
    }
    .marquee-row--1 { top: 31%; transform: rotate(5deg);     z-index: 2; }
    .marquee-row--2 { top: 44%; transform: rotate(5deg);     z-index: 2; }
    .marquee-row--3 { top: 37%; transform: rotate(-7.34deg); z-index: 2; }

    .marquee-track {
      display: flex;
      align-items: center;
      gap: 34px;
      width: max-content;
    }
    .name-tag {
      display: flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
      height: 57px;
      padding: 0 20px;
      border-radius: 11.885px;
      border: 2.377px solid rgba(255,255,255,0.25);
      font-family: 'Inter', sans-serif;
      font-size: 22px;
      font-weight: 400;
      flex-shrink: 0;
    }

    .team-title {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 8vh;
      z-index: 10;
    }
    .team-title h2 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(22px, 2.8vw, 44.8px);
      text-transform: uppercase;
      color: white;
      white-space: nowrap;
      margin: 0;
    }

    .profile-section {
      position: relative;
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 80px 2%;
      background: transparent;
    }
    .profile-container {
      position: relative;
      width: min(1096px, 96vw);
      height: min(640px, 58vw);
    }
    .profile-card-wrap {
      position: absolute;
      height: 100%;
    }
    .profile-card-wrap--left   { left: 4.1%;  top: 4%;    width: 35.5%; height: 92%; z-index: 5; }
    .profile-card-wrap--center { left: 30.3%; top: -1.1%; width: 39.5%; height: 100%; z-index: 10; }
    .profile-card-wrap--right  { left: 60.4%; top: 4%;    width: 35.5%; height: 92%; z-index: 5; }

    .profile-card {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: #eee2d9;
      border-radius: 38px;
      padding: 24px 0 20px;
      box-shadow: 7px 9px 5px rgba(0,0,0,0.23), 0px 2.6px 1.3px rgba(0,0,0,0.25), 1.9px 2.6px 0px rgba(0,0,0,0.25), -1.3px 2.6px 1.3px rgba(0,0,0,0.4);
    }
    .profile-card--left,
    .profile-card--right { transform: rotate(2deg); }
    .profile-card--center { transform: rotate(-2deg); }

    .profile-card__photo {
      position: relative;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      flex-shrink: 0;
    }
    .profile-card--left .profile-card__photo,
    .profile-card--right .profile-card__photo { width: 68%; }
    .profile-card--center .profile-card__photo { width: 72%; }

    .profile-card__photo-inner {
      transform: rotate(175deg) scaleY(-1);
      width: 100%; height: 100%;
    }
    .profile-card__photo-inner img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .profile-card__name {
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      color: #620404;
      text-align: center;
      width: 100%;
      margin-top: 20px;
      line-height: 1;
    }
    .profile-card--left .profile-card__name,
    .profile-card--right .profile-card__name { font-size: clamp(14px, 1.4vw, 23.3px); }
    .profile-card--center .profile-card__name { font-size: clamp(16px, 1.6vw, 25.9px); }

    .profile-card__list {
      width: 100%;
      padding: 0 10%;
      margin-top: 20px;
      list-style: disc;
      margin-left: 4px;
      padding-left: calc(10% + 16px);
    }
    .profile-card--left .profile-card__list li,
    .profile-card--right .profile-card__list li { font-size: clamp(8px, 0.7vw, 11.3px); }
    .profile-card--center .profile-card__list li { font-size: clamp(9px, 0.8vw, 12.6px); }

    .profile-card__list li {
      margin-bottom: 8px;
      line-height: 1.6;
    }
    .profile-card__list li:last-child { margin-bottom: 0; }
    .profile-card__list .bold {
      font-family: 'Inter', sans-serif;
      font-weight: 700;
    }
    .profile-card__list .mono {
      font-family: 'Inconsolata', monospace;
    }

    @media (max-width: 1200px) {
      .menu { padding: 0 1rem; }
    }
    @media (max-width: 900px) {
      .menu {
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }
      .menu .panel { flex-wrap: wrap; justify-content: center; }
    }
    @media (max-width: 768px) {
      .menu {
        min-height: auto;
        padding: 12px 16px;
        flex-direction: row;
        align-items: center;
        flex-wrap: wrap;
      }
      .menu .brand {
        width: 88px;
        height: 88px;
      }
      .menu .panel {
        display: none;
        width: 100%;
        order: 3;
        background: rgba(249, 245, 242, 0.94);
        backdrop-filter: blur(10px);
        border-radius: 0 0 12.8px 12.8px;
        padding: 16px;
        gap: 16px;
        flex-direction: column;
        align-items: stretch;
        transform: none;
        min-width: auto;
        box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
      }
      .menu .panel.open {
        display: flex;
      }
      .links {
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
      }
      .cta {
        align-self: flex-start;
      }
      .qs-hero { padding-top: 140px; }
      .qs-hero__content { flex-direction: column; align-items: center; }
      .profile-container { height: auto; display: flex; flex-direction: column; gap: 24px; }
      .profile-card-wrap { position: static; width: 100% !important; height: auto !important; }
      .team-section { min-height: 60vh; }
    }

    @media (prefers-reduced-motion: reduce) {
      .marquee-track { animation: none !important; }
    }
  </style>
</head>
<body>
  <div class="page">

    <header class="menu" id="navbar">
      <a class="brand" href="/">
          <img src={brandImage.src} alt="Parvularias" />
      </a>
      <nav class="panel" aria-label="Principal">
        <ul class="links">
          <li><a href="/">Inicio</a></li>
          <li><a href="/quienes-somos">Quiénes somos</a></li>
          <li><a href="/la-investigacion">Investigación</a></li>
          <li><a href="/publicaciones">Publicaciones</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
        <a class="cta" href="/publicaciones">Relatos</a>
      </nav>
    </header>

    <div class="qs-bg" aria-hidden="true">
      <svg style="left:0; width:70%;" fill="none" viewBox="0 0 1295 3176" preserveAspectRatio="xMinYMin slice">
        <path d="M1294.3 11.3H76.2257H14.4465V3175.57C10.5922 3194.91 81.3794 3201.67 395.363 3074.06C787.843 2914.55 1252.2 2271.99 670.561 1575.93C88.9262 879.874 1039.58 376.331 1294.3 11.3Z" fill="#F9F4F1" opacity="0.32"/>
      </svg>
      <svg style="left:20%; width:80%;" fill="none" viewBox="0 0 2374 3176" preserveAspectRatio="xMinYMin slice">
        <path d="M2373.52 11.3H530.022H436.522V3175.3C430.688 3194.63 537.822 3201.4 1013.02 3073.8C1607.02 2914.3 2309.8 2271.8 1429.52 1575.8C549.243 879.8 1988.02 376.3 2373.52 11.3Z" fill="#EEE2D9" opacity="0.32"/>
      </svg>
      <svg style="left:18%; width:85%;" fill="none" viewBox="0 0 2841 3176" preserveAspectRatio="xMinYMin slice">
        <path d="M2840.3 11.3H552.604H436.575V3175.57C429.336 3194.9 562.284 3201.67 1151.98 3074.06C1889.11 2914.55 2761.22 2271.99 1668.84 1575.93C576.457 879.874 2361.91 376.331 2840.3 11.3Z" fill="#F3B568" opacity="0.32"/>
      </svg>
      <svg style="left:22%; width:90%;" fill="none" viewBox="0 0 2920 3176" preserveAspectRatio="xMinYMin slice">
        <path d="M2919.3 11.3H631.604H515.575V3175.57C508.336 3194.9 641.284 3201.67 1230.98 3074.06C1968.11 2914.55 2840.22 2271.99 1747.84 1575.93C655.457 879.874 2440.91 376.331 2919.3 11.3Z" fill="#7C7C4A" opacity="0.32"/>
      </svg>
    </div>

    <section class="qs-hero">
      <div class="qs-hero__content">
        <div class="fondecyt">
          <p class="fondecyt__label">FONDECYT</p>
          <div class="fondecyt__bubbles">
            <svg class="bubble-q bubble-q--orange" fill="none" viewBox="0 0 567 340">
              <path d={BUBBLE_PATH} fill="#F0A443"/>
            </svg>
            <svg class="bubble-q bubble-q--copper" fill="none" viewBox="0 0 567 340">
              <path d={BUBBLE_PATH} fill="#C36438"/>
            </svg>
            <article class="qs-bubble" aria-label="Cita destacada">
              <div class="bubble-shape" aria-hidden="true">
                <svg viewBox="0 0 589 370" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
                  <path d="M554.823 96.2274C552.164 45.4868 508.874 6.50922 458.134 9.16842L98.6273 28.0094C47.8868 30.6686 8.9091 73.9576 11.5683 124.698L15.9213 207.759C18.5805 258.499 61.8696 297.477 112.61 294.818L156.55 292.515L199.458 290.266C215.826 289.409 232.126 292.939 246.673 300.493L317.694 337.375C318.145 337.609 318.651 337.719 319.159 337.692C321.315 337.579 322.57 335.206 321.451 333.36L308.145 311.42C301.008 299.651 309.011 284.525 322.756 283.805L472.117 275.977C522.857 273.318 561.835 230.029 559.176 179.288L554.823 96.2274Z" fill="#83BAA4" />
                </svg>
              </div>
              <div class="bubble-quote">
                <span class="bubble-mark bubble-mark--open" aria-hidden="true">"</span>
                <p class="bubble-text">Aprendí que mi identidad profesional no se construye desde la perfección, sino desde la capacidad de reflexionar sobre mis experiencias y seguir aprendiendo incluso en medio de la incertidumbre</p>
                <span class="bubble-mark bubble-mark--close" aria-hidden="true">"</span>
              </div>
            </article>
          </div>
        </div>

        <div class="colaboran">
          <img src="/images/quienes-somos/colaboran.png" alt="Colaboran" />
        </div>
      </div>
    </section>

    <div class="team-section">
      <div class="team-title">
        <h2>EQUIPO DE INVESTIGACIÓN</h2>
      </div>
      <div class="marquee-row marquee-row--1" aria-hidden="true">
        <div class="marquee-track" id="marqueeRow1">
          {doubled1.map((idx) => (
            <div class="name-tag" style={`background:${TAGS[idx].bg}; color:${TAGS[idx].text};`}>
              Nombre Apellido
            </div>
          ))}
        </div>
      </div>

      <div class="marquee-row marquee-row--2" aria-hidden="true">
        <div class="marquee-track" id="marqueeRow2">
          {doubled2.map((idx) => (
            <div class="name-tag" style={`background:${TAGS[idx].bg}; color:${TAGS[idx].text};`}>
              Nombre Apellido
            </div>
          ))}
        </div>
      </div>

      <div class="marquee-row marquee-row--3" aria-hidden="true">
        <div class="marquee-track" id="marqueeRow3">
          {doubled3.map((idx) => (
            <div class="name-tag" style={`background:${TAGS[idx].bg}; color:${TAGS[idx].text};`}>
              Nombre Apellido
            </div>
          ))}
        </div>
      </div>

    </div>

    <section class="profile-section">
      <div class="profile-container">
        <div class="profile-card-wrap profile-card-wrap--left">
          <div class="profile-card profile-card--left">
            <div class="profile-card__photo">
              <div class="profile-card__photo-inner">
                <img src="/images/quienes-somos/profile1.png" alt="Jose Andrea Velasquez" />
              </div>
            </div>
            <p class="profile-card__name">Jose Andrea Velasquez</p>
            <ul class="profile-card__list">
              {ACHIEVEMENTS.map(a => (
                <li><span class="bold">{a.bold}</span><span class="mono">{a.rest}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="profile-card-wrap profile-card-wrap--center">
          <div class="profile-card profile-card--center">
            <div class="profile-card__photo">
              <div class="profile-card__photo-inner">
                <img src="/images/quienes-somos/profile2.png" alt="Jose Andrea Velasquez" />
              </div>
            </div>
            <p class="profile-card__name">Jose Andrea Velasquez</p>
            <ul class="profile-card__list">
              {ACHIEVEMENTS.map(a => (
                <li><span class="bold">{a.bold}</span><span class="mono">{a.rest}</span></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="profile-card-wrap profile-card-wrap--right">
          <div class="profile-card profile-card--right">
            <div class="profile-card__photo">
              <div class="profile-card__photo-inner">
                <img src="/images/quienes-somos/profile1.png" alt="Jose Andrea Velasquez" />
              </div>
            </div>
            <p class="profile-card__name">Jose Andrea Velasquez</p>
            <ul class="profile-card__list">
              {ACHIEVEMENTS.map(a => (
                <li><span class="bold">{a.bold}</span><span class="mono">{a.rest}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</body>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const menu = document.getElementById("navbar");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (menu && !prefersReducedMotion.matches) {
    const enterY = Number.parseFloat(getComputedStyle(menu).getPropertyValue("--enter-y")) || -18;
    menu.style.opacity = "0";
    menu.style.transform = `translate3d(0, ${enterY}px, 0)`;

    const startTime = performance.now();
    const duration = 720;

    const step = (now) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      menu.style.opacity = String(progress);
      menu.style.transform = `translate3d(0, ${enterY * (1 - progress)}px, 0)`;
      if (progress < 1) {
        requestAnimationFrame(step);
      }
    };
    requestAnimationFrame(step);
  } else if (menu) {
    menu.style.opacity = "1";
    menu.style.transform = "none";
  }

  gsap.fromTo('.qs-hero .fondecyt',
    { opacity: 0, scale: 0.88, y: 40 },
    { opacity: 1, scale: 1, y: 0, duration: 0.9, ease: 'back.out(1.3)', delay: 0.6 }
  );

  const row1 = document.getElementById('marqueeRow1');
  if (row1) {
    const half1 = row1.scrollWidth / 2;
    gsap.to(row1, {
      x: -half1, duration: 28, ease: 'none', repeat: -1,
      modifiers: { x: (x) => (parseFloat(x) % half1) + 'px' }
    });
  }

  const row2 = document.getElementById('marqueeRow2');
  if (row2) {
    const half2 = row2.scrollWidth / 2;
    gsap.to(row2, {
      x: -half2, duration: 20, ease: 'none', repeat: -1,
      modifiers: { x: (x) => (parseFloat(x) % half2) + 'px' }
    });
  }

  const row3 = document.getElementById('marqueeRow3');
  if (row3) {
    const half3 = row3.scrollWidth / 2;
    gsap.fromTo(row3, { x: -half3 }, { x: 0, duration: 32, ease: 'none', repeat: -1 });
  }

  gsap.fromTo('.team-title h2',
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
      scrollTrigger: { trigger: '.team-title', start: 'top 85%' } }
  );

  gsap.utils.toArray('.profile-card-wrap').forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, y: 60 },
      { opacity: 1, y: 0, duration: 0.8, ease: 'back.out(1.2)', delay: i * 0.12,
        scrollTrigger: { trigger: '.profile-section', start: 'top 78%' } }
    );
  });
</script>
</html>
