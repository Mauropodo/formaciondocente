---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import CategoriaFilter from '../../components/CategoriaFilter.astro';
import { posts } from '../../lib/posts';
import { categorias } from '../../lib/categorias';

const CATS_PER_PAGE = 6;
const categoriaSlug = Astro.url.searchParams.get('categoria');
const page = parseInt(Astro.url.searchParams.get('pagina')) || 1;

const filteredPosts = categoriaSlug
  ? posts.filter(p => p.categoriaSlug === categoriaSlug)
  : posts;

const totalPages = Math.ceil(filteredPosts.length / CATS_PER_PAGE);
const currentPage = Math.min(page, totalPages || 1);
const pagePosts = filteredPosts.slice((currentPage - 1) * CATS_PER_PAGE, currentPage * CATS_PER_PAGE);

function paginationUrl(slug, pageNum) {
  const params = new URLSearchParams();
  if (slug) params.set('categoria', slug);
  if (pageNum > 1) params.set('pagina', String(pageNum));
  const qs = params.toString();
  return `/publicaciones${qs ? '?' + qs : ''}`;
}
---

<BaseLayout title="Publicaciones">
  <section class="hero-section">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-filters" id="hero-filters">
          <CategoriaFilter categorias={categorias} activeSlug={categoriaSlug} />
        </div>
        <div class="hero-text" id="hero-text">
          <h1 class="hero-title">Publicaciones</h1>
          <p class="hero-desc">Este espacio reúne las ideas, experiencias y conocimientos que dan vida a este proyecto. Aquí convergen publicaciones científicas, marcos teóricos, reflexiones, relatos, aprendizajes, buenas prácticas e hitos que nos permiten comprender, compartir y dialogar sobre las distintas dimensiones de esta investigación.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cards-section">
    <div class="container">
      {pagePosts.length === 0 ? (
        <p class="empty-msg">No hay publicaciones en esta categoría.</p>
      ) : (
        <div class="posts-grid" id="posts-grid">
          {pagePosts.map((p, i) => <BlogCard {...p} index={i} />)}
        </div>
      )}
    </div>
  </section>

  {totalPages > 1 && (
    <section class="pagination-section">
      <div class="container">
        <div class="pagination-wrapper">
          <p class="pagination-info">Mostrando {(currentPage - 1) * CATS_PER_PAGE + 1} a {Math.min(currentPage * CATS_PER_PAGE, filteredPosts.length)} de {filteredPosts.length} resultados</p>
          <div class="pagination-controls">
            <a href={paginationUrl(categoriaSlug, 1)} class={`page-btn ${currentPage === 1 ? 'disabled' : ''}`} aria-label="Primera página">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M11 3L6 8L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3L3 8L8 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href={paginationUrl(categoriaSlug, currentPage - 1)} class={`page-btn ${currentPage === 1 ? 'disabled' : ''}`} aria-label="Página anterior">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <div class="page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map(p => (
                <a href={paginationUrl(categoriaSlug, p)} class={`page-num ${p === currentPage ? 'active' : ''}`}>{p}</a>
              ))}
            </div>
            <a href={paginationUrl(categoriaSlug, currentPage + 1)} class={`page-btn ${currentPage === totalPages ? 'disabled' : ''}`} aria-label="Página siguiente">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href={paginationUrl(categoriaSlug, totalPages)} class={`page-btn ${currentPage === totalPages ? 'disabled' : ''}`} aria-label="Última página">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M5 3L10 8L5 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3L13 8L8 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import { fadeInUp, staggerItems } from "../../utils/gsap";
  fadeInUp(document.getElementById("hero-text"));
  fadeInUp(document.getElementById("hero-filters"), 0.15);
  staggerItems(document.getElementById("posts-grid"), 0.08);
</script>

<style>
  .hero-section {
    padding: 174px 0 143px;
  }
  .hero-layout {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--gap-xl);
  }
  .hero-filters {
    flex: 0 0 552px;
    max-width: 552px;
  }
  .hero-text {
    flex: 0 1 auto;
    text-align: right;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 44.8px;
    color: var(--color-text-primary);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }
  .hero-desc {
    font-family: 'Inconsolata', monospace;
    font-size: 20.545px;
    color: var(--color-text-secondary);
    line-height: 1.4;
    max-width: 508px;
    margin: 0 0 0 auto;
  }

  .cards-section {
    padding: 10px 0 25px;
  }
  .empty-msg {
    text-align: center;
    padding: var(--gap-xl) 0;
    color: var(--color-text-muted);
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
  }

  .pagination-section {
    padding: 10px 0 var(--gap-xl);
  }
  .pagination-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
  }
  .pagination-info {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .pagination-controls {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
  }
  .page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    transition: var(--transition);
  }
  .page-btn:hover:not(.disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .page-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
  }
  .page-numbers {
    display: flex;
    gap: 2px;
  }
  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--color-text);
    transition: var(--transition);
  }
  .page-num:hover { background: var(--color-bg-soft); }
  .page-num.active {
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .hero-section { padding: 100px 0 60px; }
    .hero-layout { flex-direction: column-reverse; gap: var(--gap-lg); }
    .hero-filters { flex: 1; max-width: 100%; }
    .hero-text { text-align: left; }
    .hero-title { font-size: 32px; }
    .hero-desc { font-size: 16px; max-width: 100%; margin: 0; }
    .posts-grid { grid-template-columns: 1fr; gap: 20px; }
    .pagination-wrapper { flex-direction: column; align-items: center; }
    .page-numbers { gap: 0; }
  }
  @media (min-width: 769px) and (max-width: 1024px) {
    .hero-layout { flex-direction: column; gap: var(--gap-lg); }
    .hero-filters { flex: 1; max-width: 100%; }
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
