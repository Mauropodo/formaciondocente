---
/**
 * Post.astro — Página de publicación tipo
 * Copiar a: src/pages/post/[slug].astro (o src/pages/post.astro)
 *
 * Imágenes → copiar a public/images/post/ con los nombres indicados:
 *   84b0eb11...png  → logo.png
 *   a087d317...png  → hero-image.png
 *   2a6c796e...png  → content-image.png
 *   a10ce666...png  → colaboran.png
 */

import Nav from '../components/Nav.astro';

const tags = [
  { label: "Relatos",       bg: "#e5e5c6", border: "#7b7a4a" },
  { label: "Marco teórico", bg: "#f3b568", border: "#f0a443" },
  { label: "Hitos",         bg: "#cee6dd", border: "#98b5ab" },
];

const navLinks = ["Inicio", "Quiénes somos", "Investigación", "Publicaciones", "Contacto"];
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Titulo publicación — Post</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inconsolata:wght@400;600;900&family=Poppins:wght@400;600&family=Inter:wght@400;700&display=swap" rel="stylesheet" />

  <!-- GSAP CDN -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

  <style>
    /* ── Reset ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', sans-serif;
      background: #f9f5f2;
      overflow-x: hidden;
      color: #161616;
    }
    a { text-decoration: none; color: inherit; }
    button { cursor: pointer; border: none; outline: none; background: none; }

    /* ══════════════════════════════════════
       BACKGROUND BLOBS (opacity 0.32 como Figma)
    ══════════════════════════════════════ */
    .bg-blobs {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
      opacity: 0.32;
    }
    .bg-blobs svg {
      position: absolute;
      top: 0;
      height: 100%;
    }

    /* ══════════════════════════════════════
       NAV
    ══════════════════════════════════════ */
    .nav {
      position: relative;
      z-index: 30;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 0 6vw;
    }
    .nav__logo {
      width: 80px; height: 80px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      margin-top: 0;
    }
    .nav__logo img { width: 100%; height: 100%; object-fit: cover; }

    .nav__bar {
      display: flex;
      align-items: center;
      gap: clamp(1rem, 2.5vw, 2.5rem);
      padding: 0.75rem clamp(1.5rem, 4vw, 3.5rem);
      background: #f9f5f2;
      border-radius: 0 0 13px 13px;
      box-shadow: -1.6px 3.2px 1.6px rgba(0,0,0,0.4);
      flex-shrink: 0;
    }
    .nav__link {
      font-family: 'Inconsolata', monospace;
      font-size: clamp(13px, 1vw, 16px);
      color: #000;
      white-space: nowrap;
      transition: color .2s;
    }
    .nav__link:hover { color: #be572a; }

    .nav__cta {
      margin-left: 0.5rem;
      background: #d2892d;
      color: #eee2d9;
      font-family: 'Inconsolata', monospace;
      font-weight: 900;
      font-size: 14px;
      padding: 0.5rem 1.4rem;
      border-radius: 48px;
      box-shadow: 0.8px 2.4px 0px #464646, 0px 6.4px 9.6px rgba(0,0,0,0.15), 0px 3.2px 3.2px rgba(0,0,0,0.3);
      transition: opacity .2s;
    }
    .nav__cta:hover { opacity: .88; }

    /* ══════════════════════════════════════
       HERO SECTION
    ══════════════════════════════════════ */
    .hero {
      position: relative;
      z-index: 6;
      background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, #f9f4f1 100%);
      padding: 5rem 8vw 3.5rem;
      display: flex;
      align-items: flex-end;
      gap: clamp(2rem, 4vw, 4rem);
      flex-wrap: wrap;
      min-height: 500px;
      overflow: hidden;
    }

    /* Decorative orange hand */
    .hero__hand {
      position: absolute;
      right: 4vw;
      top: 10%;
      width: clamp(120px, 16vw, 280px);
      transform: rotate(-28deg);
      pointer-events: none;
      z-index: 1;
      opacity: .9;
    }
    @media (max-width: 900px) { .hero__hand { display: none; } }

    .hero__meta {
      flex: 0 1 660px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      position: relative;
      z-index: 2;
    }

    .hero__byline {
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 16px;
      color: #000;
    }

    .hero__title {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(28px, 3.5vw, 48px);
      color: #620404;
      white-space: nowrap;
    }
    @media (max-width: 600px) { .hero__title { white-space: normal; } }

    .hero__excerpt {
      font-family: 'Inconsolata', monospace;
      font-size: clamp(16px, 1.4vw, 20px);
      color: #514444;
      max-width: 660px;
      line-height: 1.5;
    }

    .hero__tags { display: flex; gap: 10px; flex-wrap: wrap; }

    .tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 10px;
      border-radius: 10px;
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      color: #161616;
      position: relative;
    }
    .tag::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 10px;
      border: 2px solid var(--tag-border);
      pointer-events: none;
    }

    /* Hero image */
    .hero__img-wrap {
      flex: 0 1 500px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 2;
    }
    .hero__img {
      width: 100%;
      max-width: 480px;
      border-radius: 30px;
      overflow: hidden;
      transform: rotate(2deg);
      box-shadow: 8px 10px 20px rgba(0,0,0,0.18);
      aspect-ratio: 485/345;
    }
    .hero__img img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ══════════════════════════════════════
       CONTENT SECTION
    ══════════════════════════════════════ */
    .content-section {
      position: relative;
      z-index: 5;
      background: #f9f4f1;
      padding: 4rem 8vw 5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3rem;
    }

    .content-body {
      width: 100%;
      max-width: 960px;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .content-subtitle {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(24px, 2.5vw, 32px);
      color: #620404;
    }

    .content-text {
      font-family: 'Poppins', sans-serif;
      font-weight: 400;
      font-size: clamp(16px, 1.4vw, 22px);
      color: #474747;
      line-height: 1.65;
      text-align: justify;
    }

    .content-img {
      width: 100%;
      max-width: 720px;
      aspect-ratio: 714/395;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 6px 24px rgba(0,0,0,0.12);
    }
    .content-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ══════════════════════════════════════
       PAGINATION
    ══════════════════════════════════════ */
    .pagination-section {
      position: relative;
      z-index: 4;
      background: #f9f4f1;
      display: flex;
      justify-content: center;
      padding: 0.5rem 8vw 1.5rem;
    }

    .pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 1050px;
      padding-top: 24px;
    }

    .pagination__info {
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      color: #0a0a0a;
    }
    .pagination__info b { font-weight: 700; }

    .pagination__controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .page-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px; height: 37px;
      border-radius: 8px;
      cursor: pointer;
      transition: background .15s;
    }
    .page-btn:hover { background: rgba(0,0,0,0.06); }
    .page-btn--disabled { opacity: 0.5; pointer-events: none; }

    .page-btn--num {
      font-family: 'Inconsolata', monospace;
      font-size: 24px;
      color: #0a0a0a;
      font-weight: 400;
    }
    .page-btn--num.active { font-weight: 600; }

    /* ══════════════════════════════════════
       FOOTER CARD
    ══════════════════════════════════════ */
    .footer-section {
      position: relative;
      z-index: 3;
      background: #f9f4f1;
      padding: 1rem 6vw 4rem;
      display: flex;
      justify-content: center;
    }

      .footer-card {
        background: #fff;
        border-radius: 20px;
        width: min(100%, 1400px);
        margin-inline: auto;
        padding: clamp(2rem, 4vw, 3rem) clamp(2rem, 5vw, 3.5rem);
        display: flex;
        flex-wrap: wrap;
        gap: 3rem;
        justify-content: space-between;
        align-items: flex-start;
        box-shadow: 0px 4px 2px rgba(0,0,0,0.25);
      }

    .footer-col { display: flex; flex-direction: column; gap: 1.5rem; min-width: 140px; }

    .footer-title {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(18px, 1.5vw, 24px);
      color: #620404;
      text-transform: uppercase;
    }

    .footer-links {
      display: flex; flex-direction: column; gap: 0.5rem;
      font-family: 'Inconsolata', monospace;
      font-size: 14px; letter-spacing: 3px;
      color: #620404; text-transform: uppercase;
    }
    .footer-links a { transition: opacity .2s; }
    .footer-links a:hover { opacity: .65; }

    .footer-social { display: flex; flex-direction: column; gap: 0.75rem; }

    .footer-social-link {
      display: flex; align-items: center; gap: 0.75rem;
      font-family: 'Inconsolata', monospace;
      font-size: 14px; letter-spacing: 3px;
      color: #620404; text-transform: uppercase;
      transition: opacity .2s;
    }
    .footer-social-link:hover { opacity: .65; }

    .footer-logo {
      width: 100%; max-width: 160px;
      aspect-ratio: 235/177; overflow: hidden; border-radius: 4px;
    }
    .footer-logo img { width: 100%; height: 100%; object-fit: cover; }

    /* ══════════════════════════════════════
       REDUCED MOTION
    ══════════════════════════════════════ */
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; }
    }
  </style>
</head>

<body>

  <!-- ══ Background blobs ══ -->
  <div class="bg-blobs" aria-hidden="true">
    <svg style="left:0; width:66%;" fill="none" viewBox="0 0 1295 3176" preserveAspectRatio="xMinYMin slice">
      <path d="M1294.3 11.3H76.2257H14.4465V3175.57C10.5922 3194.91 81.3794 3201.67 395.363 3074.06C787.843 2914.55 1252.2 2271.99 670.561 1575.93C88.9262 879.874 1039.58 376.331 1294.3 11.3Z" fill="#F9F4F1"/>
    </svg>
    <svg style="left:18%; width:78%;" fill="none" viewBox="0 0 2375 3176" preserveAspectRatio="xMinYMin slice">
      <path d="M2373.52 11.3H530.022H436.522V3175.3C430.688 3194.63 537.822 3201.4 1013.02 3073.8C1607.02 2914.3 2309.8 2271.8 1429.52 1575.8C549.243 879.8 1988.02 376.3 2373.52 11.3Z" fill="#EEE2D9"/>
    </svg>
    <svg style="left:22%; width:76%;" fill="none" viewBox="0 0 2841 3176" preserveAspectRatio="xMinYMin slice" opacity="0.75">
      <path d="M2840.3 11.3H552.604H436.575V3175.57C429.336 3194.9 562.284 3201.67 1151.98 3074.06C1889.11 2914.55 2761.22 2271.99 1668.84 1575.93C576.457 879.874 2361.91 376.331 2840.3 11.3Z" fill="#F3B568"/>
    </svg>
    <svg style="left:26%; width:74%;" fill="none" viewBox="0 0 2920 3176" preserveAspectRatio="xMinYMin slice" opacity="0.6">
      <path d="M2919.3 11.3H631.604H515.575V3175.57C508.336 3194.9 641.284 3201.67 1230.98 3074.06C1968.11 2914.55 2840.22 2271.99 1747.84 1575.93C655.457 879.874 2440.91 376.331 2919.3 11.3Z" fill="#7C7C4A"/>
    </svg>
  </div>

  <Nav />

  <!-- ══ Hero ══ -->
  <section class="hero" id="hero">

    <!-- Decorative orange hand -->
    <div class="hero__hand" aria-hidden="true" id="heroHand">
      <svg fill="none" viewBox="0 0 358 577" width="100%">
        <path d="M99.93 275.024L114.45 292.794C124.87 301.084 132.82 309.994 140.37 320.984L156.28 344.134C165.95 358.204 312.847 571.612 320.717 587.352L357.5 451.486L283.68 373.594L259.6 342.664L227.84 304.414L210.53 284.824L199.63 271.694C195.39 266.584 191.37 261.164 187.89 255.574C184.53 250.174 181.01 246.064 176.41 241.944C168.83 235.154 167.84 218.064 166.85 206.364L165.3 188.074C164.47 178.254 165.43 167.624 162.08 158.164L143.86 106.734L133.96 98.2942C130.09 94.9942 125.45 92.2842 120.99 89.3142L111.04 82.6842C110.52 82.3342 107.97 82.2642 108.05 82.8342L108.56 86.3742L94.72 67.7842C87.76 58.4342 81.79 48.9442 73.16 39.3342C75.55 54.4642 83.65 66.6142 89.07 80.2442L101.03 110.344C103.47 116.484 105.45 122.074 107.34 128.864C102.26 123.994 100.48 118.254 98.14 112.164C92.76 98.1942 88.31 84.1842 81.53 70.7642C76.23 60.2642 72.35 49.9142 69.89 38.4842L66.65 23.3842L63.97 15.2242C63.27 13.0842 60.69 11.0542 58.47 11.3242C56.07 11.6142 54.29 14.2242 53.04 16.5642L48.06 25.9142C59.74 25.2242 61.7 41.5342 63.57 54.1642L65.23 65.3642C66 70.5942 68.07 75.7342 69.62 80.8442L83.33 126.074C84.59 130.224 85.84 134.344 83.91 139.064L64.8 76.5042C62.41 68.6942 61.68 61.5842 60.29 53.5842L58.38 42.5442L55.07 32.2842C54.66 31.0042 51.59 29.5942 50.35 29.7742C47.49 30.1942 41.7 38.8342 40.8 44.2542C39.19 53.9142 40.08 62.2742 41.68 71.5442L45.99 96.3942L54.59 140.514L56.59 156.534L63.97 191.334C64.5 193.814 65.06 195.724 64.54 199.114C61.36 193.354 59.63 187.684 58.07 181.084L48.69 141.444C42.5 133.994 31.78 128.594 22.37 127.814L14.3 128.194C16.28 134.894 20.03 139.274 24.5 143.734C29.97 149.194 32.37 155.894 35.79 162.644L43.17 177.174C47.72 186.134 51.5 194.694 55.44 203.964L73.58 246.674C77.08 254.914 83.51 260.644 89.98 266.314L99.92 275.024Z"
          fill="#F0A443" filter="drop-shadow(4px 6px 8px rgba(0,0,0,0.2))"/>
      </svg>
    </div>

    <!-- Text + tags -->
    <div class="hero__meta" id="heroMeta">
      <p class="hero__byline">Nombre de autor &nbsp;|&nbsp; 10/09/26</p>
      <h1 class="hero__title">Titulo publicación</h1>
      <p class="hero__excerpt">
        Este espacio reúne las ideas, experiencias y conocimientos que dan vida a este proyecto.
        Aquí convergen publicaciones de diversas voces y perspectivas.
      </p>
      <div class="hero__tags">
        {tags.map(t => (
          <a
            href={t.label === "Relatos" ? "/post" : "#"}
            class="tag"
            style={`background:${t.bg}; --tag-border:${t.border};`}
          >{t.label}</a>
        ))}
      </div>
    </div>

    <!-- Tilted image -->
    <div class="hero__img-wrap" id="heroImg">
      <div class="hero__img">
        <img src="/images/post/hero-image.png" alt="Imagen de portada" />
      </div>
    </div>

  </section>

  <!-- ══ Article content ══ -->
  <section class="content-section" id="contentSection">

    <div class="content-body" id="contentBody">
      <h2 class="content-subtitle">Sub títulos</h2>
      <div class="content-text">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec suscipit augue ac diam venenatis,
        eget mollis lacus congue. Quisque nec mauris id odio Lorem ipsum dolor sit amet, consectetur adipiscing
        elit. Donec suscipit augue ac diam venenatis, eget mollis lacus congueLorem ipsum dolor sit amet,
        consectetur adipiscing elit. Donec suscipit augue ac diam venenatis, eget mollis lacus congue. Quisque
        nec mauris id odio Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec suscipit augue ac diam
        venenatis, eget mollis lacus congueLorem ipsum dolor sit amet, consectetur adipiscing elit. Donec
        suscipit augue ac diam venenatis, eget mollis lacus congue. Quisque nec mauris id odio Lorem ipsum dolor
        sit amet, consectetur adipiscing elit.</p>
        <br />
        <p>Donec suscipit augue ac diam venenatis, eget mollis lacus congueLorem ipsum dolor sit amet,
        consectetur adipiscing elit. Donec suscipit augue ac diam venenatis, eget mollis lacus congue. Quisque
        nec mauris id odio Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec suscipit augue ac diam
        venenatis, eget mollis lacus congueLorem ipsum dolor sit amet, consectetur adipiscing elit. Donec
        suscipit augue ac diam venenatis, eget mollis lacus congue. Quisque nec mauris id odio Lorem ipsum dolor
        sit amet, consectetur adipiscing elit. Donec suscipit augue ac diam venenatis, eget mollis lacus congue</p>
      </div>
    </div>

    <!-- Full-width image -->
    <div class="content-img" id="contentImg">
      <img src="/images/post/content-image.png" alt="Imagen del artículo" loading="lazy" />
    </div>

  </section>

  <!-- ══ Pagination ══ -->
  <div class="pagination-section" id="paginationSection">
    <div class="pagination">
      <p class="pagination__info">
        Mostrando <b>1</b> a <b>5</b> de <b>8</b> resultados
      </p>
      <div class="pagination__controls">
        <!-- First page -->
        <button class="page-btn page-btn--disabled" aria-label="Primera página">
          <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
            <path d="M7.33333 11.3333L4 8L7.33333 4.66667" stroke="#0A0A0A" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333"/>
            <path d="M12 11.3333L8.66667 8L12 4.66667" stroke="#0A0A0A" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333"/>
          </svg>
        </button>
        <!-- Prev -->
        <button class="page-btn page-btn--disabled" aria-label="Página anterior">
          <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
            <path d="M10 12L6 8L10 4" stroke="#0A0A0A" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333"/>
          </svg>
        </button>
        <!-- Pages -->
        <button class="page-btn page-btn--num active">1</button>
        <button class="page-btn page-btn--num">2</button>
        <button class="page-btn page-btn--num">3</button>
        <button class="page-btn page-btn--num">4</button>
        <!-- Next -->
        <button class="page-btn" aria-label="Página siguiente">
          <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
            <path d="M6 12L10 8L6 4" stroke="#0A0A0A" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333"/>
          </svg>
        </button>
        <!-- Last page -->
        <button class="page-btn" aria-label="Última página">
          <svg width="16" height="16" fill="none" viewBox="0 0 16 16">
            <path d="M4 11.3333L7.33333 8L4 4.66667" stroke="#0A0A0A" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333"/>
            <path d="M8.66667 11.3333L12 8L8.66667 4.66667" stroke="#0A0A0A" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.33333"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ══ Footer card ══ -->
  <footer class="footer-section">
    <div class="footer-card" id="footerCard">

      <!-- Mapa de Sitio -->
      <div class="footer-col">
        <p class="footer-title">Mapa de Sitio</p>
        <div class="footer-links">
          <a href="#">Inicio</a>
          <a href="#">Voces</a>
          <a href="#">Investigación</a>
          <a href="#">Publicaciones</a>
          <a href="#">Contacto</a>
        </div>
      </div>

      <!-- Proyectos hermanos -->
      <div class="footer-col">
        <p class="footer-title">Proyectos hermanos</p>
        <div class="footer-links">
          <a href="#">Lorem Ipsum</a>
          <a href="#">Lorem Ipsum</a>
          <a href="#">Lorem Ipsum</a>
          <a href="#">Lorem Ipsum</a>
          <a href="#">Lorem Ipsum</a>
        </div>
      </div>

      <!-- Colaboran -->
      <div class="footer-col">
        <p class="footer-title">Colaboran</p>
        <div class="footer-logo">
          <img src="/images/post/colaboran.png" alt="Colaboran" loading="lazy" />
        </div>
      </div>

      <!-- Redes -->
      <div class="footer-col">
        <p class="footer-title">Redes</p>
        <div class="footer-social">
          <a href="#" class="footer-social-link">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path d="M16 8C17.5913 8 19.1174 8.63214 20.2426 9.75736C21.3679 10.8826 22 12.4087 22 14V21H18V14C18 13.4696 17.7893 12.9609 17.4142 12.5858C17.0391 12.2107 16.5304 12 16 12C15.4696 12 14.9609 12.2107 14.5858 12.5858C14.2107 12.9609 14 13.4696 14 14V21H10V14C10 12.4087 10.6321 10.8826 11.7574 9.75736C12.8826 8.63214 14.4087 8 16 8Z" stroke="#620404" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
              <path d="M6 9H2V21H6V9Z" stroke="#620404" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
              <path d="M4 6C5.10457 6 6 5.10457 6 4C6 2.89543 5.10457 2 4 2C2.89543 2 2 2.89543 2 4C2 5.10457 2.89543 6 4 6Z" stroke="#620404" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
            </svg>
            LINKEDIN
          </a>
          <a href="#" class="footer-social-link">
            <svg width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path d="M17 2H7C4.23858 2 2 4.23858 2 7V17C2 19.7614 4.23858 22 7 22H17C19.7614 22 22 19.7614 22 17V7C22 4.23858 19.7614 2 17 2Z" stroke="#620404" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
              <path d="M16 11.37C16.1234 12.2022 15.9813 13.0522 15.5938 13.799C15.2063 14.5458 14.5931 15.1514 13.8416 15.5297C13.0901 15.9079 12.2384 16.0396 11.4078 15.9059C10.5771 15.7723 9.80976 15.3801 9.21484 14.7852C8.61992 14.1902 8.22773 13.4229 8.09407 12.5922C7.9604 11.7616 8.09207 10.9099 8.47033 10.1584C8.84859 9.40685 9.45419 8.79374 10.201 8.40624C10.9478 8.01874 11.7978 7.87659 12.63 8C13.4789 8.12588 14.2649 8.52146 14.8717 9.12831C15.4785 9.73515 15.8741 10.5211 16 11.37Z" stroke="#620404" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
