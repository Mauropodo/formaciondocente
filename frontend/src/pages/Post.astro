  <!-- ══ GSAP Animations ══ -->
  <script>
    gsap.registerPlugin(ScrollTrigger);

    // ── Hero entrada ────────────────────────────────────────────────
    const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    heroTl
      .fromTo('#heroMeta',
        { opacity: 0, x: -60 },
        { opacity: 1, x: 0, duration: 0.9 }
      )
      .fromTo('#heroImg',
        { opacity: 0, x: 60 },
        { opacity: 1, x: 0, duration: 0.9 },
        '-=0.65'
      )
      .fromTo('#heroHand',
        { opacity: 0, scale: 0.7, rotation: -40 },
        { opacity: 0.9, scale: 1, rotation: -28, duration: 1.1, ease: 'back.out(1.2)' },
        '-=0.8'
      );

    // Tags stagger
    gsap.fromTo('.tag',
      { opacity: 0, y: 12 },
      { opacity: 1, y: 0, duration: 0.4, stagger: 0.1, ease: 'power2.out', delay: 0.7 }
    );

    // ── Mano — float suave loop ─────────────────────────────────────
    gsap.to('#heroHand', {
      y: -18,
      duration: 3.2,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });

    // ── Contenido — fade in al hacer scroll ────────────────────────
    gsap.fromTo('#contentBody',
      { opacity: 0, y: 50 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
        scrollTrigger: { trigger: '#contentBody', start: 'top 80%' }
      }
    );

    // ── Imagen de contenido — scale reveal ─────────────────────────
    gsap.fromTo('#contentImg',
      { opacity: 0, scale: 0.9, y: 30 },
      {
        opacity: 1, scale: 1, y: 0, duration: 0.9, ease: 'power3.out',
        scrollTrigger: { trigger: '#contentImg', start: 'top 82%' }
      }
    );

    // ── Paginación — fade up ────────────────────────────────────────
    gsap.fromTo('#paginationSection',
      { opacity: 0, y: 24 },
      {
        opacity: 1, y: 0, duration: 0.6, ease: 'power2.out',
        scrollTrigger: { trigger: '#paginationSection', start: 'top 90%' }
      }
    );

    // ── Footer card — slide up ──────────────────────────────────────
    gsap.fromTo('#footerCard',
      { opacity: 0, y: 60 },
      {
        opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: '#footerCard', start: 'top 90%' }
      }
    );

    // ── Footer columns — stagger ────────────────────────────────────
    gsap.fromTo('.footer-col',
      { opacity: 0, y: 30 },
      {
        opacity: 1, y: 0, duration: 0.55, stagger: 0.12, ease: 'power2.out',
        scrollTrigger: { trigger: '#footerCard', start: 'top 85%' }
      }
    );

    // ── Pagination page buttons — hover effect ──────────────────────
    document.querySelectorAll('.page-btn--num').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.page-btn--num').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        gsap.fromTo(this, { scale: 0.8 }, { scale: 1, duration: 0.25, ease: 'back.out(2)' });
      });
    });
  </script>

</body>
</html>
