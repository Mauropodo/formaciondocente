---
import BaseLayout from '../layouts/BaseLayout.astro';

const TAGS = [
  { label: "Trayectorias formativas", color: "#f0a443", rotate: 0 },
  { label: "Agencia profesional", color: "#95b3a7", rotate: -2 },
  { label: "Identidad profesional docente", color: "#f0a443", rotate: -1 },
  { label: "Educación parvularia", color: "#3b959e", rotate: -1 },
  { label: "Incidentes críticos", color: "#be572a", rotate: -2 },
  { label: "Emociones y reflexividad", color: "#204d50", rotate: 2 },
  { label: "Experiencias de práctica", color: "#95b3a7", rotate: 2 },
  { label: "Dilemas formativos", color: "#3b959e", rotate: 0 },
];

const OBJ_SPECIFICS = [
  {
    title: "Objetivos específicos",
    blobColor: "#204E4C",
    titleColor: "#f9f4f1",
    cardBg: "#f0a443",
    cardRotate: "-2deg",
    cardText:
      "Comprender las identidades que surgen a partir de las experiencias y proyecciones dentro de la formación práctica.\n\nCaracterizar aquellos dilemas formativos experimentados en la práctica, evaluando su impacto en la reconfiguración del ser docente.",
  },
  {
    title: "Objetivos específicos",
    blobColor: "#95B3A7",
    titleColor: "#be572a",
    cardBg: "#be572a",
    cardRotate: "3deg",
    cardText:
      "Comprender los procesos de reflexión y diálogo interno frente a las tensiones identitarias que emergen en los escenarios de práctica pedagógica.",
  },
  {
    title: "Objetivos específicos",
    blobColor: "#F9F4F1",
    titleColor: "#be572a",
    cardBg: "#3b959e",
    cardRotate: "-4deg",
    cardText:
      "Describir las manifestaciones de la agencia profesional mediante decisiones ético-pedagógicas, estrategias innovadoras y formas de enfrentar las exigencias institucionales.",
  },
];

const REFS_DATA = [
  "Revisión sistemática sobre las estrategias de coparentalidad y su impacto directo en la salud mental de los niños durante procesos judiciales conflictivos.",
  "Análisis del vínculo entre incidentes críticos y resignificación del rol docente en trayectorias de práctica profesional.",
  "Estudio comparado sobre emociones pedagógicas, reflexividad y toma de decisiones en formación inicial docente.",
  "Aportes sobre agencia profesional y construcción identitaria en educación parvularia desde una perspectiva narrativa.",
  "Marco teórico sobre dilemas formativos, subjetividad y experiencias de práctica en contextos institucionales diversos.",
];
---

<BaseLayout title="Investigación">
  <section class="research-page">
    <div class="research-bg" aria-hidden="true">
      <svg class="research-bg__shape research-bg__shape--1" viewBox="0 0 1920 3200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin slice">
        <path d="M1280 0H-720V3164.27C-3.70783 3183.61 67.0794 3190.37 381.063 3062.76C773.543 2903.25 1237.9 2260.69 656.261 1564.63C74.6262 868.574 1025.28 365.031 1280 0Z" fill="#F9F4F1"/>
      </svg>
      <svg class="research-bg__shape research-bg__shape--2" viewBox="0 0 1920 3200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin slice">
        <path d="M1937.22 0H-720V3164C-5.61163 3183.33 101.522 3190.1 576.722 3062.5C1170.72 2903 1873.5 2260.5 993.222 1564.5C112.943 868.5 1551.72 365 1937.22 0Z" fill="#EEE2D9"/>
      </svg>
      <svg class="research-bg__shape research-bg__shape--3" viewBox="0 0 1920 3200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin slice">
        <path d="M2404 0H116.304H0.275126V3164.27C-6.96376 3183.6 125.984 3190.37 715.684 3062.76C1452.81 2903.25 2324.92 2260.69 1232.54 1564.63C140.157 868.574 1925.61 365.031 2404 0Z" fill="#F3B568" fill-opacity="0.48"/>
      </svg>
      <svg class="research-bg__shape research-bg__shape--4" viewBox="0 0 1920 3200" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin slice">
        <path d="M2483 0H195.304H79.2751V3164.27C72.0362 3183.6 204.984 3190.37 794.684 3062.76C1531.81 2903.25 2403.92 2260.69 1311.54 1564.63C219.157 868.574 2004.61 365.031 2483 0Z" fill="#7C7C4A" fill-opacity="0.26"/>
      </svg>
    </div>

    <section class="research-hero">
      <div class="research-hero__top">
        <div class="research-hero__copy" id="researchHeroCopy">
          <p class="research-hero__eyebrow">Investigación</p>
          <p class="research-hero__body">
            Creemos que la identidad profesional no se forma de manera lineal ni automática, sino que se construye a través de experiencias, tensiones, dilemas y reflexiones que las estudiantes viven durante sus prácticas pedagógicas.
          </p>
        </div>
        <h1 class="research-hero__title" id="researchHeroTitle">
          Somos a partir de experiencias
        </h1>
      </div>

      <div class="research-hero__bottom">
        <div class="research-hero__illustration" id="researchHeroArt" aria-hidden="true">
          <img src="/images/investigacion/child.svg" alt="" />
        </div>
        <article class="research-hero__quote" id="researchHeroQuote">
          <div class="research-hero__quote-shadow"></div>
          <div class="research-hero__quote-card">
            <span class="research-hero__quote-mark">“</span>
            <p>
              La educación parvularia cumple un rol fundamental en el desarrollo de niños y niñas. Queremos visibilizar cómo las futuras educadoras construyen su identidad profesional durante su formación a partir de sus propias experiencias.
            </p>
            <span class="research-hero__quote-mark research-hero__quote-mark--end">”</span>
          </div>
        </article>
      </div>
    </section>

    <section class="topics-panel" id="topicsPanel">
      <div class="topics-panel__intro">
        <h2>Temas de la investigación</h2>
        <p>
          La investigación articula agencia, reflexividad, experiencias de práctica e identidad profesional docente, poniendo el foco en cómo esas dimensiones se transforman dentro del trayecto formativo.
        </p>
      </div>

      <div class="topics-panel__focus" id="topicFocus">
        <div class="topics-panel__focus-label" id="topicFocusLabel">{TAGS[0].label}</div>
        <div class="topics-panel__dots">
          {TAGS.map((_, index) => (
            <span class:list={["topics-panel__dot", index === 0 && "is-active"]}></span>
          ))}
        </div>
      </div>

      <div class="topics-marquee" id="topicsMarquee">
        {TAGS.concat(TAGS).map((tag) => (
          <article class="topics-marquee__item" style={`--topic-bg:${tag.color}; --topic-rotate:${tag.rotate}deg;`}>
            {tag.label}
          </article>
        ))}
      </div>
    </section>

    <section class="objectives-panel">
      <div class="objectives-panel__headline" id="objectivesHeadline">
        <div class="objectives-panel__hand objectives-panel__hand--left" aria-hidden="true"></div>
        <div class="objectives-panel__core">
          <p class="objectives-panel__eyebrow">Objetivos</p>
          <p class="objectives-panel__body">
            Analizar los procesos de construcción de identidad profesional docente en estudiantes de Pedagogía en Educación Parvularia durante sus prácticas intermedia y final, con perfiles institucionales diversos.
          </p>
        </div>
        <div class="objectives-panel__hand objectives-panel__hand--right" aria-hidden="true"></div>
      </div>

      <div class="objectives-stack">
        {OBJ_SPECIFICS.map((item) => (
          <article class="objective-card" style={`--objective-shell:${item.blobColor}; --objective-title:${item.titleColor}; --objective-note:${item.cardBg}; --objective-note-rotate:${item.cardRotate};`}>
            <div class="objective-card__shape"></div>
            <div class="objective-card__title-wrap">
              <p class="objective-card__title">{item.title}</p>
            </div>
            <div class="objective-card__note">
              <p>{item.cardText}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="references-panel" id="referencesPanel">
      <h2>Referencias</h2>
      <div class="references-list">
        {REFS_DATA.map((desc) => (
          <article class="reference-item">
            <h3>Coparentalidad positiva en divorcios conflictivos</h3>
            <p>{desc}</p>
            <a href="https://search.scielo.org/?lang=es&count=15&q=psicolog%C3%ADa" target="_blank" rel="noreferrer">SciELO Chile</a>
          </article>
        ))}
      </div>
    </section>
  </section>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const heroTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });
    heroTimeline
      .from("#researchHeroCopy", { opacity: 0, x: -48, duration: 0.8 })
      .from("#researchHeroTitle", { opacity: 0, x: 52, duration: 0.8 }, "-=0.55")
      .from("#researchHeroArt", { opacity: 0, y: 24, scale: 0.92, duration: 0.75 }, "-=0.45")
      .from("#researchHeroQuote", { opacity: 0, y: 32, rotate: -2, duration: 0.8 }, "-=0.45");

    const marquee = document.getElementById("topicsMarquee");
    if (marquee) {
      const travel = marquee.scrollWidth / 2;
      gsap.to(marquee, {
        x: -travel,
        duration: 24,
        ease: "none",
        repeat: -1,
        modifiers: {
          x: (value) => `${Number.parseFloat(value) % travel}px`,
        },
      });
    }

    const focusLabel = document.getElementById("topicFocusLabel");
    const focusDots = Array.from(document.querySelectorAll(".topics-panel__dot"));
    const topicCards = Array.from(document.querySelectorAll(".topics-marquee__item"));

    const setActiveTopic = (index) => {
      const active = TAGS[index];
      if (!focusLabel || !active) return;

      focusLabel.textContent = active.label;
      focusLabel.style.background = active.color;
      focusLabel.style.transform = `rotate(${active.rotate}deg)`;

      focusDots.forEach((dot, dotIndex) => {
        dot.classList.toggle("is-active", dotIndex === index);
      });

      topicCards.forEach((card) => {
        const match = card.textContent?.trim() === active.label;
        card.classList.toggle("is-active", Boolean(match));
      });

      gsap.fromTo(
        focusLabel,
        { opacity: 0, y: 18, scale: 0.94 },
        { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: "back.out(1.4)", overwrite: true }
      );
    };

    setActiveTopic(0);

    ScrollTrigger.create({
      trigger: "#topicsPanel",
      start: "top 40%",
      end: "bottom 70%",
      onUpdate: (self) => {
        const nextIndex = Math.min(TAGS.length - 1, Math.floor(self.progress * TAGS.length));
        setActiveTopic(nextIndex);
      },
    });

    gsap.from(".objective-card", {
      opacity: 0,
      y: 56,
      duration: 0.8,
      stagger: 0.18,
      ease: "power3.out",
      scrollTrigger: {
        trigger: ".objectives-stack",
        start: "top 78%",
      },
    });

    gsap.from(".reference-item", {
      opacity: 0,
      y: 34,
      duration: 0.65,
      stagger: 0.12,
      ease: "power2.out",
      scrollTrigger: {
        trigger: "#referencesPanel",
        start: "top 78%",
      },
    });
  </script>

  <style>
    .research-page {
      position: relative;
      overflow: clip;
      background: #fff;
      color: #161616;
    }

    .research-bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    .research-bg__shape {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .research-hero,
    .topics-panel,
    .objectives-panel,
    .references-panel {
      position: relative;
      z-index: 1;
    }

    .research-hero {
      padding: 190px clamp(24px, 8vw, 128px) 88px;
      display: grid;
      gap: 56px;
    }

    .research-hero__top {
      display: grid;
      grid-template-columns: minmax(0, 580px) minmax(0, 520px);
      justify-content: space-between;
      gap: 32px;
      align-items: start;
    }

    .research-hero__copy {
      display: grid;
      gap: 14px;
      max-width: 590px;
    }

    .research-hero__eyebrow,
    .research-hero__title,
    .topics-panel__intro h2,
    .objectives-panel__eyebrow,
    .references-panel h2,
    .objective-card__title {
      font-family: "Playfair Display", serif;
      text-transform: uppercase;
    }

    .research-hero__eyebrow {
      color: #620404;
      font-size: clamp(1.4rem, 2.4vw, 2rem);
      font-weight: 600;
    }

    .research-hero__body,
    .topics-panel__intro p,
    .objectives-panel__body,
    .objective-card__note p,
    .reference-item p {
      font-family: "Inconsolata", monospace;
      line-height: 1.55;
    }

    .research-hero__body {
      max-width: 560px;
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      color: #232323;
    }

    .research-hero__title {
      font-size: clamp(2.1rem, 4vw, 3.4rem);
      text-align: right;
      line-height: 1.08;
      color: #be572a;
      max-width: 520px;
      justify-self: end;
    }

    .research-hero__bottom {
      position: relative;
      min-height: 360px;
      display: flex;
      justify-content: flex-end;
      align-items: flex-end;
      padding-right: clamp(0px, 4vw, 56px);
    }

    .research-hero__illustration {
      position: absolute;
      left: clamp(10px, 12vw, 160px);
      bottom: 24px;
      width: clamp(120px, 15vw, 210px);
      color: #d2892d;
      filter: drop-shadow(0 12px 22px rgba(76, 54, 43, 0.16));
    }

    .research-hero__illustration img {
      width: 100%;
      height: auto;
      display: block;
    }

    .research-hero__quote {
      width: min(580px, 100%);
      position: relative;
      min-height: 300px;
    }

    .research-hero__quote-shadow,
    .research-hero__quote-card {
      position: absolute;
      inset: 0;
      border-radius: 92px;
      box-shadow: 8px 12px 10px rgba(0, 0, 0, 0.18);
    }

    .research-hero__quote-shadow {
      background: #c36438;
      transform: translate(80px, -42px) rotate(6deg);
    }

    .research-hero__quote-card {
      background: #3b959e;
      color: #fff;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      gap: 4px;
      padding: 38px 56px;
      transform: rotate(-3deg);
    }

    .research-hero__quote-mark {
      font-family: "Playfair Display", serif;
      font-size: 4rem;
      line-height: 0.8;
      color: rgba(255,255,255,0.92);
    }

    .research-hero__quote-mark--end {
      align-self: flex-end;
    }

    .research-hero__quote p {
      font-family: "Inconsolata", monospace;
      font-size: clamp(1rem, 1.45vw, 1.2rem);
      line-height: 1.45;
      margin: 0;
    }

    .topics-panel {
      min-height: 100svh;
      padding: 88px clamp(24px, 6vw, 90px) 72px;
      background: rgba(240, 164, 67, 0.74);
      display: grid;
      grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
      gap: 42px;
      align-items: start;
    }

    .topics-panel__intro {
      display: grid;
      gap: 18px;
      max-width: 520px;
    }

    .topics-panel__intro h2 {
      color: #fffaf7;
      font-size: clamp(2rem, 3.4vw, 3rem);
      line-height: 1.02;
    }

    .topics-panel__intro p {
      color: rgba(255,255,255,0.94);
      font-size: 1.08rem;
    }

    .topics-panel__focus {
      justify-self: end;
      display: grid;
      gap: 18px;
      align-content: start;
      width: min(100%, 420px);
      margin-top: 22px;
    }

    .topics-panel__focus-label {
      border-radius: 28px;
      color: #fff;
      font-family: "Inter", sans-serif;
      font-size: clamp(1.2rem, 2vw, 1.7rem);
      padding: 22px 28px;
      text-align: center;
      box-shadow: 0 18px 34px rgba(76, 54, 43, 0.18);
    }

    .topics-panel__dots {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .topics-panel__dot {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(255,255,255,0.4);
      transition: all 0.25s ease;
    }

    .topics-panel__dot.is-active {
      width: 32px;
      background: #fff;
    }

    .topics-marquee {
      grid-column: 1 / -1;
      display: flex;
      gap: 24px;
      width: max-content;
      padding-block: 26px 10px;
    }

    .topics-marquee__item {
      min-width: 260px;
      padding: 24px 30px;
      border-radius: 16px;
      background: var(--topic-bg);
      color: #fff;
      font-family: "Inter", sans-serif;
      font-size: clamp(1.05rem, 1.8vw, 1.4rem);
      text-align: center;
      transform: rotate(var(--topic-rotate));
      opacity: 0.68;
      transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
      box-shadow: 0 8px 20px rgba(76, 54, 43, 0.14);
    }

    .topics-marquee__item.is-active {
      opacity: 1;
      box-shadow: 0 14px 26px rgba(76, 54, 43, 0.22);
    }

    .objectives-panel {
      padding: 96px clamp(24px, 5vw, 84px);
      background: #be572a;
      display: grid;
      gap: 64px;
    }

    .objectives-panel__headline {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 180px;
    }

    .objectives-panel__core {
      max-width: 540px;
      text-align: center;
      background: #fff;
      color: #620404;
      border-radius: 30px;
      padding: 24px 36px;
      box-shadow: 0 20px 40px rgba(76, 54, 43, 0.24);
      transform: rotate(2deg);
      position: relative;
      z-index: 1;
    }

    .objectives-panel__eyebrow {
      font-size: clamp(2rem, 3vw, 3rem);
      line-height: 1;
      margin-bottom: 10px;
    }

    .objectives-panel__body {
      font-size: 1rem;
      color: #514444;
    }

    .objectives-panel__hand {
      position: absolute;
      width: 130px;
      height: 130px;
      border-radius: 999px 999px 30px 30px;
      background: #3b959e;
      filter: drop-shadow(0 10px 20px rgba(0,0,0,0.18));
    }

    .objectives-panel__hand--left {
      left: calc(50% - 220px);
      bottom: 0;
      transform: rotate(-32deg);
    }

    .objectives-panel__hand--right {
      right: calc(50% - 220px);
      bottom: -12px;
      transform: rotate(36deg);
    }

    .objectives-stack {
      display: grid;
      gap: 34px;
    }

    .objective-card {
      position: relative;
      min-height: 360px;
      padding: 58px clamp(24px, 5vw, 70px);
      overflow: hidden;
      border-radius: 42px;
    }

    .objective-card__shape {
      position: absolute;
      inset: 0;
      background: var(--objective-shell);
      border-radius: 42px;
      box-shadow: inset 22px 0 0 rgba(255,255,255,0.1), 0 22px 36px rgba(0,0,0,0.15);
    }

    .objective-card__title-wrap,
    .objective-card__note {
      position: relative;
      z-index: 1;
    }

    .objective-card__title-wrap {
      max-width: 260px;
      margin-bottom: 42px;
    }

    .objective-card__title {
      color: var(--objective-title);
      font-size: clamp(1.8rem, 3vw, 2.7rem);
      line-height: 1;
    }

    .objective-card__note {
      width: min(100%, 470px);
      margin-left: auto;
      background: var(--objective-note);
      color: #fff;
      border-radius: 22px;
      padding: 24px 28px;
      transform: rotate(var(--objective-note-rotate));
      box-shadow: 0 18px 28px rgba(0,0,0,0.2);
    }

    .objective-card__note p {
      margin: 0;
      white-space: pre-wrap;
      font-size: 1rem;
    }

    .references-panel {
      padding: 88px clamp(24px, 5vw, 80px) 34px;
      display: grid;
      gap: 34px;
      background: #f9f4f1;
    }

    .references-panel h2 {
      text-align: center;
      color: #620404;
      font-size: clamp(2rem, 3vw, 3rem);
    }

    .references-list {
      display: grid;
      gap: 20px;
      max-width: 1080px;
      width: 100%;
      margin: 0 auto;
    }

    .reference-item {
      background: #95b3a7;
      border-radius: 12px;
      padding: 22px 28px;
      display: grid;
      gap: 10px;
      box-shadow: 0 12px 24px rgba(76, 54, 43, 0.1);
    }

    .reference-item h3 {
      margin: 0;
      font-family: "Inter", sans-serif;
      font-size: 1.2rem;
      font-weight: 600;
      color: #111;
    }

    .reference-item p {
      margin: 0;
      color: #111;
      font-size: 1rem;
    }

    .reference-item a {
      font-family: "Inter", sans-serif;
      text-decoration: underline;
      color: #111;
      font-size: 0.92rem;
      width: fit-content;
    }

    @media (max-width: 960px) {
      .research-hero__top,
      .topics-panel {
        grid-template-columns: 1fr;
      }

      .research-hero__title,
      .topics-panel__focus {
        justify-self: start;
        text-align: left;
      }

      .research-hero__bottom {
        min-height: 420px;
        padding-right: 0;
      }

      .research-hero__illustration {
        left: 0;
        bottom: 0;
      }

      .research-hero__quote {
        margin-left: auto;
      }
    }

    @media (max-width: 768px) {
      .research-hero {
        padding-top: 132px;
      }

      .research-hero__bottom {
        display: grid;
        gap: 22px;
        min-height: auto;
      }

      .research-hero__illustration {
        position: relative;
        left: auto;
        bottom: auto;
        width: 120px;
      }

      .research-hero__quote {
        width: 100%;
        min-height: 260px;
      }

      .research-hero__quote-shadow {
        transform: translate(34px, -26px) rotate(6deg);
      }

      .research-hero__quote-card {
        padding: 26px 24px;
      }

      .topics-panel,
      .objectives-panel,
      .references-panel {
        padding-inline: 18px;
      }

      .topics-marquee__item {
        min-width: 220px;
        font-size: 1rem;
      }

      .objectives-panel__hand {
        display: none;
      }

      .objective-card {
        min-height: auto;
        padding: 36px 20px;
      }

