# Public reCAPTCHA v3 site key registered for the production domain.
PUBLIC_RECAPTCHA_SITE_KEY=

# Server-only reCAPTCHA v3 secret key.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# SMTP server settings. Keep these values in Netlify environment variables,
# never in source control.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contacto@identidadprofesional.cl
SMTP_PASSWORD=
SMTP_FROM=contacto@identidadprofesional.cl
CONTACT_TO=contacto@identidadprofesional.cl
