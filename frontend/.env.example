# Public reCAPTCHA v3 site key registered for the production domain.
PUBLIC_RECAPTCHA_SITE_KEY=

# Server-only reCAPTCHA v3 secret key.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Resend API settings. Keep these values in Netlify environment variables,
# never in source control. EMAIL_FROM must be a verified Resend sender/domain.
RESEND_API_KEY=
EMAIL_FROM=contacto@identidadprofesional.cl
CONTACT_TO=contacto@identidadprofesional.cl
